{
  "name": "@arenahub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API do ArenaHub: monolito modular NestJS, REST /api/v1",
  "scripts": {
    "//dev": "tsc --watch, e NAO tsx: o esbuild do tsx nao emite design:paramtypes, e sem esse metadado o Nest nao resolve dependencia por tipo -- a API morria no arranque com UndefinedDependencyException no MfaService. Ver apps/api/README-dev.md.",
    "dev": "node ../../scripts/check-port.mjs 3344 && node ../../scripts/dev-api.mjs",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "//test:load:access": "Exige a API rodando em 3344 e o docker-compose de pe. Nao entra no `pnpm test` -- carga leva minutos e depende de ambiente.",
    "test:load:access": "tsx test/load/online-access.ts"
  },
  "dependencies": {
    "@arenahub/access-policy": "workspace:*",
    "@arenahub/api-contracts": "workspace:*",
    "@arenahub/database": "workspace:*",
    "@aws-sdk/client-s3": "3.1110.0",
    "@aws-sdk/s3-request-presigner": "3.1110.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.0",
    "@nestjs/core": "11.2.0",
    "@nestjs/platform-express": "11.2.0",
    "@nestjs/platform-ws": "11.2.0",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/websockets": "11.2.0",
    "bullmq": "6.1.1",
    "express": "5.1.0",
    "ioredis": "5.9.0",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@arenahub/config": "workspace:*",
    "@jest/globals": "29.7.0",
    "@nestjs/testing": "11.2.0",
    "@types/autocannon": "7.12.7",
    "@types/express": "5.0.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "autocannon": "8.0.0",
    "dotenv": "17.2.4",
    "eslint": "9.39.5",
    "fast-check": "4.9.0",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.5.0 <23.0.0"
  }
}
