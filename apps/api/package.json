{
  "name": "@arenahub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API do ArenaHub: monolito modular NestJS, REST /api/v1",
  "scripts": {
    "dev": "node ../../scripts/check-port.mjs 3344 && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand"
  },
  "dependencies": {
    "@arenahub/database": "workspace:*",
    "@nestjs/common": "11.2.0",
    "@nestjs/core": "11.2.0",
    "@nestjs/platform-express": "11.2.0",
    "@nestjs/swagger": "11.4.6",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@arenahub/config": "workspace:*",
    "@jest/globals": "29.7.0",
    "@nestjs/testing": "11.2.0",
    "@types/express": "5.0.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "dotenv": "17.2.4",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.5.0 <23.0.0"
  }
}
