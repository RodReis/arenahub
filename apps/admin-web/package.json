{
  "name": "@arenahub/admin-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Painel administrativo do ArenaHub: Next.js App Router",
  "scripts": {
    "//dev": "PORTA 3000 EXPLICITA, nao default acidental. A `playwright.config.ts` daqui ja assume 3000, e o `scripts/setup.mjs` a anuncia -- mas nenhum dos dois FIXAVA nada: os dois apps web caiam no padrao do Next e o segundo a subir ia para 3001 calado (issue #212). O CLAUDE.md manda registrar a colisao, nunca trocar em silencio. O totem fica na 3210.",
    "dev": "node ../../scripts/check-port.mjs 3000 painel && next dev -p 3000",
    "start": "next start -p 3000",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pretest:e2e": "node --env-file-if-exists=../../.env ../../scripts/preparar-banco-de-teste.mjs e2e"
  },
  "dependencies": {
    "@arenahub/api-contracts": "workspace:*",
    "@arenahub/ui": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@arenahub/config": "workspace:*",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "jsdom": "27.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.5.0 <23.0.0"
  }
}
