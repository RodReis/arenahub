# Ambiente de desenvolvimento local do ArenaHub.
#
#   cp .env.example .env
#
# O .env real esta no .gitignore e NUNCA e versionado.
#
# ATENCAO: os valores abaixo sao de desenvolvimento e propositalmente obvios.
# Eles nao servem para nenhum outro ambiente. Producao e homologacao usam
# secret manager -- ver CLAUDE.md e docs/ARCHITECTURE.md.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=arenahub
POSTGRES_PASSWORD=arenahub_dev
POSTGRES_DB=arenahub
POSTGRES_PORT=5432

DATABASE_URL=postgresql://arenahub:arenahub_dev@localhost:5432/arenahub?schema=public

# --- Redis ------------------------------------------------------------------
# Provisionado para o ambiente local ficar completo. Isso NAO autoriza adotar
# BullMQ: fila entra so quando comprovadamente necessaria (CLAUDE.md -> Stack).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (Object Storage S3-compativel) ----------------------------------
MINIO_ROOT_USER=arenahub
MINIO_ROOT_PASSWORD=arenahub_dev_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=arenahub
S3_SECRET_KEY=arenahub_dev_minio
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- API --------------------------------------------------------------------
# Porta fixa por decisao registrada: se 3344 estiver ocupada, falha em vez de
# trocar (CLAUDE.md -> Regras de trabalho).
API_PORT=3344
