{
  "name": "@arenahub/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system do ArenaHub: pipeline de tokens e primitivas compartilhadas",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./theme.css": "./dist-tokens/theme.css",
    "./tokens": {
      "types": "./dist/tokens.generated.d.ts",
      "import": "./dist/tokens.generated.js",
      "default": "./src/tokens.generated.ts"
    }
  },
  "files": [
    "dist",
    "dist-tokens",
    "src",
    "tokens"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build": "node scripts/build-tokens.mjs && tsc -p tsconfig.build.json",
    "//lint": "Escopo em `src` porque `scripts/build-tokens.mjs` e JavaScript de build que roda em Node, fora do programa TypeScript do pacote -- o parser type-aware exigiria inclui-lo no tsconfig, e incluir arrastaria o pipeline para o typecheck do que ele mesmo gera. Mesmo tratamento dos `scripts/*.mjs` da raiz, que tambem nao sao lintados.",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@arenahub/config": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.5.0 <23.0.0"
  },
  "dependencies": {
    "@arenahub/access-policy": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
