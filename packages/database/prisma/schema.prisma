// Schema do ArenaHub.
//
// REGRA DE ARQUITETURA No 2, sem excecao (CLAUDE.md):
//
//   - `tenant_id` em TODA entidade de negocio;
//   - `gym_unit_id` quando o dado e fisico;
//   - o tenant vem da identidade autenticada, nunca do corpo da requisicao
//     nem do payload de webhook.
//
// Convencao de nomes: model em PascalCase singular, coluna em snake_case via
// @map, tabela em snake_case plural via @@map. Contrato de dominio completo
// em docs/CONVENTION.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  /// Desligado pelo dono do SaaS -- ato administrativo (ADR-052 secao 4).
  INACTIVE
  /// Inadimplencia. Quem escreve e a F65 (ADR-053), nunca o CRUD.
  SUSPENDED

  @@map("tenant_status")
}

enum GymUnitStatus {
  ACTIVE
  INACTIVE

  @@map("gym_unit_status")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  ARCHIVED

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  REVOKED

  @@map("membership_status")
}

/// Estado do segundo fator por usuario. `PENDING` existe porque um perfil
/// privilegiado pode ter iniciado a inscricao sem te-la confirmado -- e
/// nesse intervalo ele nao pode receber acesso completo.
enum MfaStatus {
  DISABLED
  PENDING
  ENABLED

  @@map("mfa_status")
}

enum SessionStatus {
  ACTIVE
  ROTATED
  REVOKED

  @@map("session_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum ActorType {
  USER
  SYSTEM
  SUPPORT

  @@map("actor_type")
}

/// Ciclo de vida comercial do aluno (`M1` secao 10).
///
/// As TRANSICOES entre estes estados eram `[indefinido]` no CONVENTION.md
/// secao 3.1, que mandava defini-las na spec de F7 -- e a spec saiu vazia. A
/// tabela adotada vive em `student.ts` (STUDENT_TRANSITIONS), decidida nesta
/// fatia a partir do plano de apoio. O CONVENTION.md secao 3.1 precisa da
/// emenda correspondente.
enum StudentStatus {
  LEAD
  TRIAL
  ACTIVE
  SUSPENDED
  BLOCKED
  CANCELLED
  ARCHIVED

  @@map("student_status")
}

/// Por que o aluno foi suspenso ou bloqueado (issue #241).
///
/// LISTA FECHADA, e nao texto livre, por decisao do PI em 01/09/2026: o
/// dashboard precisa contar por razao ("principal motivo: inadimplencia"), e
/// texto livre nao se agrupa -- "inadimplente", "nao pagou" e "atraso" viram
/// tres razoes distintas para o mesmo fato. A observacao livre continua
/// existindo ao lado, em `statusReasonNote`, para o caso concreto.
///
/// NAO E CAUSA DE DECISAO DE ACESSO. Quem decide entrada e o entitlement
/// (regra de arquitetura no 1) -- este campo explica um status que ja foi
/// decidido, nunca o produz.
enum StudentStatusReason {
  /// Mensalidade em atraso. O job de inadimplencia NAO grava este valor
  /// sozinho: ele age no entitlement, nao no status do aluno. Quem bloqueia
  /// pelo painel e que escolhe a razao.
  DELINQUENCY
  /// Pausa combinada: viagem, mudanca de cidade, questao pessoal.
  STUDENT_REQUEST
  /// Atestado ou recomendacao medica. Guarda a RAZAO ADMINISTRATIVA da
  /// suspensao, nunca o quadro clinico -- diagnostico nao entra aqui.
  MEDICAL
  /// Quebra de regra da academia: conduta, dano a equipamento, emprestimo de
  /// credencial.
  CONDUCT

  @@map("student_status_reason")
}

enum StudentContactType {
  EMAIL
  PHONE
  WHATSAPP
  /// Contato de terceiro, para quando o aluno passa mal na academia. Usa
  /// `label` (nome de quem atende) e `relationship` (parentesco) -- os dois
  /// unicos campos que so este tipo preenche. Tabela propria guardaria tres
  /// strings e duplicaria a normalizacao de telefone que ja existe aqui.
  EMERGENCY

  @@map("student_contact_type")
}

/// Papel da pessoa na academia. NAO decide acesso -- origina um
/// `Entitlement` (F48). Ler isto dentro do motor de decisao criaria a
/// segunda fonte de verdade que a regra de arquitetura no 1 proibe.
enum StudentProfile {
  /// Acesso liberado por vinculo.
  ADMIN
  /// Acesso controlado: depende de plano vigente. E o caso comum.
  STUDENT
  /// Funcionario. Acesso liberado por vinculo.
  STAFF
  /// Professor ou personal. Acesso liberado por vinculo.
  TRAINER

  @@map("student_profile")
}

/// Tipo de credencial que o equipamento le para identificar a pessoa.
///
/// NAO E BIOMETRIA: e o numero que o leitor usa como chave. O template
/// facial vive no equipamento e no `BiometricIdentity`, que exige
/// consentimento (INV-017) e nao e tocado por aqui.
enum StudentCredentialKind {
  /// Cartao de proximidade.
  TURNSTILE_CARD
  /// `enrollid` do cadastro facial dentro do leitor.
  FACIAL_ENROLL_ID

  @@map("student_credential_kind")
}

/// Sexo CADASTRAL: espelha o documento civil, e nada mais.
///
/// Identidade de genero e nome social sao OUTRA coisa, nao foram pedidos, e
/// se um dia entrarem sao campos proprios -- reaproveitar este seria erro de
/// modelagem antes de ser erro de tratamento.
enum StudentRegisteredSex {
  FEMALE
  MALE
  NOT_INFORMED

  @@map("student_registered_sex")
}

/// De onde veio o aluno. Valores decididos pelo PI em 18/08/2026.
///
/// Enum, nao texto livre: "indicacao", "Indicacao" e "indic." sao a mesma
/// origem para a recepcao e tres linhas distintas em qualquer relatorio.
/// `OUTRO` e a valvula de escape; acrescentar valor e migration de enum.
enum LeadSource {
  INDICACAO
  REDES_SOCIAIS
  PASSAGEM_NA_PORTA
  CAMPANHA
  SITE
  OUTRO

  @@map("lead_source")
}

/// `PAST_DUE` existe no enum e NAO e alcancavel no MVP 1.
///
/// O CONVENTION.md secao 3.2 e explicito: sem cobranca automatica, nada leva
/// a assinatura para PAST_DUE. O valor entra agora porque o modelo e o mesmo
/// que o MVP 2 vai usar -- criar a coluna depois custaria migration de enum
/// em tabela ja populada. Nenhuma transicao desta fatia o alcanca.
/// Modalidade de cobranca do plano -- ADR-043, Decisao 2.
///
/// A assinatura NAO terceiriza o ciclo: o calendario, o valor, a carencia e o
/// bloqueio continuam do ArenaHub. O que muda e que existe um metodo salvo e
/// uma autorizacao do aluno para cobrar sem ele agir. Era exatamente isso que
/// o Subscriptions Engine da Getnet tiraria, e o motivo de a Decisao 2 te-lo
/// recusado.
enum PlanBillingMode {
  /// O ArenaHub gera a invoice do periodo; ALGUEM cobra -- recepcao ou o
  /// proprio aluno pelo totem.
  AVULSO
  /// O ArenaHub gera a invoice do periodo E cobra sozinho no cartao salvo,
  /// com o retry do tenant.
  ASSINATURA

  @@map("plan_billing_mode")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

enum EntitlementStatus {
  SCHEDULED
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED

  @@map("entitlement_status")
}

/// Origem do direito de acesso (INV-064).
///
/// Enum EXTENSIVEL por decisao do ADR-009: convenio corporativo esta fora do
/// roadmap hoje, mas o campo nao fecha a porta. Acrescentar valor aqui e
/// migration de enum, nao redesenho de tabela.
enum EntitlementSource {
  SUBSCRIPTION
  COURTESY
  EMPLOYEE
  PERSONAL_TRAINER
  VISITOR
  TRIAL_CLASS
  DEPENDENT
  PARTNER
  CORPORATE

  @@map("entitlement_source")
}

/// Tipo de evento da timeline administrativa do aluno.
enum StudentTimelineEventType {
  STUDENT_CREATED
  STUDENT_UPDATED
  STUDENT_STATUS_CHANGED
  STUDENT_ARCHIVED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_RESUMED
  SUBSCRIPTION_CANCELLED
  ENTITLEMENT_ACTIVATED
  ENTITLEMENT_SUSPENDED
  ENTITLEMENT_REVOKED
  ENTITLEMENT_EXPIRED
  COURTESY_GRANTED
  BIOMETRIC_CONSENT_ACCEPTED
  BIOMETRIC_CONSENT_REFUSED
  BIOMETRIC_CONSENT_REVOKED
  BIOMETRIC_IDENTITY_CREATED
  BIOMETRIC_IDENTITY_REVOKED
  BIOMETRIC_IDENTITY_DELETED

  @@map("student_timeline_event_type")
}

/// Finalidade do documento de consentimento.
///
/// ATENCAO AO REGIME: `BIOMETRIC`, `HEALTH` e `AI_ANALYSIS` sao OPT-IN --
/// sem linha aceita, nao autoriza. As quatro finalidades de ENGAJAMENTO sao
/// OPT-OUT: sem linha, o aluno PARTICIPA (ADR-046, decisao do PI em
/// 26/08/2026). A mesma tabela guarda os dois regimes, e o predicado de
/// cada um vive separado -- `modules/privacy` para o primeiro,
/// `modules/engagement/domain/participacao.ts` para o segundo.
enum ConsentDocumentType {
  BIOMETRIC

  HEALTH

  AI_ANALYSIS

  /// Aparecer em ranking. OPT-OUT.
  RANKING

  /// Participar de desafio. OPT-OUT. DORMENTE ate a F34.
  CHALLENGE

  /// Receber notificacao de engajamento. OPT-OUT. DORMENTE: nao ha app.
  ENGAGEMENT_PUSH

  /// Aparecer em ranking de evolucao fisica. OPT-OUT. DORMENTE ate a F33.
  PHYSICAL_EVOLUTION_RANKING

  @@map("consent_document_type")
}

enum ConsentDecision {
  ACCEPTED
  REFUSED

  @@map("consent_decision")
}

/// Quem prestou o consentimento.
///
/// INV-143 (ADR-008): menor de 18 so tem cadastro biometrico com
/// consentimento de responsavel legal. O tipo fica na propria decisao para
/// que a revalidacao na virada dos 18 seja consulta, nao arqueologia.
enum ConsentSubjectKind {
  /// O proprio aluno, maior de 18 na data da decisao.
  STUDENT
  /// Responsavel legal por aluno menor de 18.
  LEGAL_GUARDIAN

  @@map("consent_subject_kind")
}

/// De QUEM e a assinatura -- eixo introduzido pela F21.
///
/// Ate a F20 toda decisao era do titular, e o papel era implicito. O aceite
/// da analise por IA exige DUAS assinaturas de naturezas diferentes:
///
///   - `STUDENT_CONSENT` -- consentimento do titular (LGPD art. 11). So ele
///     autoriza o dado a sair do pais;
///   - `PROFESSIONAL_ENDORSEMENT` -- endosso do profissional que pediu a
///     analise. NAO e consentimento: e o humano no circuito que a regra de
///     arquitetura no 8 exige.
///
/// Guardar as duas na mesma coluna `subject_kind` misturaria "quem consentiu"
/// com "quem operou" -- duas perguntas separadas numa fiscalizacao.
enum ConsentSignerRole {
  STUDENT_CONSENT
  PROFESSIONAL_ENDORSEMENT

  @@map("consent_signer_role")
}

/// Estado da identidade biometrica.
///
/// A ordem importa e e a do INV-019: revogar desativa logicamente ANTES de
/// a exclusao fisica acontecer. `REVOKED` ja bloqueia; `DELETION_PENDING`
/// diz que os leitores ainda nao confirmaram; `DELETED` so quando todos
/// confirmaram (INV-018, INV-027).
enum BiometricIdentityState {
  ACTIVE
  REVOKED
  DELETION_PENDING
  DELETED

  @@map("biometric_identity_state")
}

/// Estado operacional do Edge (PC da academia).
enum EdgeNodeStatus {
  ACTIVE
  SUSPENDED

  @@map("edge_node_status")
}

/// Estado do dispositivo fisico (leitor facial, catraca).
enum DeviceStatus {
  ACTIVE
  MAINTENANCE
  RETIRED

  @@map("device_status")
}

/// Categoria do dispositivo. Amplia quando outro tipo for homologado.
enum DeviceKind {
  FACIAL_READER
  TURNSTILE

  @@map("device_kind")
}

/// Estado do cadastro do aluno DENTRO de um dispositivo.
enum DeviceUserState {
  PENDING
  SYNCED
  REMOVAL_PENDING
  REMOVED
  FAILED

  @@map("device_user_state")
}

/// Operacao de sincronizacao. Nao ha lote: INV-023 -- o protocolo facial
/// exige fila individual por usuario e por dispositivo (INV-024).
enum DeviceSyncOperation {
  UPSERT
  DELETE

  @@map("device_sync_operation")
}

/// Estado do job de sincronizacao, visivel no painel de pendencia.
enum DeviceSyncJobState {
  PENDING
  PROCESSING
  SYNCED
  RETRYING
  FAILED
  REMOVED

  @@map("device_sync_job_state")
}

/// Estado do comando duravel entregue ao Edge.
enum DeviceCommandState {
  AVAILABLE
  LEASED
  ACKNOWLEDGED
  FAILED

  @@map("device_command_state")
}

/// O que foi acessado no registro de acesso a dado biometrico.
///
/// ADR-008: log de acesso a template e imagem foi UMA DAS TRES CAUSAS da
/// suspensao da ANPD no caso da rede estadual do PR (04/08/2026). Nao e
/// item de observabilidade -- e prova de controle de acesso.
enum BiometricAccessKind {
  ENROLLMENT_IMAGE
  IDENTITY_METADATA

  @@map("biometric_access_kind")
}

/// Por que o dado biometrico foi acessado.
enum BiometricAccessPurpose {
  ENROLLMENT
  DEVICE_SYNC
  REVOCATION
  PURGE
  AUDIT

  @@map("biometric_access_purpose")
}

// ---------------------------------------------------------------------------
// Decisao de acesso (F9)
// ---------------------------------------------------------------------------

/// Resultado da decisao -- ADR-005 fixou `ALLOW`/`DENY`, nao `GRANTED`/`DENIED`.
enum AccessOutcome {
  ALLOW
  DENY

  @@map("access_outcome")
}

/// Razao estavel da decisao -- ADR-024.
///
/// ESTE ENUM E PERSISTIDO E IMUTAVEL. Renomear um valor aqui nao e refactor:
/// e reescrever auditoria ja entregue. O MVP 2 ACRESCENTA `PAYMENT_OVERDUE`
/// pelo fim; nao mexe no que existe.
///
/// Espelha `packages/access-policy/src/types.ts`, que e a fonte -- o motor
/// puro nao pode importar Prisma porque precisa rodar tambem no Edge, onde
/// nao ha PostgreSQL. `access-reason.spec.ts` guarda a igualdade das duas
/// listas.
enum AccessReason {
  ACTIVE_ENTITLEMENT
  /// Liberacao manual da recepcao. So valido com `mode = OVERRIDE`.
  MANUAL_OVERRIDE
  ADMIN_BLOCK
  STUDENT_BLOCKED
  STUDENT_INACTIVE
  NO_ENTITLEMENT
  WRONG_UNIT
  OUTSIDE_SCHEDULE
  /// F15 -- direito suspenso por inadimplencia. Acrescentado PELO FIM.
  PAYMENT_OVERDUE
  /// F15 -- liberacao financeira excepcional, com prazo. Nao e o mesmo que
  /// `MANUAL_OVERRIDE`: aquele e por passagem, este e por periodo.
  FINANCIAL_OVERRIDE
  /// F65 (ADR-053) -- a ACADEMIA esta suspensa por inadimplencia com o
  /// ArenaHub. Nega todo mundo e nao toca em Entitlement nenhum. Nao
  /// confundir com `PAYMENT_OVERDUE`, que e o ALUNO devendo a academia.
  TENANT_SUSPENDED

  @@map("access_reason")
}

/// Como a decisao foi tomada.
///
/// `OFFLINE` ja existe aqui, embora a Slice 1.5 e quem vai produzi-lo: o
/// campo e imutavel e acrescentar valor a enum depois exige migracao com
/// tabela em uso. Reservar agora custa uma linha.
enum AccessMode {
  ONLINE
  OFFLINE
  OVERRIDE

  @@map("access_mode")
}

/// Como a pessoa se identificou na catraca.
enum AccessMethod {
  FACIAL
  QR
  CARD
  PIN
  MANUAL

  @@map("access_method")
}

/// Desfecho fisico da passagem -- `M1` §10.
///
/// `NOT_APPLICABLE` cobre o `DENY`: nao houve comando, entao nao ha giro a
/// confirmar. Sem esse valor, todo `DENY` ficaria com passagem nula e
/// "nulo" teria dois significados (nao se aplica / ainda esperando).
enum PassageState {
  NOT_APPLICABLE
  PENDING
  CONFIRMED
  TIMED_OUT

  @@map("passage_state")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// Academia. Nivel de cima da hierarquia decidida no ADR-002.
model Tenant {
  id               String  @id @default(uuid()) @db.Uuid
  /// Global: e o identificador publico do tenant, usado em URL e convite.
  slug             String  @unique
  legalName        String  @map("legal_name")
  displayName      String  @map("display_name")
  /// Dados cadastrais do contrato, preenchidos pelo Super Admin (F61).
  /// Opcionais porque os tenants que ja existem nasceram sem eles.
  cnpj             String?
  timezone         String?
  responsavelNome  String? @map("responsavel_nome")
  responsavelEmail String? @map("responsavel_email")

  /// Identidade visual da academia (F62, ADR-052 §9).
  ///
  /// CHAVE DE OBJETO, e nao URL: o bucket e privado e a URL publica dele nunca
  /// e o que a tela usa. Guardar URL assinada em coluna gravaria um link que
  /// expira -- a coluna passaria a mentir sozinha depois de alguns minutos.
  ///
  /// Nulo = sem arquivo enviado, e a tela cai na marca ArenaHub. Opcionais
  /// porque os tenants que ja existem nasceram sem eles, e porque academia
  /// sem logo tem de continuar entrando no painel.
  logoObjectKey  String? @map("logo_object_key")
  iconObjectKey  String? @map("icon_object_key")
  /// Missao e diferenciais: texto que ocupa o hero da tela de login por slug.
  /// TEXTO PURO, escapado pelo React na renderizacao -- nao aceita HTML, pelo
  /// mesmo motivo que o SVG e sanitizado no upload.
  missionText    String? @map("mission_text")
  highlightsText String? @map("highlights_text")

  status TenantStatus @default(ACTIVE)

  /// F65 (ADR-053, decisao D2 do PI em 09/09/2026) -- suspensao automatica
  /// por inadimplencia.
  ///
  /// AQUI e nao no contrato: `TenantContract` e IMUTAVEL depois de ativo
  /// (F63), e virar esta chave exigiria contrato novo com PDF novo. Suspender
  /// ou nao e decisao operacional do dono do SaaS, nao clausula negociada.
  ///
  /// Nasce DESLIGADA: ligada por padrao fecharia catraca de inadimplente no
  /// primeiro deploy, sem ninguem ter decidido isso por aquele cliente.
  autoSuspend Boolean @default(false) @map("auto_suspend")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gymUnits     GymUnit[]
  modalities   GymUnitModality[]
  memberships  TenantMembership[]
  roles        Role[]
  userRoles    UserRole[]
  sessions     Session[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  outboxEvents OutboxEvent[]

  /// F67 (ADR-054 §5) -- tabelas que passaram a ter `tenant_id` proprio.
  accessPassages         AccessPassage[]
  planUnits              PlanUnit[]
  planAccessWindows      PlanAccessWindow[]
  entitlementUnitWindows EntitlementUnitWindow[]
  rankingEntries         RankingEntry[]
  replayNonces           ReplayNonce[]

  supportElevations SupportElevation[]

  /// Contratos do ArenaHub com esta academia (F63, ADR-052 §8).
  contracts TenantContract[]

  /// Faturas do ArenaHub sobre esta academia (F64, ADR-052).
  platformInvoices PlatformInvoice[]

  students           Student[]
  studentCredentials StudentCredential[]
  studentSequence    StudentSequence?
  plans              Plan[]
  subscriptions      Subscription[]
  entitlements       Entitlement[]

  consentDocuments    ConsentDocument[]
  consentRecords      ConsentRecord[]
  biometricIdentities BiometricIdentity[]
  biometricAccessLogs BiometricAccessLog[]
  privacySettings     TenantPrivacySettings?
  edgeNodes           EdgeNode[]
  edgeCredentials     EdgeCredential[]
  devices             Device[]
  deviceUsers         DeviceUser[]
  deviceSyncJobs      DeviceSyncJob[]
  deviceCommands      DeviceCommand[]

  kioskDevices        KioskDevice[]
  kioskCredentials    KioskCredential[]
  kioskConfigurations KioskConfiguration[]
  kioskSessions       KioskSession[]

  accessPolicies         AccessPolicy[]
  operationalAlerts      OperationalAlert[]
  localHolidays          LocalHoliday[]
  dataExportJobs         DataExportJob[]
  administrativeBlocks   AdministrativeBlock[]
  accessEvents           AccessEvent[]
  accessEventCorrections AccessEventCorrection[]
  manualAccessOverrides  ManualAccessOverride[]
  planPrices             PlanPrice[]
  planBenefits           PlanBenefit[]
  familyGroups           FamilyGroup[]
  familyMembers          FamilyMember[]
  studentModalities      StudentModality[]
  billingSettings        BillingSettings?
  invoices               Invoice[]
  invoiceItems           InvoiceItem[]
  payments               Payment[]
  paymentAttempts        PaymentAttempt[]
  paymentMethods         PaymentMethod[]
  accountCredits         AccountCredit[]
  invoiceSequence        InvoiceSequence?
  financialOverrides     FinancialAccessOverride[]
  providerAccounts       ProviderAccount[]
  providerEvents         ProviderEvent[]

  refunds             Refund[]
  receipts            Receipt[]
  receiptSequence     ReceiptSequence?
  reconciliationRuns  ReconciliationRun[]
  externalMovements   ExternalMovement[]
  reconciliationItems ReconciliationItem[]

  bodyAssessments      BodyAssessment[]
  bodyMeasurements     BodyMeasurement[]
  studentHealthContext StudentHealthContext[]
  healthGoals          HealthGoal[]
  attendanceSessions   StudentAttendanceSession[]
  aiAnalyses           AiAnalysis[]
  assessmentImports    AssessmentImport[]
  importedFields       ImportedField[]

  publicProfiles PublicProfile[]

  xpRuleVersions                   XpRuleVersion[]
  xpLedgerEntries                  XpLedgerEntry[]
  xpBalances                       StudentXpBalance[]
  achievementDefinitions           AchievementDefinitionVersion[]
  achievements                     StudentAchievement[]
  rankingSnapshots                 RankingSnapshot[]
  challengeTemplates               ChallengeTemplateVersion[]
  challenges                       Challenge[]
  challengeParticipants            ChallengeParticipant[]
  challengeNotices                 ChallengeNotice[]
  engagementDisputes               EngagementDispute[]
  retentionTargetVersions          RetentionTargetVersion[]
  retentionFeatureSetVersions      RetentionFeatureSetVersion[]
  studentFeatureSnapshots          StudentFeatureSnapshot[]
  retentionRuleVersions            RetentionRuleVersion[]
  retentionScores                  RetentionScore[]
  retentionScoreSkips              RetentionScoreSkip[]
  retentionSuppressions            RetentionSuppression[]
  retentionCapacityPolicies        RetentionCapacityPolicy[]
  retentionTasks                   RetentionTask[]
  retentionInteractions            RetentionInteraction[]
  retentionExperiments             RetentionExperiment[]
  retentionExperimentAssignments   RetentionExperimentAssignment[]
  retentionExperimentAdverseEvents RetentionExperimentAdverseEvent[]

  /// Minimo de participantes para publicar um placar (`M5-BR-007`).
  /// ADR-047: 5. Configuravel por tenant -- academia pequena e academia
  /// grande nao tem a mesma nocao de "poucos".
  rankingMinimumCohort Int @default(5) @map("ranking_minimum_cohort")

  // --- F35: flags e teto de correcao (ADR-049, Decisoes 2 e 3) ------------
  //
  // Flag e COLUNA, nao servico de flags e nao `if` no codigo -- mesmo
  // precedente de `BillingSettings.blockAnchor`: "regra que vive dentro de um
  // `if` e regra que ninguem encontra depois". Moram aqui, ao lado de
  // `rankingMinimumCohort`, porque ja existe config de engajamento por tenant
  // e uma tabela nova so para tres booleanos seria tabela para achar depois.
  //
  // Desligar NAO apaga nada: o ledger continua, o snapshot continua, o aluno
  // so para de ver. Religar devolve tudo, porque nada foi destruido.

  /// Placar publico e area de XP do totem. Desligado, o bloco sai do
  /// carrossel -- mesmo comportamento de coorte insuficiente.
  engagementRankingEnabled      Boolean @default(true) @map("engagement_ranking_enabled")
  /// Desafios (F34). Desligado, nenhum desafio novo abre e os abertos param
  /// de aparecer; participante e progresso ficam intactos.
  engagementChallengesEnabled   Boolean @default(true) @map("engagement_challenges_enabled")
  /// Conquistas (F31). Desligado, para de avaliar e de exibir; o ja
  /// desbloqueado nao e revogado.
  engagementAchievementsEnabled Boolean @default(true) @map("engagement_achievements_enabled")

  /// Teto da correcao manual de XP, em pontos absolutos, por operacao.
  /// Nulo = sem teto.
  ///
  /// RECUSA, NAO APROVA (ADR-049, Decisao 2): acima do teto a operacao e
  /// barrada com erro de dominio. Nao existe papel de aprovador, e uma fila
  /// que exige dois operadores numa academia que tem um nunca anda.
  engagementCorrectionLimitPoints Int? @map("engagement_correction_limit_points")

  /// KILL SWITCH do scoring de retencao (F41, `M6-FR-017`).
  ///
  /// COLUNA, e nao servico de flags: mesmo precedente das tres flags de
  /// engajamento acima. "Sem deploy" e o requisito (`M6-NFR-006`: efeito em
  /// ate cinco minutos), e um `UPDATE` numa coluna e o caminho mais curto
  /// entre a decisao e o efeito.
  ///
  /// DESLIGA SO O CALCULO NOVO -- decisao do PI em 31/08/2026. Para de
  /// pontuar e de gerar fila; scores ja gravados continuam legiveis com marca
  /// de idade (F37) e **tarefas abertas seguem trataveis ate o fim**. E o que
  /// `M6-NFR-009` exige: "tarefas e interacoes permanecem disponiveis se o
  /// scoring estiver indisponivel".
  ///
  /// Desligar nao apaga nada. Religar devolve o pipeline, porque nada foi
  /// destruido -- mesma propriedade das flags de engajamento.
  retentionScoringEnabled Boolean @default(true) @map("retention_scoring_enabled")

  @@map("tenants")
}

/// Unidade fisica. Onde a catraca mora.
model GymUnit {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  /// Unico dentro do tenant, reutilizavel entre tenants: duas academias sem
  /// relacao podem ter uma unidade "CENTRO" cada.
  code         String
  name         String
  /// IANA (`America/Sao_Paulo`). O ADR-019 exige timezone da unidade, sem
  /// fallback -- horario de funcionamento e bloqueio dependem dele.
  timezone     String
  /// Horario semanal de funcionamento. JSON porque a forma ainda varia por
  /// academia; vira tabela quando alguem precisar consultar por faixa.
  openingHours Json          @map("opening_hours")
  status       GymUnitStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]
  students  Student[]

  accessPolicies        AccessPolicy[]
  accessEvents          AccessEvent[]
  manualAccessOverrides ManualAccessOverride[]
  operationalAlerts     OperationalAlert[]
  attendanceSessions    StudentAttendanceSession[]

  rankingSnapshots RankingSnapshot[]
  challenges       Challenge[]

  retentionCapacityPolicy RetentionCapacityPolicy?
  retentionTasks          RetentionTask[]
  localHolidays           LocalHoliday[]
  modalities              GymUnitModality[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("gym_units")
}

/// Modalidade oferecida por uma unidade -- F60.
///
/// POR UNIDADE, e nao por tenant: decisao do PI em 04/09/2026. Cada unidade
/// define a propria lista, e a Arena Positiva e um complexo esportivo cujas
/// unidades futuras nao oferecem as mesmas coisas. O catalogo por tenant com
/// tabela de oferta (o padrao `Plan` + `PlanUnit`) so ganha quando existir
/// relatorio cruzando unidades -- ate la seria uma tabela a mais para
/// responder a mesma pergunta.
///
/// NAO E CONTROLE DE ACESSO. Modalidade e ROTULO: serve para diferenciar o
/// aluno de quadra do aluno de academia na recepcao e no relatorio. Quem
/// decide se a catraca abre continua sendo o plano, por `PlanUnit` e
/// `EntitlementUnitWindow` -- ler esta tabela numa decisao de acesso criaria
/// a segunda fonte de verdade que a regra de arquitetura no 1 proibe. Hoje
/// so a Academia tem catraca.
///
/// SEM `code`: modalidade nasce como nome livre digitado pela recepcao
/// ("Quadras de Areia"), e exigir codigo obrigaria a inventar uma regra de
/// nomenclatura que ninguem pediu. O `name` unico por unidade ja impede a
/// duplicata que importa.
model GymUnitModality {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  gymUnitId String   @map("gym_unit_id") @db.Uuid
  name      String
  /// Inativar, nunca apagar -- mesmo motivo da propria unidade: aluno ja
  /// vinculado ficaria orfao, e o historico de quem treinou o que sumiria.
  /// Modalidade inativa some do cadastro novo e permanece nos vinculos.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// `RESTRICT` como `Student.gymUnit`: apagar unidade com modalidade falha,
  /// em vez de levar o vinculo do aluno junto.
  gymUnit  GymUnit           @relation(fields: [gymUnitId], references: [id], onDelete: Restrict)
  students StudentModality[]

  /// Unico POR UNIDADE, nao por tenant: duas unidades do mesmo complexo
  /// podem oferecer "Cross Fit" cada uma, e sao ofertas distintas.
  @@unique([gymUnitId, name])
  @@index([tenantId])
  @@map("gym_unit_modalities")
}

/// Vinculo aluno <-> modalidade -- F60.
///
/// TABELA DE JUNCAO, e nao coluna no aluno: o PI decidiu em 04/09/2026 que
/// um aluno pode ter VARIAS modalidades ao mesmo tempo (academia e cross fit
/// juntos). Array de enum na linha do aluno nao teria integridade
/// referencial, e nao sobreviveria a uma modalidade renomeada.
model StudentModality {
  studentId  String   @map("student_id") @db.Uuid
  modalityId String   @map("modality_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// `RESTRICT`: modalidade com aluno vinculado se INATIVA, nao se apaga.
  modality GymUnitModality @relation(fields: [modalityId], references: [id], onDelete: Restrict)

  @@id([studentId, modalityId])
  @@index([tenantId])
  @@index([modalityId])
  @@map("student_modalities")
}

/// Feriado MUNICIPAL da unidade -- F57, `SPEC-057` §5.2.
///
/// Os NACIONAIS nao moram aqui: sao calculados em processo (`date-holidays`),
/// e gravar 12 linhas por ano por unidade seria copiar uma lista que nao
/// muda -- com o custo de alguem lembrar de rodar o seed todo dezembro.
///
/// A ancora e a UNIDADE, nao o municipio (saida A, decisao do PI em
/// 01/09/2026): `GymUnit` nao tem cidade nem codigo IBGE, e acrescentar um
/// so para isto seria migracao maior que a fatia. O que isso aceita de
/// proposito: duas unidades na mesma cidade cadastram a mesma data duas
/// vezes, e podem divergir. Barato enquanto houver uma unidade por cidade --
/// o gatilho de revisao e a SEGUNDA unidade no mesmo municipio, e a mudanca
/// e migracao de dado (as datas sobem para o municipio), nao redesenho.
///
/// SO DE LEITURA nesta fatia: o calendario nao adia vencimento de fatura nem
/// pausa SLA da fila de retencao. Os dois consumidores existem e tem linha
/// (`billing/domain/ciclo-de-cobranca.ts`, `retention/domain/selecao-de-fila.ts`),
/// e ligar qualquer um deles e caro de desfazer -- pede ADR, nao PR.
model LocalHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  gymUnitId String   @map("gym_unit_id") @db.Uuid
  /// A DATA local do feriado, sem hora. `@db.Date` e nao `DateTime`: feriado
  /// e um dia do calendario, e guardar instante reintroduziria o fuso que a
  /// unidade ja resolveu -- 25/12 as 00:00 de Brasilia e 24/12 em UTC.
  date      DateTime @db.Date
  /// Como aparece na tela ("Aniversario da cidade").
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit GymUnit @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)

  /// Uma data so pode ser cadastrada uma vez por unidade: sem isto, dois
  /// cliques no botao deixam o mesmo feriado duas vezes na lista.
  @@unique([gymUnitId, date])
  @@index([tenantId, gymUnitId, date])
  @@map("local_holidays")
}

// ---------------------------------------------------------------------------
// Identidade e permissao
// ---------------------------------------------------------------------------

/// Usuario interno (proprietario, gerente, recepcao, tecnico, suporte).
///
/// NAO tem `tenantId`: a mesma pessoa pode atender duas academias, e o
/// vinculo mora em `TenantMembership`. A regra no 2 continua valendo -- o
/// que ela exige e que toda entidade de NEGOCIO carregue tenant; identidade
/// e o ponto onde o vinculo se estabelece, nao onde se pressupoe.
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  /// Normalizado em minusculas antes de gravar; unico globalmente.
  email               String     @unique
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(ACTIVE)
  mfaStatus           MfaStatus  @default(DISABLED) @map("mfa_status")
  /// Segredo TOTP cifrado com AES-256-GCM. Os tres campos andam juntos: sem
  /// IV e tag nao ha como decifrar, e guardar o segredo em claro
  /// transformaria leitura de tabela em clonagem de segundo fator.
  mfaSecretCiphertext Bytes?     @map("mfa_secret_ciphertext")
  mfaSecretIv         Bytes?     @map("mfa_secret_iv")
  mfaSecretTag        Bytes?     @map("mfa_secret_tag")
  /// Ultimo contador TOTP aceito. Impede replay do mesmo codigo dentro da
  /// janela de validade.
  mfaLastCounter      BigInt?    @map("mfa_last_counter")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  memberships           TenantMembership[]
  userRoles             UserRole[]
  sessions              Session[]
  auditLogs             AuditLog[]
  /// Alunos de quem este usuario e consultor responsavel.
  advisedStudents       Student[]              @relation("StudentAdvisor")
  evaluatedAssessments  BodyAssessment[]       @relation("AssessmentEvaluator")
  recordedHealthContext StudentHealthContext[] @relation("HealthContextRecorder")
  authoredHealthGoals   HealthGoal[]           @relation("HealthGoalAuthor")
  requestedAiAnalyses   AiAnalysis[]           @relation("AiAnalysisRequester")
  uploadedImports       AssessmentImport[]     @relation("ImportUploader")
  reviewedImports       AssessmentImport[]     @relation("ImportReviewer")
  moderatedProfiles     PublicProfile[]
  resolvedDisputes      EngagementDispute[]

  platformAdmin         PlatformAdmin?     @relation("PlatformAdminUser")
  platformAdminsGranted PlatformAdmin[]    @relation("PlatformAdminGrantedBy")
  supportElevations     SupportElevation[] @relation("SupportElevationAdmin")
  platformAuditLogs     PlatformAuditLog[] @relation("PlatformAuditActor")

  @@map("users")
}

/// Vinculo entre usuario e academia.
model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

/// Papel dentro de um tenant. `isSystem` marca os quatro que o produto cria
/// e nao deixa apagar (OWNER, MANAGER, RECEPTIONIST, TECH_OPERATOR).
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// Permissao do catalogo (`unit.create`, `access.override`, ...). Global e
/// estavel: o codigo entra em decorator de rota, entao renomear quebra
/// autorizacao em producao.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Atribuicao de papel. `gymUnitId` nulo = vale no tenant inteiro;
/// preenchido = escopo restrito aquela unidade.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  gymUnitId String?  @map("gym_unit_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  gymUnit GymUnit? @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId, gymUnitId])
  @@index([userId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Sessao e convite
// ---------------------------------------------------------------------------

/// Sessao de refresh token.
///
/// GUARDA HASH, NUNCA O TOKEN. `familyId` agrupa a cadeia de rotacoes: se um
/// token ja rotacionado reaparece, alguem o copiou, e a familia inteira e
/// revogada.
model Session {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  /// Nulo na sessao de PLATAFORMA: o Super Admin nao esta em tenant nenhum.
  /// Toda rota de tenant rejeita contexto sem tenant -- ver AuthGuard.
  tenantId      String?       @map("tenant_id") @db.Uuid
  tokenHash     String        @unique @map("token_hash")
  familyId      String        @map("family_id") @db.Uuid
  status        SessionStatus @default(ACTIVE)
  expiresAt     DateTime      @map("expires_at")
  rotatedAt     DateTime?     @map("rotated_at")
  revokedAt     DateTime?     @map("revoked_at")
  /// Motivo da revogacao (`logout`, `refresh_reused`, `admin`). Sem isso,
  /// investigar incidente vira adivinhacao.
  revokedReason String?       @map("revoked_reason")
  createdAt     DateTime      @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supportElevations SupportElevation[]

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// Convite de uso unico. Tambem guarda so o hash: o link e mostrado uma vez
/// a quem convidou e nunca mais recuperavel.
model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  email      String
  roleId     String           @map("role_id") @db.Uuid
  gymUnitId  String?          @map("gym_unit_id") @db.Uuid
  tokenHash  String           @unique @map("token_hash")
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  revokedAt  DateTime?        @map("revoked_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Plataforma (F61 -- ADR-052)
// ---------------------------------------------------------------------------

/// Dono do SaaS. Fora do mecanismo de papeis por tenant de proposito:
/// `Role` e por tenant (`@@unique([tenantId, name])`) e afrouxa-lo poria
/// papel global e papel de tenant na mesma query -- um bug de filtro ali
/// vira vazamento entre tenants.
model PlatformAdmin {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at")
  /// Revogar e ESCREVER aqui, nunca deletar: o rastro de quem foi dono do
  /// SaaS nao some. Ativo = `revokedAt IS NULL`.
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user      User  @relation("PlatformAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("PlatformAdminGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@map("platform_admins")
}

/// Uma entrada de suporte num tenant. Viva = `endedAt IS NULL AND expiresAt > agora`.
model SupportElevation {
  id                  String    @id @default(uuid()) @db.Uuid
  sessionId           String    @map("session_id") @db.Uuid
  platformAdminUserId String    @map("platform_admin_user_id") @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  /// Justificativa do ato. Texto livre validado no caso de uso (>= 10).
  reason              String
  expiresAt           DateTime  @map("expires_at")
  endedAt             DateTime? @map("ended_at")
  endedReason         String?   @map("ended_reason")
  createdAt           DateTime  @default(now()) @map("created_at")

  session       Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  platformAdmin User    @relation("SupportElevationAdmin", fields: [platformAdminUserId], references: [id], onDelete: Cascade)
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
  @@map("support_elevations")
}

/// Auditoria de ato de PLATAFORMA. Separada do `AuditLog` porque aquele
/// exige `tenantId` com FK -- e "criou o tenant X" nao tem tenant dono no
/// momento do ato.
///
/// Sem `updatedAt` de proposito: registro de auditoria nao se edita.
model PlatformAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  target        String
  targetId      String?  @map("target_id")
  /// SEM foreign key de proposito: e referencia historica e precisa
  /// sobreviver ao tenant que descreve.
  tenantId      String?  @map("tenant_id") @db.Uuid
  correlationId String   @map("correlation_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  /// Mesma regra do `AuditLog`: metadados ja mascarados na aplicacao. E-mail,
  /// CPF e nome de pessoa nao entram -- log nao e lugar de PII.
  metadata      Json?
  occurredAt    DateTime @default(now()) @map("occurred_at")

  actor User? @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([correlationId])
  @@map("platform_audit_logs")
}

// ---------------------------------------------------------------------------
// Auditoria e mensageria
// ---------------------------------------------------------------------------

/// Trilha de auditoria. SEM `updatedAt` DE PROPOSITO: registro de auditoria
/// que muda nao e trilha, e rascunho. Correcao entra como novo registro.
model AuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  gymUnitId     String?   @map("gym_unit_id") @db.Uuid
  actorType     ActorType @map("actor_type")
  actorId       String?   @map("actor_id") @db.Uuid
  action        String
  target        String
  targetId      String?   @map("target_id")
  correlationId String    @map("correlation_id")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  /// Metadados ja mascarados na aplicacao. E-mail, CPF e afins nao entram
  /// em claro -- log nao e lugar de PII (CLAUDE.md, Convencoes).
  metadata      Json?
  occurredAt    DateTime  @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}

/// Transactional outbox (regra de arquitetura no 5): o evento e gravado na
/// MESMA transacao da mudanca de estado. Publicar antes de commitar produz
/// evento de algo que nunca aconteceu.
///
/// SEM `updatedAt`: o envelope e imutavel; o que muda e o estado de entrega.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  occurredAt    DateTime  @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

/// Recibo de consumo (regra de arquitetura no 4). A chave unica
/// (consumidor, evento) e o que torna reprocessar seguro -- nao a esperanca
/// de que o broker entregue uma vez so.
model InboxReceipt {
  id          String   @id @default(uuid()) @db.Uuid
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([consumer, eventId])
  @@map("inbox_receipts")
}

// ---------------------------------------------------------------------------
// Aluno
// ---------------------------------------------------------------------------

/// Aluno da academia.
///
/// A MATRICULA NUNCA DERIVA DO CPF (INV-009, INV-011, INV-012, `M1-BR-001`).
/// CPF ajuda a detectar duplicidade e identifica o aluno para a recepcao --
/// nao e identificador tecnico, nao vai para dispositivo, nao entra em URL.
///
/// O CPF e guardado em DOIS campos com finalidades distintas (ADR-034):
///
///   - `cpf` -- o numero completo, em claro. Decisao do PI: a importacao da
///     base legada (F47/ADR-033) traz 1.618 CPFs completos que a recepcao
///     precisa conferir no balcao e casar com o CSV da catraca.
///   - `cpfHash` -- SHA-256 do valor normalizado. E o que a busca por
///     duplicata compara; manter o indice em hash evita varredura de tabela
///     ao comparar texto claro.
model Student {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  /// `AP-{ano}-{8 digitos}`. IMUTAVEL apos a criacao (INV-010): nenhum caso
  /// de uso desta fatia a altera, e a unicidade sobrevive ao arquivamento
  /// (INV-015) porque soft delete nao remove a linha.
  membershipNumber String                @map("membership_number")
  fullName         String                @map("full_name")
  /// `@db.Date`: data de nascimento nao tem hora nem fuso. Gravar como
  /// timestamp faria 01/01 virar 31/12 na conversao de timezone.
  birthDate        DateTime              @map("birth_date") @db.Date
  /// Numero completo, em claro (ADR-034). Nunca em log (CLAUDE.md).
  cpf              String?
  cpfHash          String?               @map("cpf_hash")
  /// Texto livre e opcional. RG nao tem formato nacional unico -- cada
  /// estado emite o seu, e validar digito verificador aqui seria inventar
  /// regra que orgao nenhum garante.
  rg               String?
  registeredSex    StudentRegisteredSex? @map("registered_sex")
  leadSource       LeadSource?           @map("lead_source")
  /// UNIDADE DE ORIGEM -- onde o aluno se cadastrou e para onde a recepcao o
  /// conta. NAO E CONTROLE DE ACESSO: quem decide em qual unidade ele entra
  /// continua sendo o plano, por `PlanUnit` e `EntitlementUnitWindow`. Ler
  /// esta coluna numa decisao de acesso criaria a segunda fonte de verdade
  /// que a regra de arquitetura no 1 proibe -- ha teste que prova que nao
  /// acontece (`gym-unit-nao-decide-acesso.spec.ts`).
  gymUnitId        String                @map("gym_unit_id") @db.Uuid
  /// Consultor responsavel (Espec 11). FK, nao texto livre: texto livre nao
  /// sobrevive a saida do funcionario.
  advisorUserId    String?               @map("advisor_user_id") @db.Uuid
  status           StudentStatus         @default(LEAD)
  /// POR QUE o aluno esta suspenso ou bloqueado (issue #241).
  ///
  /// Anulavel e LIMPO na volta para `ACTIVE`: motivo e do status VIGENTE,
  /// nao historico. Quem quer a sequencia le `StudentTimelineEvent`, que
  /// guarda cada transicao com o seu motivo e nao e reescrito.
  ///
  /// Mora na tabela, e nao so na auditoria, porque a GRID o exibe: pintar a
  /// lista de alunos a partir do `AuditLog` seria varrer o log a cada
  /// carregamento para responder algo que e estado corrente.
  statusReason     StudentStatusReason?  @map("status_reason")
  /// O caso concreto, em texto livre, ao lado da razao fechada. Opcional: a
  /// razao ja responde "por que"; isto responde "o que exatamente".
  statusReasonNote String?               @map("status_reason_note")
  /// Papel da pessoa (F48). Default `STUDENT` porque e o caso comum e
  /// porque as 1.926 linhas ja existentes precisam de um valor.
  profile          StudentProfile        @default(STUDENT)
  /// Preenchido no arquivamento. Soft delete (INV-013): preserva historico
  /// legal e operacional em vez de apagar.
  archivedAt       DateTime?             @map("archived_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  /// Trava otimista. Comando concorrente que leu a versao antiga falha em
  /// vez de sobrescrever decisao que nao viu.
  version          Int                   @default(0)

  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// `RESTRICT`: apagar unidade que ainda tem aluno falha, em vez de deixar
  /// aluno orfao ou apagado junto.
  gymUnit            GymUnit                   @relation(fields: [gymUnitId], references: [id], onDelete: Restrict)
  /// `SET NULL`: o aluno continua existindo depois que o consultor sai.
  advisor            User?                     @relation("StudentAdvisor", fields: [advisorUserId], references: [id], onDelete: SetNull)
  contacts           StudentContact[]
  addresses          StudentAddress[]
  subscriptions      Subscription[]
  paymentMethods     PaymentMethod[]
  financialOverrides FinancialAccessOverride[]
  entitlements       Entitlement[]
  timelineEvents     StudentTimelineEvent[]

  consentRecords      ConsentRecord[]
  bodyAssessments     BodyAssessment[]
  healthContext       StudentHealthContext[]
  healthGoals         HealthGoal[]
  attendanceSessions  StudentAttendanceSession[]
  aiAnalyses          AiAnalysis[]
  modalities          StudentModality[]
  assessmentImports   AssessmentImport[]
  biometricIdentities BiometricIdentity[]
  deviceUsers         DeviceUser[]
  credentials         StudentCredential[]
  kioskSessions       KioskSession[]

  administrativeBlocks  AdministrativeBlock[]
  accessEvents          AccessEvent[]
  manualAccessOverrides ManualAccessOverride[]
  familyMemberships     FamilyMember[]
  invoices              Invoice[]
  accountCredits        AccountCredit[]
  publicProfile         PublicProfile?

  xpLedgerEntries                  XpLedgerEntry[]
  xpBalances                       StudentXpBalance[]
  achievements                     StudentAchievement[]
  rankingEntries                   RankingEntry[]
  challengeParticipations          ChallengeParticipant[]
  challengeNotices                 ChallengeNotice[]
  engagementDisputes               EngagementDispute[]
  featureSnapshots                 StudentFeatureSnapshot[]
  retentionScores                  RetentionScore[]
  retentionScoreSkips              RetentionScoreSkip[]
  retentionSuppressions            RetentionSuppression[]
  retentionTasks                   RetentionTask[]
  retentionExperimentAssignments   RetentionExperimentAssignment[]
  retentionExperimentAdverseEvents RetentionExperimentAdverseEvent[]

  @@unique([tenantId, membershipNumber])
  @@index([tenantId, gymUnitId])
  @@index([tenantId, status])
  @@index([tenantId, cpfHash])
  @@index([tenantId, fullName])
  @@map("students")
}

/// Contato do aluno. `value` guarda a forma NORMALIZADA (e-mail em
/// minusculas, telefone so com digitos) -- e o que a deteccao de duplicata
/// compara. Sem normalizar, "(41) 99999-0000" e "41999990000" seriam pessoas
/// diferentes.
model StudentContact {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  studentId    String             @map("student_id") @db.Uuid
  type         StudentContactType
  value        String
  /// Nome de quem atende. So `EMERGENCY` preenche -- nos demais tipos o
  /// contato E o aluno, e repetir o nome dele em cada linha nao informa.
  label        String?
  /// Parentesco ou vinculo ("conjuge", "mae", "vizinha"). Texto livre: a
  /// lista de vinculos possiveis nao fecha, e enum que nao fecha vira
  /// `OUTRO` em metade das linhas.
  relationship String?
  isPrimary    Boolean            @default(false) @map("is_primary")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, value])
  @@index([studentId])
  @@map("student_contacts")
}

/// Identificador que o equipamento usa para reconhecer a pessoa (F48).
///
/// Tabela propria, e nao coluna em `Student`, por dois motivos que a coluna
/// nao daria: uma pessoa troca de cartao e re-enrola a face (varias
/// credenciais ao longo do tempo), e o numero precisa ser unico dentro do
/// tenant -- garantia que so o banco entrega.
model StudentCredential {
  id         String                @id @default(uuid()) @db.Uuid
  tenantId   String                @map("tenant_id") @db.Uuid
  studentId  String                @map("student_id") @db.Uuid
  kind       StudentCredentialKind
  /// O numero como o leitor o conhece. Texto, nao inteiro: e chave externa
  /// de equipamento, e zero a esquerda importa.
  externalId String                @map("external_id")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Dois alunos nao dividem o mesmo numero: seria a catraca abrindo para a
  /// pessoa errada.
  @@unique([tenantId, kind, externalId])
  @@index([tenantId, studentId])
  @@map("student_credentials")
}

model StudentAddress {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  postalCode String   @map("postal_code")
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_addresses")
}

/// Contador de matricula, uma linha por tenant.
///
/// EXISTE PARA SER TRAVADO. A geracao roda dentro da transacao de criacao
/// com `SELECT ... FOR UPDATE` nesta linha: duas recepcionistas cadastrando
/// ao mesmo tempo serializam aqui, e nao na tabela `students`.
///
/// Alternativas descartadas: `COUNT(*)` (reusa numero apos arquivamento),
/// fragmento de UUID (colide e nao e sequencial), sequence do Postgres
/// (global, vazaria volume de um tenant para outro).
model StudentSequence {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  /// Proximo numero a emitir. Nunca decrementa, nem quando um aluno e
  /// arquivado -- reaproveitar matricula quebraria INV-010.
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("student_sequences")
}

/// Timeline administrativa do aluno.
///
/// SEM `updatedAt`, pelo mesmo motivo do `AuditLog`: registro de historico
/// que muda nao e historico. `payload` chega ja mascarado da aplicacao --
/// nunca CPF completo, nunca template biometrico (INV-022).
model StudentTimelineEvent {
  id            String                   @id @default(uuid()) @db.Uuid
  tenantId      String                   @map("tenant_id") @db.Uuid
  studentId     String                   @map("student_id") @db.Uuid
  type          StudentTimelineEventType
  actorType     ActorType                @map("actor_type")
  actorId       String?                  @map("actor_id") @db.Uuid
  correlationId String                   @map("correlation_id")
  payload       Json?
  occurredAt    DateTime                 @default(now()) @map("occurred_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Ordenacao do cursor: `(occurredAt, id)`. O `id` desempata eventos no
  /// mesmo instante -- sem ele, paginacao por cursor pula ou repete linha.
  @@index([tenantId, studentId, occurredAt, id])
  @@map("student_timeline_events")
}

// ---------------------------------------------------------------------------
// Plano, assinatura e entitlement
// ---------------------------------------------------------------------------

/// Plano comercial.
///
/// SO carrega o que `M1-FR-009` cobre: unidades, dias, horarios e validade.
/// As demais regras da Especificacao secao 34 (limite semanal, aulas
/// inclusas, convidados, fidelidade, multa) sao `[indefinido]` por INV-059 --
/// NAO inventar campo para elas aqui.
model Plan {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  name         String
  description  String?
  isActive     Boolean         @default(true) @map("is_active")
  /// Validade de VENDA do plano (ate quando pode ser contratado), diferente
  /// da vigencia da assinatura de um aluno.
  salesStartAt DateTime?       @map("sales_start_at")
  salesEndAt   DateTime?       @map("sales_end_at")
  /// Como o plano cobra (ADR-043, Decisao 2). `AVULSO` e o padrao porque e o
  /// que todo plano existente E -- migration que mudasse o comportamento de
  /// plano ja vendido cobraria aluno que nunca autorizou recorrencia.
  ///
  /// Plano `ASSINATURA` exige `PlanPrice` vigente: nao se assina o que nao tem
  /// preco. A regra e de aplicacao, nao de coluna -- a vigencia e uma LINHA em
  /// outra tabela, e nenhuma constraint de coluna alcanca isso.
  billingMode  PlanBillingMode @default(AVULSO) @map("billing_mode")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units         PlanUnit[]
  accessWindows PlanAccessWindow[]
  subscriptions Subscription[]
  prices        PlanPrice[]
  benefits      PlanBenefit[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("plans")
}

model PlanUnit {
  planId   String @map("plan_id") @db.Uuid
  /// F67 (ADR-054 §5): `tenant_id` proprio, e nao JOIN ate plans.
  /// A politica RLS le esta coluna -- politica por JOIN e lenta e fragil.
  tenantId String @map("tenant_id") @db.Uuid

  gymUnitId String @map("gym_unit_id") @db.Uuid

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([planId, gymUnitId])
  @@index([tenantId])
  @@map("plan_units")
}

/// Janela semanal de acesso, por unidade.
///
/// TABELA, NAO JSON. Regra de acesso enterrada em JSON nao validado e o que
/// o plano de apoio proibe explicitamente -- e o que o motor de decisao de
/// F9 vai precisar consultar por faixa.
///
/// Horario em MINUTOS DESDE A MEIA-NOITE LOCAL, nao string nem timestamp:
/// inteiro compara e ordena sem parsing, e a conversao para instante so
/// acontece na avaliacao de uma data concreta, com o timezone da unidade.
/// Virada de dia (22h-02h) entra como DUAS janelas, nunca como intervalo com
/// fim menor que o inicio.
model PlanAccessWindow {
  id       String @id @default(uuid()) @db.Uuid
  /// F67 (ADR-054 §5): `tenant_id` proprio, e nao JOIN ate plans.
  /// A politica RLS le esta coluna -- politica por JOIN e lenta e fragil.
  tenantId String @map("tenant_id") @db.Uuid

  planId      String @map("plan_id") @db.Uuid
  gymUnitId   String @map("gym_unit_id") @db.Uuid
  /// 0 = domingo ... 6 = sabado. Eixo do motor de decisao (#129).
  /// A faixa e travada por CHECK na migration `20260821100000_fix129_eixo_de_day_of_week`
  /// -- o Prisma nao modela CHECK, entao ele vive na migration e NAO sobrevive a um
  /// `db push` que recrie a tabela.
  dayOfWeek   Int    @map("day_of_week")
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([planId, gymUnitId, dayOfWeek])
  @@map("plan_access_windows")
}

/// Assinatura: o fato comercial.
///
/// A CATRACA NUNCA CONSULTA ESTA TABELA (INV-030, `M1-BR-003`, ADR-003). O
/// caminho de acesso le `Entitlement`, e so. Esta linha existe para a
/// recepcao e para derivar o direito -- nao para decidir passagem.
model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  studentId   String             @map("student_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  status      SubscriptionStatus @default(PENDING)
  startsAt    DateTime           @map("starts_at")
  /// Nulo = sem termino previsto. A expiracao vem de job, nao de ausencia
  /// de data.
  endsAt      DateTime?          @map("ends_at")
  /// Quem criou/alterou manualmente e por que. No MVP 1 toda mudanca de
  /// assinatura e manual (INV-061), entao razao e ator sao obrigatorios em
  /// cada comando -- e ficam aqui na ultima alteracao, alem da timeline.
  lastActorId String?            @map("last_actor_id") @db.Uuid
  lastReason  String?            @map("last_reason")

  /// Identificador da RECORRENCIA no provedor -- a fonte correta que o
  /// `CancelarRecorrenciaUseCase` esperava (ADR-043, Decisao 5).
  ///
  /// Ate 25/08/2026 este id vivia, por acidente, em
  /// `payment_attempts.external_payment_id`: a cobranca de invoice chamava
  /// `createTokenizedSubscription` e a coluna guardava id de assinatura. Aqui
  /// ele fica no lugar certo -- UMA recorrencia por assinatura do aluno,
  /// instalada na adesao e cancelada no cancelamento.
  ///
  /// Nulo em toda assinatura de plano AVULSO, e em assinatura de plano
  /// ASSINATURA que ainda nao aderiu: adesao e ato separado da criacao.
  externalSubscriptionId String? @map("external_subscription_id")

  /// Quando o aluno autorizou a cobranca recorrente. Nulo = nao autorizou.
  ///
  /// A adesao exige aceite EXPLICITO com valor, dia da cobranca e como
  /// cancelar na tela (SPEC-056 2.2). Sem registro do instante, "ele
  /// autorizou?" nao tem resposta -- e contestacao de debito recorrente e
  /// exatamente a disputa em que essa pergunta e feita.
  recurrenceConsentAt      DateTime? @map("recurrence_consent_at")
  /// Quem operou a adesao (recepcao). Nulo quando o proprio aluno aderir --
  /// caminho que nasce na F25/F52, nao aqui.
  recurrenceConsentActorId String?   @map("recurrence_consent_actor_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(0)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  entitlements Entitlement[]
  familyGroup  FamilyGroup?
  invoices     Invoice[]

  @@index([tenantId, studentId, status])
  /// UMA ASSINATURA VIGENTE POR ALUNO -- issue #272, regra confirmada pelo PI
  /// em 04/09/2026 ("1 aluno, 1 plano vigente mensal").
  ///
  /// O indice e PARCIAL (so `ACTIVE` e `PAST_DUE`) e por isso NAO cabe num
  /// `@@unique` do Prisma, que nao suporta `WHERE`: ele nasce a mao na
  /// migration `20260904180000_fix272_uma_assinatura_vigente_por_aluno`. Esta
  /// anotacao existe para quem ler o schema saber que a garantia EXISTE --
  /// sem ela, alguem passaria por aqui e concluiria que nada impede a
  /// duplicata.
  ///
  /// NO BANCO, e nao num `if` da aplicacao: import, tela e job de cobranca
  /// escrevem nesta tabela, e um `SELECT` antes do `INSERT` perde a corrida
  /// entre dois deles. Foi assim que 276 assinaturas duplicadas entraram em
  /// producao (617 vigentes para 341 alunos) -- o import criava a linha nova
  /// sem encerrar a anterior, e o painel somava as duas.
  ///
  /// `CANCELLED` e `EXPIRED` ficam FORA do indice de proposito: o aluno que
  /// sai e volta acumula assinaturas ao longo do tempo, e so uma vale agora.
  /// O JOB DE COBRANCA AUTOMATICA LE POR AQUI: assinaturas com recorrencia
  /// instalada, por tenant. Sem o indice o job varre a tabela inteira a cada
  /// execucao, e ele roda por agendador -- custo que so aparece com a base
  /// crescida, quando ja e tarde.
  @@index([tenantId, externalSubscriptionId])
  @@map("subscriptions")
}

/// Direito de acesso. O QUE A CATRACA CONSULTA.
///
/// Regra de arquitetura no 1: `Pagamento -> Invoice -> Subscription ->
/// Entitlement -> Access Decision Engine`. Esta e a ultima parada antes do
/// motor, e a primeira que o motor le.
///
/// `policySnapshot` e IMUTAVEL: copia das regras do plano no instante da
/// derivacao. Existe porque o plano pode mudar amanha, e o direito ja
/// concedido nao pode mudar junto sem alguem decidir isso. Sem o snapshot,
/// editar um plano reescreveria retroativamente quem podia entrar ontem.
model Entitlement {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  studentId      String            @map("student_id") @db.Uuid
  source         EntitlementSource
  /// Nulo quando a origem nao e assinatura (cortesia, visitante, ...).
  subscriptionId String?           @map("subscription_id") @db.Uuid
  status         EntitlementStatus @default(SCHEDULED)
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  /// Obrigatorios para cortesia (INV-063): razao e responsavel.
  grantedById    String?           @map("granted_by_id") @db.Uuid
  reason         String?
  /// Copia congelada das regras do plano. Nunca reescrito apos a criacao.
  policySnapshot Json              @map("policy_snapshot")
  suspendedAt    DateTime?         @map("suspended_at")
  revokedAt      DateTime?         @map("revoked_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  version        Int               @default(0)

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription Subscription?           @relation(fields: [subscriptionId], references: [id])
  unitWindows  EntitlementUnitWindow[]
  accessEvents AccessEvent[]

  /// Indice do caminho quente: o motor de F9 pergunta "que direito valido
  /// este aluno tem agora?".
  @@index([tenantId, studentId, status, startsAt, endsAt])
  @@map("entitlements")
}

/// Janela de acesso ja resolvida para o entitlement.
///
/// Duplica a forma de `PlanAccessWindow` de proposito: aquela pertence ao
/// plano e MUDA quando o plano muda; esta pertence ao direito concedido e
/// NAO muda. Ler a do plano no momento da decisao reintroduziria exatamente
/// a retroatividade que o snapshot existe para impedir.
model EntitlementUnitWindow {
  id       String @id @default(uuid()) @db.Uuid
  /// F67 (ADR-054 §5): `tenant_id` proprio, e nao JOIN ate entitlements.
  /// A politica RLS le esta coluna -- politica por JOIN e lenta e fragil.
  tenantId String @map("tenant_id") @db.Uuid

  entitlementId String @map("entitlement_id") @db.Uuid
  gymUnitId     String @map("gym_unit_id") @db.Uuid
  /// 0 = domingo ... 6 = sabado. Eixo do motor de decisao (#129).
  /// A faixa e travada por CHECK na migration `20260821100000_fix129_eixo_de_day_of_week`
  /// -- o Prisma nao modela CHECK, entao ele vive na migration e NAO sobrevive a um
  /// `db push` que recrie a tabela.
  dayOfWeek     Int    @map("day_of_week")
  startMinute   Int    @map("start_minute")
  endMinute     Int    @map("end_minute")

  entitlement Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entitlementId, gymUnitId, dayOfWeek])
  @@map("entitlement_unit_windows")
}

// ---------------------------------------------------------------------------
// Consentimento e biometria (F8)
//
// Base legal: CONSENTIMENTO ESPECIFICO E DESTACADO (LGPD art. 11, I), fixado
// no ADR-008. Legitimo interesse NAO e hipotese disponivel para dado
// sensivel -- o art. 11 e lista fechada.
//
// Em 04/08/2026 a ANPD suspendeu reconhecimento facial na rede estadual do
// PR por tres causas: falta de base legal, ausencia de comprovacao de
// seguranca e falha no controle de acesso as imagens. As tres tem contraparte
// aqui: ConsentRecord, ausencia de coluna de template e BiometricAccessLog.
// ---------------------------------------------------------------------------

/// Versao publicada de um termo de consentimento.
///
/// IMUTAVEL depois de publicado. Corrigir texto exige VERSAO NOVA, nunca
/// UPDATE: o registro de consentimento aponta para esta linha, e reescrever
/// o texto mudaria retroativamente aquilo que a pessoa aceitou.
///
/// `contentSha256` e o que torna a prova verificavel -- guardar so a versao
/// deixaria "v2" significar uma coisa hoje e outra depois de um deploy.
model ConsentDocument {
  id            String              @id @default(uuid()) @db.Uuid
  /// `null` = documento global do ArenaHub, valido para todo tenant que nao
  /// publicou o proprio. A academia e controladora (ADR-008) e pode
  /// publicar o seu.
  tenantId      String?             @map("tenant_id") @db.Uuid
  type          ConsentDocumentType
  /// Inteiro crescente por (escopo, tipo). Sem semver: termo juridico nao
  /// tem "correcao compativel".
  version       Int
  /// Finalidade especifica (art. 11, I exige "para finalidades especificas").
  /// Texto em pt-BR, exibido ao titular.
  purpose       String
  content       String
  /// SHA-256 do `content`, em hex minusculo.
  contentSha256 String              @map("content_sha256")
  effectiveFrom DateTime            @map("effective_from")
  /// Preenchido quando uma versao nova entra. Documento aposentado continua
  /// existindo: ha consentimento vivo apontando para ele.
  retiredAt     DateTime?           @map("retired_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant  Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records ConsentRecord[]

  @@unique([tenantId, type, version])
  @@index([tenantId, type, effectiveFrom])
  @@map("consent_documents")
}

/// Decisao do titular sobre um documento. IMUTAVEL (INV-021).
///
/// Nunca sofre UPDATE de decisao: revogar CRIA linha nova apontando para a
/// anterior em `revokesRecordId`. Reescrever a decisao apagaria a prova de
/// que houve consentimento no periodo em que a biometria funcionou -- que e
/// exatamente o que a ANPD pede para ver.
///
/// Guarda ator, IP e user-agent porque o INV-021 exige, e porque "quem
/// coletou" e a primeira pergunta numa fiscalizacao.
model ConsentRecord {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  studentId        String             @map("student_id") @db.Uuid
  documentId       String             @map("document_id") @db.Uuid
  decision         ConsentDecision
  /// Quem prestou: o proprio aluno ou responsavel legal (INV-143).
  subjectKind      ConsentSubjectKind @map("subject_kind")
  /// Nome do responsavel legal, quando `subjectKind = LEGAL_GUARDIAN`.
  /// INV-143 exige vinculo COMPROVAVEL -- nome e grau de parentesco sao o
  /// minimo; o documento comprobatorio entra em `evidence`.
  guardianName     String?            @map("guardian_name")
  guardianRelation String?            @map("guardian_relation")
  /// Idade do aluno na data da decisao, em anos completos.
  ///
  /// Congelada de proposito: saber que a pessoa tinha 16 quando o
  /// responsavel consentiu e o que dispara a revalidacao na virada dos 18
  /// (INV-143). Recalcular pela data de nascimento diria a idade de HOJE,
  /// nao a da decisao.
  subjectAgeYears  Int                @map("subject_age_years")
  /// De quem e esta assinatura (F21).
  ///
  /// `STUDENT_CONSENT` por padrao: toda linha anterior a F21 e consentimento
  /// do titular, e o default preserva o significado do historico sem
  /// reescrever linha nenhuma.
  signerRole       ConsentSignerRole  @default(STUDENT_CONSENT) @map("signer_role")
  /// Ator interno que registrou (recepcao). Nao e o titular.
  actorId          String?            @map("actor_id") @db.Uuid
  actorIp          String?            @map("actor_ip")
  actorUserAgent   String?            @map("actor_user_agent")
  /// Evidencia adicional em JSON: canal, documento do responsavel, hash de
  /// assinatura. NUNCA imagem nem template.
  evidence         Json?
  occurredAt       DateTime           @map("occurred_at")
  /// Preenchido quando uma decisao posterior substitui esta.
  supersededAt     DateTime?          @map("superseded_at")
  /// Aponta para a decisao que esta linha revoga.
  revokesRecordId  String?            @map("revokes_record_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  document   ConsentDocument     @relation(fields: [documentId], references: [id])
  identities BiometricIdentity[]

  @@index([tenantId, studentId, occurredAt])
  @@index([tenantId, documentId])
  @@map("consent_records")
}

/// Identidade biometrica do aluno. Entidade SEPARADA do cadastro (INV-016).
///
/// NAO EXISTE COLUNA DE TEMPLATE NEM DE IMAGEM AQUI, e isso e requisito, nao
/// omissao (INV-020): o template vive no leitor, a imagem de cadastro vive
/// no object storage privado, e esta tabela guarda so a REFERENCIA
/// (`enrollmentObjectKey`). A nuvem nao acumula biometria bruta.
///
/// `enrollmentObjectKey` fica nulo apos o expurgo (INV-142) sem que a linha
/// morra: o historico de que houve identidade e o que a auditoria consulta.
model BiometricIdentity {
  id                  String                 @id @default(uuid()) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  studentId           String                 @map("student_id") @db.Uuid
  state               BiometricIdentityState @default(ACTIVE)
  /// Consentimento que autorizou esta identidade. Sem ele a identidade nao
  /// nasce (INV-017).
  consentRecordId     String                 @map("consent_record_id") @db.Uuid
  /// Chave no object storage privado. `null` depois do expurgo.
  enrollmentObjectKey String?                @map("enrollment_object_key")
  /// Instante em que o objeto de cadastro foi apagado do storage.
  /// Evidencia auditavel do expurgo (INV-142).
  enrollmentPurgedAt  DateTime?              @map("enrollment_purged_at")
  revokedAt           DateTime?              @map("revoked_at")
  revokedReason       String?                @map("revoked_reason")
  /// So quando TODOS os dispositivos-alvo confirmaram remocao (INV-027).
  deletedAt           DateTime?              @map("deleted_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  version             Int                    @default(0)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  consentRecord ConsentRecord   @relation(fields: [consentRecordId], references: [id])
  deviceUsers   DeviceUser[]
  syncJobs      DeviceSyncJob[]
  accessEvents  AccessEvent[]

  @@index([tenantId, studentId, state])
  @@index([tenantId, state])
  @@map("biometric_identities")
}

/// Registro de acesso a dado biometrico (ADR-008).
///
/// Existe porque a falha no controle de acesso as imagens foi uma das tres
/// causas da suspensao da ANPD no caso PR. Toda leitura de imagem de
/// cadastro ou de metadado de identidade passa por aqui.
///
/// NAO guarda o dado acessado -- guarda QUEM, QUANDO, O QUE e PARA QUE
/// (INV-022: template e imagem nunca aparecem em log).
model BiometricAccessLog {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  identityId    String                 @map("identity_id") @db.Uuid
  kind          BiometricAccessKind
  purpose       BiometricAccessPurpose
  /// Ator humano; nulo quando o acesso e de processo (sync, expurgo).
  actorId       String?                @map("actor_id") @db.Uuid
  /// `USER` ou `SYSTEM` -- o worker de sync tambem presta contas.
  actorType     ActorType              @map("actor_type")
  actorIp       String?                @map("actor_ip")
  correlationId String                 @map("correlation_id")
  occurredAt    DateTime               @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, identityId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("biometric_access_logs")
}

/// Politica de privacidade biometrica POR TENANT.
///
/// ADR-008 exige retencao e log expostos como PARAMETRO DO CLIENTE -- e o
/// que sustenta a posicao de operador (art. 39) contra reclassificacao pela
/// ANPD: quem decide o prazo e a academia controladora, nao nos.
///
/// INV-142: 30 dias e o PADRAO, nao a constante.
model TenantPrivacySettings {
  tenantId               String   @id @map("tenant_id") @db.Uuid
  /// Dias apos o encerramento do vinculo ate o expurgo do template e da
  /// imagem, no banco E nos leitores.
  purgeAfterDays         Int      @default(30) @map("purge_after_days")
  /// Retencao do log de acesso biometrico, em dias. Padrao 5 anos: prazo
  /// prescricional civil, com folga sobre a fiscalizacao.
  accessLogRetentionDays Int      @default(1825) @map("access_log_retention_days")
  /// Instrucoes documentadas do controlador (art. 39). Texto do contrato de
  /// tratamento vigente entre a academia e o ArenaHub.
  processingInstructions String?  @map("processing_instructions")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_privacy_settings")
}

// ---------------------------------------------------------------------------
// Edge, dispositivos e sincronizacao (F8)
//
// A nuvem e a fonte da verdade; o Edge e executor fisico (regra de
// arquitetura no 3). Comando e DURAVEL: o WebSocket so avisa que ha
// trabalho, e perder o socket nao perde comando.
// ---------------------------------------------------------------------------

/// PC da academia que fala com os leitores. Um por unidade, tipicamente.
model EdgeNode {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  /// Dado fisico: exige `gym_unit_id` (regra de arquitetura no 2).
  gymUnitId     String         @map("gym_unit_id") @db.Uuid
  /// Identificador estavel, escolhido na instalacao. Aparece no painel.
  code          String
  status        EdgeNodeStatus @default(ACTIVE)
  agentVersion  String?        @map("agent_version")
  lastHeartbeat DateTime?      @map("last_heartbeat")
  /// Diferenca observada entre o relogio do Edge e o da nuvem, em
  /// milissegundos. Assinatura HMAC tem janela de +-300 s: relogio torto e
  /// causa comum de 401 em campo, e sem esta coluna vira caca ao fantasma.
  clockOffsetMs Int?           @map("clock_offset_ms")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  devices      Device[]
  credentials  EdgeCredential[]
  commands     DeviceCommand[]
  nonces       ReplayNonce[]
  accessEvents AccessEvent[]

  @@unique([tenantId, code])
  @@index([tenantId, gymUnitId])
  @@map("edge_nodes")
}

/// Credencial HMAC do Edge.
///
/// O segredo e guardado CIFRADO (AES-256-GCM), como o segredo TOTP da F6.
/// Duas credenciais ativas convivem por ate 24 h para permitir rotacao sem
/// janela de indisponibilidade -- cada uma com `keyId` distinto.
model EdgeCredential {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  edgeNodeId      String    @map("edge_node_id") @db.Uuid
  /// Vai no header `X-Edge-Key-Id`. Publico: identifica, nao autentica.
  keyId           String    @unique @map("key_id")
  /// Segredo cifrado. NUNCA em log, nem mascarado (INV-022 por analogia).
  encryptedSecret String    @map("encrypted_secret")
  activeFrom      DateTime  @map("active_from")
  /// Fim da validade -- ADR-011: "a credencial de uso e de vida curta e o
  /// agente a renova sozinho".
  ///
  /// NULAVEL de proposito, e a nulabilidade tem significado: credencial
  /// criada antes desta coluna existir (F8) nao tem prazo, e invalida-la
  /// retroativamente derrubaria a catraca de quem ja esta instalado. Nulo
  /// significa "sem prazo", nao "prazo desconhecido".
  ///
  /// Acrescentada em F11 porque o alerta que o ADR-011 exige -- renovacao que
  /// falha em silencio -- nao tem sobre o que alertar sem um prazo. A
  /// rotacao automatica em si continua sendo trabalho do Edge, fora desta
  /// fatia: o que entra aqui e a capacidade de OBSERVAR que ela falhou.
  expiresAt       DateTime? @map("expires_at")
  /// Revogacao e IMEDIATA: preenchido, a credencial para de valer no ato.
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  @@index([tenantId, edgeNodeId, revokedAt])
  @@map("edge_credentials")
}

/// Nonce ja usado, para barrar repeticao de requisicao assinada.
///
/// A unicidade `(edgeNodeId, keyId, nonceHash)` e o mecanismo: o INSERT
/// acontece DENTRO da transacao da requisicao, e a violacao de unique e o
/// que responde `EDGE_REPLAY_DETECTED`. Verificar antes e inserir depois
/// deixaria a janela de corrida aberta entre as duas operacoes.
///
/// `expiresAt` permite limpeza: a janela de assinatura e de +-300 s, entao
/// nonce mais velho que isso nao serve para repetir nada.
model ReplayNonce {
  id       String @id @default(uuid()) @db.Uuid
  /// F67 (ADR-054 §5): `tenant_id` proprio, e nao JOIN ate edge_nodes.
  /// A politica RLS le esta coluna -- politica por JOIN e lenta e fragil.
  tenantId String @map("tenant_id") @db.Uuid

  edgeNodeId String   @map("edge_node_id") @db.Uuid
  keyId      String   @map("key_id")
  /// SHA-256 do nonce recebido. O valor bruto nao precisa ser guardado.
  nonceHash  String   @map("nonce_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([edgeNodeId, keyId, nonceHash])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("replay_nonces")
}

// ---------------------------------------------------------------------------
// Kiosk / totem de autoatendimento (F49)
// ---------------------------------------------------------------------------

enum KioskDeviceStatus {
  ACTIVE
  SUSPENDED
}

/// Totem de autoatendimento na recepcao. Dado fisico: exige `gym_unit_id`
/// (regra de arquitetura no 2).
model KioskDevice {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  gymUnitId         String            @map("gym_unit_id") @db.Uuid
  /// Identificador estavel escolhido na instalacao. Aparece no painel.
  code              String
  status            KioskDeviceStatus @default(ACTIVE)
  agentVersion      String?           @map("agent_version")
  lastHeartbeat     DateTime?         @map("last_heartbeat")
  /// Diferenca entre o relogio do totem e o da nuvem, em ms. Mesma razao do
  /// `EdgeNode`: relogio torto e causa comum de 401 em campo.
  clockOffsetMs     Int?              @map("clock_offset_ms")
  /// Versao de configuracao carregada no boot. O heartbeat compara com a
  /// publicada para decidir reinicio (ADR-042, Decisao 3 -- usado pela F50).
  bootConfigVersion Int?              @map("boot_config_version")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentials KioskCredential[]
  sessions    KioskSession[]

  @@unique([tenantId, code])
  @@index([tenantId, gymUnitId])
  @@map("kiosk_devices")
}

/// Credencial HMAC do totem. Espelha `EdgeCredential` -- mesmo mecanismo,
/// tabela propria: totem e Edge tem ciclo de vida e revogacao independentes.
model KioskCredential {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  kioskDeviceId   String    @map("kiosk_device_id") @db.Uuid
  /// Vai no header `X-Kiosk-Key-Id`. Publico: identifica, nao autentica.
  keyId           String    @unique @map("key_id")
  /// Segredo cifrado. NUNCA em log, nem mascarado.
  encryptedSecret String    @map("encrypted_secret")
  activeFrom      DateTime  @map("active_from")
  expiresAt       DateTime? @map("expires_at")
  /// Revogacao e IMEDIATA: preenchido, a credencial para de valer no ato.
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kioskDevice KioskDevice @relation(fields: [kioskDeviceId], references: [id], onDelete: Cascade)

  @@index([kioskDeviceId])
  @@map("kiosk_credentials")
}

/// Configuracao do totem em tres camadas (ADR-042, Decisao 8): a mais
/// especifica vence. A nulabilidade E a camada -- linha de tenant tem os dois
/// ids nulos; de unidade, so `kiosk_device_id` nulo; de dispositivo, ambos.
///
/// `version` e `published_at` nascem AQUI mesmo sem a F49 escrever: rascunho
/// e a versao sem `published_at`, e acrescentar coluna depois obrigaria
/// migracao de dado ja publicado.
model KioskConfiguration {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  gymUnitId     String?   @map("gym_unit_id") @db.Uuid
  kioskDeviceId String?   @map("kiosk_device_id") @db.Uuid
  version       Int
  publishedAt   DateTime? @map("published_at")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Rascunho unico por camada vive em INDICE PARCIAL com COALESCE
  /// (`kiosk_configurations_rascunho_unico`), escrito a mao na migracao:
  /// Prisma nao expressa `WHERE` nem `COALESCE` em @@unique.
  @@unique([tenantId, gymUnitId, kioskDeviceId, version])
  @@index([tenantId, publishedAt])
  @@map("kiosk_configurations")
}

/// Nonce de replay do totem. Tabela propria: `ReplayNonce` prende
/// `edge_node_id` com FK obrigatoria, e totem nao e Edge.
model KioskReplayNonce {
  id        String   @id @default(uuid()) @db.Uuid
  keyId     String   @map("key_id")
  /// SHA-256 do nonce recebido. O valor bruto nao precisa ser guardado.
  nonceHash String   @map("nonce_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([keyId, nonceHash])
  @@index([expiresAt])
  @@map("kiosk_replay_nonces")
}

/// Sessao efemera do aluno no totem.
///
/// Guarda o HASH do token, nao o token: sessao de 60 s que precisa morrer no
/// ato do "Encerrar" nao combina com JWT auto-contido, que seguiria valido
/// ate expirar mesmo depois de encerrada.
model KioskSession {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  kioskDeviceId String    @map("kiosk_device_id") @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  endedAt       DateTime? @map("ended_at")
  /// `MANUAL`, `TIMEOUT`, `ERROR` ou `FOCUS_LOST` (`M4-FR-019`).
  endedReason   String?   @map("ended_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kioskDevice KioskDevice @relation(fields: [kioskDeviceId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([kioskDeviceId, endedAt])
  @@map("kiosk_sessions")
}

/// Dispositivo fisico homologado (leitor facial, catraca).
///
/// `model` e `firmware` sao conferidos contra `supported-hardware.md`:
/// hardware desconhecido responde `DEVICE_UNSUPPORTED_HARDWARE`, nao 500.
model Device {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  gymUnitId     String       @map("gym_unit_id") @db.Uuid
  edgeNodeId    String?      @map("edge_node_id") @db.Uuid
  kind          DeviceKind
  model         String
  firmware      String?
  /// Serie do fabricante. Unico por tenant -- o mesmo leitor nao pode estar
  /// cadastrado duas vezes.
  serial        String
  status        DeviceStatus @default(ACTIVE)
  /// Capacidades declaradas (suporta exclusao individual, tamanho de foto).
  /// JSON porque varia por modelo e ainda esta sendo levantado na bancada.
  capabilities  Json?
  lastHeartbeat DateTime?    @map("last_heartbeat")
  lastSyncAt    DateTime?    @map("last_sync_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  edgeNode    EdgeNode?       @relation(fields: [edgeNodeId], references: [id], onDelete: SetNull)
  deviceUsers DeviceUser[]
  syncJobs    DeviceSyncJob[]

  accessEvents          AccessEvent[]
  manualAccessOverrides ManualAccessOverride[]

  @@unique([tenantId, serial])
  @@index([tenantId, gymUnitId, status])
  @@map("devices")
}

/// Mapeamento `Student.id -> DeviceUser -> enrollid` (INV-026).
///
/// `externalUserId` e gerado POR DISPOSITIVO e NAO DERIVA DO CPF (INV-012,
/// INV-025). Usar CPF como id de leitor exporia documento a quem tiver
/// acesso fisico ao equipamento.
model DeviceUser {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  deviceId       String          @map("device_id") @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  identityId     String          @map("identity_id") @db.Uuid
  /// O `enrollid` dentro do leitor.
  externalUserId String          @map("external_user_id")
  state          DeviceUserState @default(PENDING)
  syncedAt       DateTime?       @map("synced_at")
  removedAt      DateTime?       @map("removed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device   Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  student  Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  identity BiometricIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalUserId])
  @@unique([deviceId, identityId])
  @@index([tenantId, state])
  @@index([tenantId, studentId])
  @@map("device_users")
}

/// Uma operacao de sync por identidade E por dispositivo (INV-024).
///
/// `idempotencyKey` unica impede o mesmo trabalho logico de virar dois jobs
/// quando o outbox reprocessa (regra de arquitetura no 4).
model DeviceSyncJob {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  deviceId       String              @map("device_id") @db.Uuid
  identityId     String              @map("identity_id") @db.Uuid
  operation      DeviceSyncOperation
  state          DeviceSyncJobState  @default(PENDING)
  attempts       Int                 @default(0)
  /// Backoff de 1/2/3/5/8 minutos; DLQ na quinta tentativa.
  nextAttemptAt  DateTime?           @map("next_attempt_at")
  lastAttemptAt  DateTime?           @map("last_attempt_at")
  /// Codigo estavel do erro. Nunca a mensagem crua do SDK -- ela carrega
  /// caminho de arquivo e, as vezes, dado do usuario.
  errorCode      String?             @map("error_code")
  /// Chave logica do trabalho: `{identityId}:{deviceId}:{operation}`.
  idempotencyKey String              @unique @map("idempotency_key")
  correlationId  String              @map("correlation_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device   Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  identity BiometricIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([tenantId, state, nextAttemptAt])
  @@index([tenantId, identityId])
  @@index([tenantId, deviceId, state])
  @@map("device_sync_jobs")
}

/// Comando DURAVEL para o Edge executar.
///
/// Persistido antes de qualquer notificacao. O WebSocket avisa que ha
/// trabalho; se o socket cair, o comando continua aqui e o Edge o busca por
/// REST assinado. Notificacao perdida nao e comando perdido.
///
/// `sequence` da ordem estavel para o `GET /edge/commands?after=`.
model DeviceCommand {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  edgeNodeId     String             @map("edge_node_id") @db.Uuid
  /// Cresce por Edge. `BigInt` porque e contador perpetuo.
  sequence       BigInt
  type           String
  /// Instrucao para o adapter. NUNCA template bruto: leva a referencia do
  /// objeto e o `externalUserId`, e o Edge busca a imagem por URL assinada.
  payload        Json
  state          DeviceCommandState @default(AVAILABLE)
  availableAt    DateTime           @default(now()) @map("available_at")
  /// Lease de 60 s, renovavel. Comando arrendado que expira volta a
  /// AVAILABLE -- Edge que morreu no meio nao trava a fila.
  leasedAt       DateTime?          @map("leased_at")
  leaseExpiresAt DateTime?          @map("lease_expires_at")
  acknowledgedAt DateTime?          @map("acknowledged_at")
  /// Mesmo comando logico nunca vira dois (regra de arquitetura no 4).
  idempotencyKey String             @unique @map("idempotency_key")
  correlationId  String             @map("correlation_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  @@unique([edgeNodeId, sequence])
  @@index([edgeNodeId, state, sequence])
  @@map("device_commands")
}

// ---------------------------------------------------------------------------
// Decisao de acesso e passagem (F9)
//
// Regra de arquitetura no 1: a catraca NUNCA consulta assinatura nem invoice.
// A cadeia e `Pagamento -> Invoice -> Subscription -> Entitlement -> aqui`.
// Nada nesta secao referencia `Subscription`, e isso e deliberado.
//
// `M1-BR-009`: evento de passagem e IMUTAVEL. Correcao e registro NOVO
// vinculado ao original, nunca `UPDATE`. Por isso `AccessEvent` nao tem
// `updatedAt` -- a ausencia da coluna e a garantia, nao a disciplina de quem
// escreve o repositorio.
// ---------------------------------------------------------------------------

/// Politica de acesso vigente por unidade.
///
/// Guarda a VERSAO que o motor usou e a configuracao que valia. Sem isto,
/// reler uma decisao de seis meses atras aplicaria as regras de hoje, e a
/// pergunta "por que este aluno entrou naquele dia?" nao teria resposta
/// verificavel.
model AccessPolicy {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  gymUnitId String    @map("gym_unit_id") @db.Uuid
  /// Semver do motor puro (`POLICY_VERSION`). Mudanca de comportamento
  /// observavel exige numero novo.
  version   String
  /// Parametros da unidade. JSON porque a Slice 1.5 acrescenta validade e
  /// carencia de snapshot, ainda em ADR-007 (`aberto`).
  config    Json
  /// Vigencia. Politica nao se edita: publica-se outra e encerra-se esta.
  startsAt  DateTime  @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit GymUnit @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)

  @@index([tenantId, gymUnitId, startsAt])
  @@map("access_policies")
}

/// Bloqueio administrativo sobre um aluno.
///
/// E a alavanca que a operacao puxa para barrar ALGUEM AGORA, sem esperar
/// processo de cadastro nem mexer em entitlement. Por isso precede tudo na
/// ordem do motor (`M1-BR-006`) e por isso e uma tabela propria: mudar
/// `Student.status` seria efeito colateral em cascata, e o bloqueio precisa
/// ser reversivel sem reconstruir estado.
model AdministrativeBlock {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  reason     String
  /// Quem bloqueou. Bloqueio sem responsavel nao e auditavel.
  actorId    String    @map("actor_id") @db.Uuid
  startsAt   DateTime  @default(now()) @map("starts_at")
  /// Nulo = vigente por prazo indeterminado.
  endsAt     DateTime? @map("ends_at")
  /// Quem levantou o bloqueio, e quando.
  liftedAt   DateTime? @map("lifted_at")
  liftedById String?   @map("lifted_by_id") @db.Uuid
  liftReason String?   @map("lift_reason")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Caminho quente: "existe bloqueio vigente para este aluno agora?".
  @@index([tenantId, studentId, liftedAt, startsAt, endsAt])
  @@map("administrative_blocks")
}

/// Decisao de acesso -- FATO IMUTAVEL (`M1-BR-009`).
///
/// Nao ha `updatedAt` e nao ha caminho de `UPDATE` no repositorio. Corrigir
/// e criar `AccessEventCorrection` apontando para cá.
///
/// `studentId` e nulavel de proposito: o leitor reconhece alguem que a base
/// nao conhece, e esse `DENY` PRECISA ser registrado -- e justamente o caso
/// que interessa investigar. Evento sem aluno e evento valido.
model AccessEvent {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  gymUnitId String @map("gym_unit_id") @db.Uuid

  /// De onde veio. Nulavel porque override manual nasce na nuvem, sem Edge.
  edgeNodeId String? @map("edge_node_id") @db.Uuid
  deviceId   String? @map("device_id") @db.Uuid

  /// Nulo quando a identidade nao resolveu para nenhum aluno do tenant.
  studentId      String? @map("student_id") @db.Uuid
  /// Biometria usada. Nulo em override e em identidade desconhecida.
  identityId     String? @map("identity_id") @db.Uuid
  /// O `enrollid` que o leitor informou. Guardado mesmo sem aluno resolvido:
  /// e a unica pista de quem o equipamento viu.
  externalUserId String? @map("external_user_id")
  /// Id do reconhecimento no dispositivo, para casar log fisico com o nosso.
  recognitionId  String? @map("recognition_id")

  outcome       AccessOutcome
  reason        AccessReason
  /// Qual direito autorizou. Nulo em todo `DENY`.
  entitlementId String?       @map("entitlement_id") @db.Uuid
  /// Ate quando a decisao vale. Alimenta o cache do Edge na Slice 1.5.
  validUntil    DateTime?     @map("valid_until")
  policyVersion String        @map("policy_version")
  mode          AccessMode
  method        AccessMethod

  /// Quando o reconhecimento aconteceu no equipamento (relogio do device).
  recognizedAt DateTime? @map("recognized_at")
  /// Quando a decisao foi avaliada (relogio do servidor). Os DOIS existem
  /// porque relogio de catraca derrapa: guardar so um deles apagaria a
  /// evidencia de deriva justamente quando ela importa.
  occurredAt   DateTime  @map("occurred_at")
  receivedAt   DateTime  @default(now()) @map("received_at")

  correlationId  String @map("correlation_id")
  /// Dedupe do evento (ADR-006). Reprocessar e sempre seguro.
  idempotencyKey String @map("idempotency_key")

  /// Contexto congelado da decisao: entrada do motor, deriva de relogio,
  /// confianca do reconhecimento. NUNCA CPF, divida, foto ou template.
  detail Json

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit     GymUnit            @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)
  edgeNode    EdgeNode?          @relation(fields: [edgeNodeId], references: [id], onDelete: SetNull)
  device      Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  student     Student?           @relation(fields: [studentId], references: [id], onDelete: SetNull)
  identity    BiometricIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  entitlement Entitlement?       @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  passage                AccessPassage?
  override               ManualAccessOverride?
  corrections            AccessEventCorrection[] @relation("EventoCorrigido")
  correcoesQueEsteEvento AccessEventCorrection[] @relation("EventoCorretor")

  /// Idempotencia por ORIGEM, nao global: dois Edges podem gerar a mesma
  /// chave local sem colidir.
  ///
  /// ⚠️ ESTE INDICE NAO COBRE O OVERRIDE MANUAL. Override nasce na nuvem com
  /// `edgeNodeId` NULO, e em Postgres NULL nunca e igual a NULL -- duas
  /// linhas `(NULL, 'mesma-chave')` convivem aqui sem conflito.
  ///
  /// O buraco e fechado por um INDICE PARCIAL escrito a mao, em
  /// `migrations/20260816140000_access_event_cloud_idempotency`:
  ///
  ///     CREATE UNIQUE INDEX ... ON access_events (tenant_id, idempotency_key)
  ///       WHERE edge_node_id IS NULL;
  ///
  /// O Prisma nao modela indice parcial, entao ele NAO aparece neste schema e
  /// um `prisma migrate dev` futuro vai propor apaga-lo. NAO ACEITE: sem ele,
  /// clique duplo da recepcao gira a catraca duas vezes.
  @@unique([edgeNodeId, idempotencyKey])
  @@index([tenantId, gymUnitId, occurredAt])
  @@index([tenantId, studentId, occurredAt])
  @@index([tenantId, outcome, occurredAt])
  @@map("access_events")
}

/// Desfecho fisico da passagem -- registro TERMINAL, um por evento.
///
/// Separado do `AccessEvent` porque a decisao e o giro acontecem em momentos
/// diferentes e o evento e imutavel. Escrever o desfecho no proprio evento
/// exigiria `UPDATE` nele, que e exatamente o que `M1-BR-009` proibe.
model AccessPassage {
  id       String @id @default(uuid()) @db.Uuid
  /// F67 (ADR-054 §5): `tenant_id` proprio, e nao JOIN ate access_events.
  /// A politica RLS le esta coluna -- politica por JOIN e lenta e fragil.
  tenantId String @map("tenant_id") @db.Uuid

  accessEventId String       @unique @map("access_event_id") @db.Uuid
  state         PassageState
  /// Id do comando enviado ao equipamento. E a chave de idempotencia fisica:
  /// o mesmo `accessEventId` sempre produz o mesmo comando.
  commandId     String?      @map("command_id")
  /// Relogio do equipamento.
  reportedAt    DateTime?    @map("reported_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  accessEvent AccessEvent @relation(fields: [accessEventId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("access_passages")
}

/// Correcao de um evento -- `M1-BR-009`: "correcoes sao novos registros
/// vinculados".
///
/// O original NUNCA muda. Esta tabela liga o fato errado ao fato certo e diz
/// quem corrigiu e por que.
model AccessEventCorrection {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  /// O evento que estava errado.
  originalEventId   String   @map("original_event_id") @db.Uuid
  /// O evento novo que passa a valer. Nulo quando a correcao apenas anota
  /// que o original nao deve ser considerado.
  correctingEventId String?  @map("correcting_event_id") @db.Uuid
  reason            String
  actorId           String   @map("actor_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originalEvent   AccessEvent  @relation("EventoCorrigido", fields: [originalEventId], references: [id], onDelete: Cascade)
  correctingEvent AccessEvent? @relation("EventoCorretor", fields: [correctingEventId], references: [id], onDelete: SetNull)

  @@index([tenantId, originalEventId])
  @@map("access_event_corrections")
}

/// Liberacao manual pela recepcao -- `M1-FR-023`, `M1-BR-007`.
///
/// `M1-BR-007`: override NUNCA altera assinatura ou entitlement em silencio.
/// Por isso esta tabela nao tem nenhuma coluna que aponte para eles: nao ha
/// como escrever o codigo errado sem antes alterar o schema.
///
/// `visitorDescription` cobre quem nao e aluno. Minimizado por LGPD: nome e
/// motivo bastam para a auditoria; documento nao entra.
/// Liberacao financeira excepcional -- F15, Slice 2.4: "override financeiro
/// excepcional auditado e com expiracao".
///
/// NAO E O MESMO QUE `ManualAccessOverride` (F9), e a diferenca importa:
///
/// - o da F9 e por PASSAGEM -- amarrado a um `accessEventId`, a recepcao abre
///   a catraca para a pessoa que esta na frente dela, uma vez;
/// - este e por PERIODO -- vale para toda tentativa ate expirar, e existe
///   para o caso "o aluno jura que pagou, o PIX ainda nao caiu".
///
/// Reusar o da F9 obrigaria a recepcao a repetir a liberacao a cada entrada
/// durante tres dias, o que na pratica vira ninguem conferir mais nada.
///
/// EXPIRA SOZINHO, e isso e o ponto. Liberacao sem prazo vira permanente por
/// esquecimento -- e a Slice 2.4 pede "com expiracao" justamente por isso.
model FinancialAccessOverride {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  /// Por que a recepcao liberou. Obrigatoria: sem motivo, a auditoria nao
  /// explica nada depois -- mesmo criterio do pagamento manual (ADR-027).
  reason String

  /// Quando a liberacao para de valer. O motor compara com o instante da
  /// tentativa, entao nao ha job para "desligar" nada.
  expiresAt DateTime @map("expires_at")

  /// Quem liberou. `User` e global (o vinculo mora em `TenantMembership`),
  /// e por isso a FK nao carrega tenant -- quem confere e o caso de uso.
  actorId String @map("actor_id") @db.Uuid

  /// Revogacao manual antes do prazo, quando a recepcao percebe o engano.
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// A consulta do motor: "ha liberacao viva para este aluno agora?".
  /// `map` explicito porque a migration da F15 criou o indice com este nome.
  /// Sem ele, o Prisma pede um RENAME em toda migration seguinte -- drift que
  /// nao muda nada e polui o diff de quem vier depois.
  @@index([tenantId, studentId, expiresAt], map: "financial_access_overrides_tenant_student_expires_idx")
  @@map("financial_access_overrides")
}

model ManualAccessOverride {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  gymUnitId          String   @map("gym_unit_id") @db.Uuid
  /// Um dos dois esta presente -- aluno conhecido OU visitante descrito.
  studentId          String?  @map("student_id") @db.Uuid
  visitorDescription String?  @map("visitor_description")
  /// Catraca alvo.
  deviceId           String   @map("device_id") @db.Uuid
  /// Minimo de 10 caracteres, validado no boundary. "ok" nao e motivo.
  reason             String
  actorId            String   @map("actor_id") @db.Uuid
  /// O evento que esta liberacao gerou. Um override, um evento.
  accessEventId      String   @unique @map("access_event_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit     GymUnit     @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)
  student     Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  device      Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  accessEvent AccessEvent @relation(fields: [accessEventId], references: [id], onDelete: Cascade)

  @@index([tenantId, gymUnitId, createdAt])
  @@map("manual_access_overrides")
}

// ---------------------------------------------------------------------------
// Operacao (F11)
//
// INV-146 (ADR-011): a ausencia do Edge e ALERTA OPERACIONAL OBRIGATORIO, nao
// linha de log. Sem operacao offline (ADR-012), Edge fora significa catraca
// parada -- a operacao precisa saber no minuto em que acontece.
// ---------------------------------------------------------------------------

/// Estado do alerta no tempo.
///
/// `ACKNOWLEDGED` existe separado de `RESOLVED` porque significam coisas
/// diferentes: reconhecer e "estou vendo, estou indo"; resolver e "a condicao
/// acabou". Confundir os dois deixaria o painel limpo com a catraca ainda
/// parada.
enum OperationalAlertState {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@map("operational_alert_state")
}

enum OperationalAlertSeverity {
  CRITICAL
  WARNING
  INFO

  @@map("operational_alert_severity")
}

/// Alerta operacional -- `M1-FR-030`, `M1-AC-011`.
///
/// A CHAVE DESTE MODELO E `fingerprint`. Uma condicao que persiste ATUALIZA a
/// linha existente; nao cria outra. Sem isso, um Edge fora do ar por uma noite
/// geraria ~960 linhas (avaliacao a cada 30 s x 8 h) e o painel ficaria
/// ilegivel exatamente quando mais precisa ser lido.
///
/// `impact` e `recommendedAction` sao COLUNAS, nao derivacao de UI: o alerta
/// e lido por quem esta na recepcao com uma pessoa esperando, e "EDGE_OFFLINE"
/// sozinho nao diz se e para ligar para o TI ou liberar manualmente.
model OperationalAlert {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  /// Nulo em alerta que nao pertence a uma unidade especifica.
  gymUnitId String? @map("gym_unit_id") @db.Uuid

  /// `(tenant, unidade, recurso, recursoId, codigo)` -- ver `alert-rules.ts`.
  fingerprint String @unique

  code     String
  severity OperationalAlertSeverity
  state    OperationalAlertState    @default(OPEN)

  /// Tipo e id do recurso afetado (EDGE, DEVICE, SYNC, QUEUE).
  resource   String
  resourceId String @map("resource_id")

  /// Texto em pt-BR, pronto para a tela.
  impact            String
  recommendedAction String @map("recommended_action")

  /// Numeros que sustentam o alerta. NUNCA PII -- o painel e lido por quem
  /// nao deveria ver dado de aluno para consertar um cabo de rede.
  evidence Json

  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  /// Quem reconheceu, e quando. Reconhecer NAO resolve.
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit GymUnit? @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)

  /// Caminho quente do painel: "o que esta aberto nesta unidade agora?".
  @@index([tenantId, state, severity, lastSeenAt])
  @@index([tenantId, gymUnitId, state])
  @@map("operational_alerts")
}

/// Estado de uma exportacao.
enum DataExportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED

  @@map("data_export_status")
}

/// Exportacao assincrona de eventos -- `M1-NFR-009`.
///
/// ASSINCRONA POR EXIGENCIA: "exportacoes grandes sao assincronas e nao
/// bloqueiam a API". Uma exportacao de 100 mil eventos numa requisicao HTTP
/// deixaria a operacao esperando -- e a operacao esta com uma pessoa parada
/// na catraca.
///
/// O arquivo vai para storage PRIVADO. `objectKey` e a referencia; a URL de
/// download e assinada e curta, gerada na hora do pedido, e a autorizacao e
/// reconferida ali -- quem perdeu a permissao entre pedir e baixar nao baixa.
model DataExportJob {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  type        String
  status      DataExportStatus @default(PENDING)

  /// Filtros normalizados. Ficam guardados para a auditoria responder "o que
  /// exatamente essa pessoa levou embora?".
  filters Json

  /// Linhas escritas ate agora. Alimenta o progresso na tela.
  rowCount Int @default(0) @map("row_count")

  objectKey String? @map("object_key")
  /// Codigo estavel do erro. Nunca a mensagem crua.
  errorCode String? @map("error_code")

  /// Depois disto o objeto e apagado pelo expurgo.
  expiresAt   DateTime? @map("expires_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// Dedupe: clique duplo no botao de exportar nao gera dois arquivos.
  idempotencyKey String @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, requesterId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@map("data_export_jobs")
}

// ---------------------------------------------------------------------------
// FINANCEIRO -- MVP 2, Slice 2.1 (F12)
//
// Regra de arquitetura no 1: `Pagamento -> Invoice -> Subscription ->
// Entitlement -> Access Decision Engine`. NADA aqui e consultado pela
// catraca. O financeiro move entitlement por evento, nunca por leitura
// direta.
//
// INV-065 / `M2-BR-001`: dinheiro e INTEIRO na menor unidade monetaria.
// `Int` em centavos, nunca `Float`, nunca `Decimal` -- centavo nao tem
// fracao, e float em dinheiro e o bug que so aparece na conciliacao.
//
// Sem `gym_unit_id` em nenhuma tabela financeira: pagamento nao e dado
// fisico (`CLAUDE.md`, regra de arquitetura 2, e ADR-027).
// ---------------------------------------------------------------------------

/// Status do beneficio no plano.
///
/// NAO e booleano porque o encarte da Arena Positiva ja imprimiu o
/// meio-termo: "Teste de ECG -- em avaliacao".
enum PlanBenefitStatus {
  INCLUDED
  UNDER_REVIEW
}

/// Preco do plano, COM VIGENCIA (decisao do PI em 18/08/2026).
///
/// Reajuste NAO reescreve o catalogo: entra linha nova com `validFrom`
/// proprio. Preserva historico, permite reajuste agendado, e a invoice ja
/// aberta nunca muda de valor (INV-068) porque copia o valor na abertura.
model PlanPrice {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  /// Centavos. INV-065.
  amountMinor Int      @map("amount_minor")
  currency    String   @default("BRL")
  /// Inclusivo: preco que vale a partir de 01/06 ja vale as 00:00 de 01/06.
  validFrom   DateTime @map("valid_from")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, validFrom])
  @@index([tenantId, planId, validFrom])
  @@map("plan_prices")
}

/// Beneficio incluso no plano -- TABELA, NAO TEXTO.
///
/// Decisao do PI em 18/08/2026, a partir dos encartes: o mesmo item
/// ("Bioimpedancia") aparece nos dois programas com periodicidade
/// DIFERENTE -- 30 dias no de adultos e idosos, 60 no de protocolos
/// especificos. Isso e regra que o MVP 3 vai ler para saber quando a
/// proxima avaliacao vence; em `description` viraria prosa inconsultavel.
model PlanBenefit {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  planId    String            @map("plan_id") @db.Uuid
  item      String
  status    PlanBenefitStatus @default(INCLUDED)
  /// Periodicidade em dias. Nulo = beneficio sem recorrencia.
  everyDays Int?              @map("every_days")
  detail    String?
  /// Ordem de exibicao, para a tela espelhar o encarte impresso.
  position  Int               @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId, planId, position])
  @@map("plan_benefits")
}

/// Papel no grupo familiar.
///
/// O titular responde pela cobranca; o dependente tem direito de acesso e
/// nao tem invoice. Sem este campo, "quem paga" so se descobriria por
/// convencao.
enum FamilyMemberRole {
  HOLDER
  DEPENDENT
}

/// Grupo familiar: UMA assinatura, UMA invoice, N direitos de acesso.
///
/// POR QUE ISSO NAO MEXE NO MOTOR DE ACESSO. `Entitlement` ja tem
/// `student_id` PROPRIO e `subscription_id` NULAVEL: F9 sempre leu o direito
/// PELO ALUNO, nunca pela assinatura. O plano familiar muda so a
/// cardinalidade da derivacao, de 1:1 para 1:N -- `Subscription.student_id`
/// continua sendo o titular, e nada do MVP 1 precisou ser reescrito.
model FamilyGroup {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  subscriptionId String   @unique @map("subscription_id") @db.Uuid
  /// Limite de membros do plano. 3 no plano familiar da Arena Positiva.
  memberLimit    Int      @map("member_limit")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  members      FamilyMember[]

  @@index([tenantId])
  @@map("family_groups")
}

model FamilyMember {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  groupId   String           @map("group_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  role      FamilyMemberRole @default(DEPENDENT)
  joinedAt  DateTime         @default(now()) @map("joined_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group   FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Mesmo aluno nao entra duas vezes no mesmo grupo.
  @@unique([groupId, studentId])
  @@index([tenantId, studentId])
  @@map("family_members")
}

/// Configuracao financeira por tenant (`M2-FR-001`).
///
/// A ancora de bloqueio e CONFIGURAVEL (ADR-019, INV-144), com padrao no
/// primeiro instante de `due_date + grace_period`, no timezone da unidade,
/// sem fallback para o tenant e sem adiamento por feriado.
/// Como se conta o instante de bloqueio por inadimplencia -- ADR-019.
enum BlockAnchor {
  /// Primeiro instante de `due_at + grace_days`, no fuso da UNIDADE.
  /// Vencimento 10/08 com carencia 3 bloqueia em 13/08 as 00:00 locais.
  DUE_PLUS_GRACE

  @@map("block_anchor")
}

model BillingSettings {
  tenantId        String      @id @map("tenant_id") @db.Uuid
  currency        String      @default("BRL")
  /// Dia do mes do vencimento (1-28). Limitado a 28 para existir em
  /// fevereiro sem regra de excecao.
  dueDay          Int         @map("due_day")
  /// Dias de carencia depois do vencimento antes do bloqueio.
  graceDays       Int         @default(0) @map("grace_days")
  /// Dias apos o vencimento em que cada tentativa de cobranca acontece.
  ///
  /// O TAMANHO DA LISTA E O MAXIMO DE TENTATIVAS -- nao existe um segundo
  /// campo `maxTentativas` que possa discordar dela. Lista vazia desliga a
  /// cobranca automatica.
  ///
  /// Padrao `[0, 3, 7]` decidido pelo PI em 19/08/2026. Por tenant para que
  /// uma academia ajuste sem deploy.
  retryOffsetDays Int[]       @default([0, 3, 7]) @map("retry_offset_days")
  /// Ancora do bloqueio por inadimplencia -- ADR-019 2: "nao e constante, e
  /// CONFIGURACAO". O PI muda por academia sem tocar em codigo; regra
  /// comercial que vive dentro de um `if` e regra que ninguem encontra
  /// depois.
  ///
  /// Ha um valor so hoje, e isso e deliberado: uma segunda politica (adiar
  /// por feriado, por exemplo) entra como valor NOVO, nao como excecao
  /// escondida no meio do job.
  blockAnchor     BlockAnchor @default(DUE_PLUS_GRACE) @map("block_anchor")

  /// O que o estorno faz com o acesso. `M2-COMPLIANCE-01`, decidido pelo PI
  /// em 19/08/2026: mantem ate o fim do periodo pago.
  ///
  /// Por tenant, como a ancora de bloqueio e pelo mesmo motivo (ADR-019): e
  /// regra COMERCIAL, e regra comercial que vive dentro de um `if` e regra
  /// que ninguem encontra depois.
  refundAccessPolicy RefundAccessPolicy @default(KEEP_UNTIL_PERIOD_END) @map("refund_access_policy")

  /// Teto do estorno, em centavos, por operacao. Nulo = sem teto.
  ///
  /// RECUSA, NAO APROVA: acima do teto a operacao e barrada com erro de
  /// dominio. Nao existe papel de aprovador no MVP 2, e inventar uma fila de
  /// aprovacao que ninguem opera produziria estorno travado para sempre.
  refundLimitMinor Int? @map("refund_limit_minor")

  /// Teto do pagamento manual, em centavos. Nulo = sem teto. INV-072.
  manualPaymentLimitMinor Int? @map("manual_payment_limit_minor")

  /// Teto do desconto, em centavos. Nulo = sem teto.
  discountLimitMinor Int? @map("discount_limit_minor")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("billing_settings")
}

/// `CONVENTION.md` 3.4. `PAID` nunca volta a `OPEN` (INV-069).
enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

/// Como o dinheiro foi reconhecido.
///
/// `MANUAL` e o que faz a Slice 2.1 fechar SEM adapter nenhum (ADR-027):
/// dinheiro ou transferencia reconhecidos na recepcao. Os demais chegam com
/// o provedor homologado, na Slice 2.2.
/// Estado de um metodo de pagamento tokenizado.
///
/// `EXPIRED` NAO e derivado da data de validade em consulta: o cartao pode
/// ser recusado por expiracao antes do mes gravado (reemissao, bloqueio do
/// emissor) e continuar valendo depois dele (renovacao automatica pela
/// bandeira, que mantem o token). Quem manda e a resposta do provedor.
enum PaymentMethodStatus {
  ACTIVE
  EXPIRED
  REMOVED

  @@map("payment_method_status")
}

/// Metodo de pagamento tokenizado do aluno. `MVP-02` 7, Slice 2.3.
///
/// O QUE ESTA TABELA NAO TEM, E NUNCA PODE TER (INV-098): numero do cartao,
/// PAN, CVV, trilha. A tokenizacao e HOSPEDADA -- o dado vai do navegador do
/// aluno direto para o provedor, e o backend recebe so o token. Coluna de PAN
/// aqui nao seria "campo faltando": seria o ArenaHub entrando no escopo do
/// PCI DSS.
///
/// A Getnet expoe DOIS caminhos de tokenizacao e so um satisfaz o INV-098 --
/// `POST /v1/tokens/card` chamado pelo backend recebe `card_number` cru.
/// Vale exclusivamente o caminho do cliente (Get Checkout / iframe). Ver
/// ADR-032.
///
/// `brand`, `last4`, `expMonth` e `expYear` sao o que a bandeira permite
/// exibir, e existem por uma razao operacional: sem eles a recepcao nao tem
/// como dizer QUAL cartao falhou quando o aluno tem dois.
model PaymentMethod {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  /// Slug do provedor que guarda o token. Hoje `getnet` (ADR-032).
  provider        String
  /// Identificador do token NO PROVEDOR. Nao e o cartao -- e a referencia a
  /// ele no cofre do provedor, inutil fora dali.
  externalTokenId String @map("external_token_id")

  /// Bandeira, como o provedor devolveu. String e nao enum: bandeira nova
  /// nao deve exigir migration.
  brand    String?
  /// Ultimos quatro digitos. E o maximo que a bandeira permite exibir.
  last4    String? @db.VarChar(4)
  expMonth Int?    @map("exp_month")
  expYear  Int?    @map("exp_year")

  status PaymentMethodStatus @default(ACTIVE)

  /// O metodo usado na cobranca recorrente quando o aluno nao escolhe outro.
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// O token e unico no provedor: reenviar o mesmo cartao devolve o mesmo
  /// token, e sem esta chave o aluno acumularia metodos duplicados a cada
  /// tentativa de cadastro interrompida.
  @@unique([provider, externalTokenId])
  /// UM metodo padrao ATIVO por aluno -- indice PARCIAL, declarado na
  /// migration porque o Prisma nao modela unicidade condicional. Sem ele
  /// "qual cartao cobrar?" teria duas respostas e a escolha cairia na ordem
  /// de insercao, o mesmo defeito que `provider_accounts.capability` veio
  /// consertar. A garantia mora em
  /// `payment_methods_tenant_id_student_id_default_key`.
  @@index([tenantId, studentId, status])
  @@map("payment_methods")
}

enum PaymentMethodKind {
  MANUAL
  PIX
  CARD
}

/// `CONVENTION.md` 3.5, lado do `Payment` (ADR-027).
/// `CONFIRMED` nao volta atras -- e o par de INV-069 do lado do pagamento.
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

/// `CONVENTION.md` 3.5, lado da tentativa (ADR-027).
enum PaymentAttemptStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
}

/// Credito do aluno por sobrepagamento (ADR-027, resposta 4 do PI).
/// NAO e dinheiro devolvivel no MVP 2 -- so abate invoice.
enum AccountCreditStatus {
  AVAILABLE
  APPLIED
  EXPIRED
}

/// Invoice: o que o aluno deve.
///
/// `totalMinor` e COPIA, nao calculo em tempo de leitura: INV-068 diz que
/// moeda e valor nao mudam depois da abertura, e o preco do plano pode
/// mudar amanha. Copiar congela; recalcular reescreveria o passado.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  /// Aluno cobrado. No plano familiar e o TITULAR -- dependente tem acesso,
  /// nao tem invoice.
  studentId      String        @map("student_id") @db.Uuid
  /// Periodo de competencia, primeiro dia. Une com a assinatura para dar a
  /// unicidade de INV-066.
  billingPeriod  DateTime      @map("billing_period") @db.Date
  status         InvoiceStatus @default(DRAFT)
  /// Numero sequencial legivel por tenant. Nao e o id.
  number         Int
  currency       String        @default("BRL")
  /// Centavos, todos. INV-065.
  subtotalMinor  Int           @map("subtotal_minor")
  discountMinor  Int           @default(0) @map("discount_minor")
  totalMinor     Int           @map("total_minor")
  dueAt          DateTime      @map("due_at")
  /// Instante a partir do qual a inadimplencia bloqueia (ADR-019/INV-144).
  blockAt        DateTime?     @map("block_at")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  version        Int           @default(0)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription     @relation(fields: [subscriptionId], references: [id])
  student      Student          @relation(fields: [studentId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  attempts     PaymentAttempt[]
  refunds      Refund[]
  receipts     Receipt[]

  /// INV-066: invoice unica por assinatura e periodo.
  @@unique([tenantId, subscriptionId, billingPeriod])
  /// Numeracao legivel, sem buraco nem repeticao dentro do tenant.
  @@unique([tenantId, number])
  @@index([tenantId, status, dueAt])
  @@map("invoices")
}

/// Item da invoice. Imutavel depois do pagamento (INV-067).
model InvoiceItem {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  invoiceId       String @map("invoice_id") @db.Uuid
  description     String
  quantity        Int    @default(1)
  /// Centavos. INV-065.
  unitAmountMinor Int    @map("unit_amount_minor")
  totalMinor      Int    @map("total_minor")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("invoice_items")
}

/// Pagamento: QUE DINHEIRO FOI RECONHECIDO (ADR-027).
///
/// Separado de `PaymentAttempt` porque respondem perguntas diferentes:
/// tentativa e "o que eu tentei", pagamento e "o que entrou". Invoice paga
/// em duas tentativas (PIX falho + cartao) tem DUAS tentativas e UM
/// pagamento -- e a falha continua no historico, que e o ponto.
model Payment {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  invoiceId   String            @map("invoice_id") @db.Uuid
  /// Centavos. INV-065.
  amountMinor Int               @map("amount_minor")
  currency    String            @default("BRL")
  method      PaymentMethodKind
  status      PaymentStatus     @default(PENDING)
  paidAt      DateTime?         @map("paid_at")

  /// Quem reconheceu, preenchido SO quando `method = MANUAL`.
  ///
  /// Com a dupla permissao fora do MVP 2 (emenda de 18/08/2026), este campo
  /// e a mitigacao que sobrou: o controle deixou de ser preventivo e passou
  /// a ser DETECTIVO. Ele nao impede o registro inflado -- permite achar
  /// depois. A diferenca e deliberada e e do PI (ADR-027, consequencia 3).
  recognizedByUserId String? @map("recognized_by_user_id") @db.Uuid

  /// Nulo em pagamento manual: dinheiro na recepcao nao tem tentativa.
  attemptId         String? @unique @map("attempt_id") @db.Uuid
  providerAccountId String? @map("provider_account_id")
  externalPaymentId String? @map("external_payment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice         @relation(fields: [invoiceId], references: [id])
  attempt PaymentAttempt? @relation(fields: [attemptId], references: [id])
  credits AccountCredit[]
  refunds Refund[]
  receipt Receipt?

  /// ADR-006 / INV-076: idempotencia do evento externo.
  @@unique([providerAccountId, externalPaymentId])
  @@index([tenantId, invoiceId, status])
  @@map("payments")
}

/// Tentativa de pagamento: O QUE FOI TENTADO (ADR-027).
///
/// Sucesso posterior nao apaga a falha anterior -- por isso a tentativa e
/// tabela propria e nao um campo de status no pagamento.
model PaymentAttempt {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  invoiceId          String               @map("invoice_id") @db.Uuid
  method             PaymentMethodKind
  status             PaymentAttemptStatus @default(CREATED)
  /// Chave enviada ao provedor. Constraint do `MVP-02` 11.
  idempotencyKey     String               @map("idempotency_key")
  providerAccountId  String?              @map("provider_account_id")
  externalPaymentId  String?              @map("external_payment_id")
  /// Codigo estavel do erro. Nunca a mensagem crua (`CLAUDE.md`).
  failureCode        String?              @map("failure_code")
  /// Falha permanente nao se repete sozinha; transitoria pode.
  failureIsPermanent Boolean?             @map("failure_is_permanent")
  requestedAt        DateTime             @default(now()) @map("requested_at")
  settledAt          DateTime?            @map("settled_at")
  /// Quando o checkout hospedado deixa de ser pagavel (F53). NULA para PIX e
  /// para tentativas de cartao antigas -- so o checkout tem prazo fixo
  /// conhecido na criacao. Sem ela, uma tentativa presa em `CREATED` nunca
  /// sai do predicado do indice parcial abaixo e trava a fatura para sempre.
  expiresAt          DateTime?            @map("expires_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  payment Payment?

  @@unique([tenantId, idempotencyKey])
  /// NO MAXIMO UMA cobranca de cartao em voo por invoice -- indice PARCIAL
  /// (`method = 'CARD' AND status = 'PROCESSING'`), declarado na migration
  /// porque o Prisma nao modela unicidade condicional.
  ///
  /// Sem ele, duas requisicoes concorrentes para a mesma invoice cobram o
  /// aluno DUAS VEZES: a chave de idempotencia deriva da contagem de
  /// tentativas, e contagem muda entre a leitura e a escrita -- justamente a
  /// janela que a idempotencia existe para fechar.
  ///
  /// F53: o indice acima NAO cobre o checkout hospedado -- ele nasce em
  /// `CREATED`, nao em `PROCESSING`. Segundo indice parcial (`method = 'CARD'
  /// AND status IN ('CREATED', 'REQUIRES_ACTION', 'PROCESSING')`) fecha essa
  /// segunda porta, medido em `checkout-de-cartao.int-spec.ts`. Os dois
  /// convivem: nenhum dos dois substitui o outro.
  @@index([tenantId, invoiceId, status])
  @@map("payment_attempts")
}

/// Credito do aluno por sobrepagamento (ADR-027, resposta 4 do PI).
///
/// R$ 121 numa mensalidade de R$ 120 vira R$ 1 de credito, abatido na
/// proxima invoice. NAO e dinheiro devolvivel no MVP 2.
///
/// `originPaymentId` e obrigatorio: credito sem origem rastreavel e
/// exatamente o buraco de controle que a emenda de 18/08 deixou aberto do
/// lado preventivo -- aqui ele fecha do lado detectivo.
model AccountCredit {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  studentId          String              @map("student_id") @db.Uuid
  originPaymentId    String              @map("origin_payment_id") @db.Uuid
  /// Centavos. INV-065.
  amountMinor        Int                 @map("amount_minor")
  currency           String              @default("BRL")
  status             AccountCreditStatus @default(AVAILABLE)
  appliedToInvoiceId String?             @map("applied_to_invoice_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  origin  Payment @relation(fields: [originPaymentId], references: [id])

  @@index([tenantId, studentId, status])
  @@map("account_credits")
}

/// Numeracao da invoice por tenant.
///
/// Mesmo padrao de `StudentSequence`, e pelas mesmas razoes: `COUNT(*) + 1`
/// reusa numero depois de cancelamento, fragmento de UUID nao e sequencial,
/// e `SEQUENCE` do Postgres e global -- o tenant B veria o volume do A.
model InvoiceSequence {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  /// Proximo numero a emitir. Nunca decrementa.
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invoice_sequences")
}

// ---------------------------------------------------------------------------
// Provedor de pagamento (F13)
// ---------------------------------------------------------------------------

/// Conta do tenant no provedor de pagamento.
///
/// EXISTE POR CAUSA DA INV-078: o webhook NAO confia no tenant do payload.
/// Quem diz de qual tenant e o evento e a conta que o provedor identifica na
/// requisicao -- payload e dado de terceiro, e terceiro nao decide multi-tenancy.
///
/// `signingSecret` e o segredo do HMAC da assinatura (INV-077). Cifrado em
/// repouso pela mesma razao que token de provedor (`MVP-02` 11): o banco nao
/// e lugar de segredo em claro.
///
/// `provider` e string, nao enum: em 19/08/2026 sao `sicoob` e `getnet`
/// (ADR-032), mas trocar de PSP e decisao do PI e nao deve custar migration.
/// A COLUNA QUE O CODIGO CONSULTA E `capability`, nunca esta -- ver abaixo.

/// Capacidade que uma conta de provedor atende (ADR-032).
///
/// EXISTE PORQUE SAO DOIS PROVEDORES: Sicoob para PIX, Getnet para cartao.
/// Sem ela, `findFirst({ active: true })` devolve qualquer conta ativa do
/// tenant -- e a cobranca PIX sairia pela conta de cartao dependendo da ordem
/// de insercao no banco, silenciosamente.
enum ProviderCapability {
  PIX
  CARD

  @@map("provider_capability")
}

model ProviderAccount {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  /// Slug do provedor homologado. Minusculo, sem espaco.
  provider               String
  /// O QUE esta conta sabe fazer, nao QUEM ela e.
  ///
  /// O roteamento pergunta pela CAPACIDADE e nunca pela marca: trocar o
  /// Sicoob por outro PSP e mudar a linha de `provider` e escrever um
  /// adapter, sem tocar em caso de uso nenhum.
  capability             ProviderCapability
  /// Identificador da conta NO PROVEDOR. E o que chega na requisicao de
  /// webhook e resolve o tenant.
  externalAccountId      String             @map("external_account_id")
  /// Segredo do HMAC, cifrado. Nunca sai em resposta de API, nunca em log.
  signingSecretEncrypted String             @map("signing_secret_encrypted")
  active                 Boolean            @default(true)
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events             ProviderEvent[]
  reconciliationRuns ReconciliationRun[]

  /// O par (provedor, conta) e o que a requisicao carrega -- por isso a
  /// unicidade e global, nao por tenant: duas contas iguais em tenants
  /// diferentes tornariam a resolucao ambigua, que e o buraco da INV-078.
  @@unique([provider, externalAccountId])
  /// UMA conta ATIVA por capacidade por tenant -- indice PARCIAL
  /// (`WHERE active`), declarado na migration porque o Prisma nao modela
  /// unicidade condicional. `@@index` aqui existe so para o planner; a
  /// garantia mora em `provider_accounts_tenant_id_capability_active_key`.
  ///
  /// Parcial de proposito: conta desativada nao disputa roteamento, e exigir
  /// unicidade sobre ela impediria trocar de PSP -- a conta antiga precisa
  /// seguir existindo, inativa, para os eventos historicos continuarem
  /// resolviveis.
  @@index([tenantId, capability, active])
  @@index([tenantId, provider])
  @@map("provider_accounts")
}

/// Inbox de webhook do provedor (regra de arquitetura no 4, INV-076).
///
/// A unicidade `(provider_account_id, external_event_id)` E a idempotencia.
/// Nao e o `if (jaProcessei)` do codigo -- esse perde a corrida entre duas
/// entregas simultaneas do mesmo evento. O banco nao perde.
///
/// `occurredAt` e o instante DO PROVEDOR, nao o nosso: e com ele que a
/// INV-079 decide se o evento chegou fora de ordem. Relogio local nao serve
/// -- a ordem que importa e a da origem.
model ProviderEvent {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  providerAccountId String    @map("provider_account_id") @db.Uuid
  /// Chave estavel do evento no provedor (INV-076). Criterio de homologacao
  /// do ADR-013: provedor sem isso nao passa no gate.
  externalEventId   String    @map("external_event_id")
  eventType         String    @map("event_type")
  /// Pagamento a que o evento se refere, quando ha. Nulo em evento que nao
  /// e de pagamento.
  externalPaymentId String?   @map("external_payment_id")
  /// Payload ja verificado. Retencao definida em `MVP-02` 11; NUNCA contem
  /// PAN/CVV -- a tokenizacao e hospedada (INV-098).
  payload           Json
  /// Instante no PROVEDOR. Base da ordenacao logica (INV-079).
  occurredAt        DateTime  @map("occurred_at")
  /// Nulo enquanto nao aplicado. Evento recebido != evento aplicado: um
  /// evento fora de ordem e persistido e NAO aplicado.
  processedAt       DateTime? @map("processed_at")
  /// Por que o evento nao mudou estado, quando nao mudou. Codigo estavel.
  skippedReason     String?   @map("skipped_reason")
  receivedAt        DateTime  @default(now()) @map("received_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account ProviderAccount @relation(fields: [providerAccountId], references: [id])

  @@unique([providerAccountId, externalEventId])
  @@index([tenantId, externalPaymentId])
  @@map("provider_events")
}

// ---------------------------------------------------------------------------
// Estorno, conciliacao e recibo -- F16, `MVP-02` 7 (Slice 2.5) e 11
// ---------------------------------------------------------------------------

/// Politica de acesso quando o estorno CONFIRMA. `M2-COMPLIANCE-01`.
///
/// Decidida pelo PI em 19/08/2026: `KEEP_UNTIL_PERIOD_END`. O aluno estornado
/// continua entrando ate o fim do periodo que ja estava pago.
///
/// POR QUE E ENUM, E NAO UM `if` NO CASO DE USO: a segunda politica ja existe
/// no documento (`SUSPEND_ON_CONFIRMATION`), e a escolha e por tenant. Uma
/// academia que mude de ideia muda uma linha da tabela -- nao um deploy.
///
/// NENHUMA DAS DUAS E RETROATIVA (INV-094, `M2-BR-009`): a politica vale a
/// partir do instante da confirmacao. Acesso que ja aconteceu aconteceu, e
/// reescrever historico de catraca seria inventar que alguem nao entrou.
enum RefundAccessPolicy {
  /// Mantem o entitlement ate o fim do periodo pago. Padrao do PI.
  KEEP_UNTIL_PERIOD_END
  /// Suspende o entitlement no instante da confirmacao.
  SUSPEND_ON_CONFIRMATION

  @@map("refund_access_policy")
}

/// Estado do estorno. `MVP-02` 10 nao declara este grafo -- `Refund` esta
/// `[indefinido]` no `CONVENTION.md` 2.3 --, entao ele espelha o unico que o
/// PRD declara para o lado do provedor (`ProviderRefund`), mais os dois
/// estados que so existem do nosso lado.
///
/// `REQUESTED` e o instante entre a nossa decisao e a chamada ao provedor:
/// ele existe porque a chave de idempotencia precisa estar GRAVADA antes do
/// efeito externo (INV-084). Sem ele, uma falha de rede depois da chamada
/// deixaria dinheiro estornado sem registro nosso.
enum RefundStatus {
  REQUESTED
  PROCESSING
  CONFIRMED
  FAILED

  @@map("refund_status")
}

/// Estorno: movimento PROPRIO, nunca uma edicao do pagamento (INV-069).
///
/// A invoice NAO volta a `OPEN` quando o dinheiro sai -- ela vira `REFUNDED`,
/// que e um terceiro fato, nao a negacao do segundo. Reabrir diria que o
/// aluno nunca pagou, e ele pagou.
///
/// O QUE ESTA TABELA NAO ESTORNA: pagamento `MANUAL`. Por decisao do PI no
/// ADR-027, dinheiro reconhecido na recepcao nao tem o que o provedor
/// devolva -- a devolucao fisica acontece fora do sistema, e o que entra aqui
/// seria um estorno que nenhuma API confirma. Contra-lancamento auditado e o
/// caminho, e ele nao e desta fatia.
model Refund {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  /// Denormalizado de proposito: a fila de conciliacao filtra por invoice, e
  /// alcancar a invoice pelo pagamento em toda linha da lista seria um join a
  /// mais por um dado que nunca muda depois de gravado.
  invoiceId String @map("invoice_id") @db.Uuid

  /// Centavos. INV-065 -- nunca float.
  ///
  /// PARCIAL E PERMITIDO pelo tipo, e isso e deliberado: o `RefundInput` da
  /// porta ja aceita valor, e a matriz de homologacao marcou estorno parcial
  /// como NAO VERIFICADO nos dois provedores. Modelar so o total obrigaria
  /// migration quando a verificacao chegar.
  amountMinor Int    @map("amount_minor")
  currency    String @default("BRL")

  status RefundStatus @default(REQUESTED)

  /// Razao obrigatoria, mesmo padrao do pagamento manual (INV-072/INV-126).
  /// A trilha e DETECTIVA (ADR-027): nao impede o estorno indevido, permite
  /// acha-lo depois.
  reason String

  /// Quem pediu. Nunca nulo: estorno sem ator nao e auditavel.
  requestedByUserId String @map("requested_by_user_id") @db.Uuid

  /// Politica aplicada NO INSTANTE DA CONFIRMACAO, gravada aqui.
  ///
  /// Copia, nao referencia: a politica do tenant pode mudar depois, e a
  /// pergunta "por que este aluno continuou entrando?" tem que ser
  /// respondivel com o valor que valia naquele dia. Ler a configuracao atual
  /// para explicar decisao antiga e como reescrever o passado.
  appliedAccessPolicy RefundAccessPolicy? @map("applied_access_policy")

  /// Chave enviada ao provedor. Gravada ANTES da chamada (INV-084).
  idempotencyKey   String  @map("idempotency_key")
  /// Id do estorno no provedor. Nulo ate a chamada voltar.
  externalRefundId String? @map("external_refund_id")
  /// Codigo estavel da falha. Nunca a mensagem crua (`CLAUDE.md`).
  failureCode      String? @map("failure_code")

  requestedAt DateTime  @default(now()) @map("requested_at")
  settledAt   DateTime? @map("settled_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, idempotencyKey])
  /// NO MAXIMO UM estorno em voo por pagamento -- indice PARCIAL
  /// (`WHERE status IN ('REQUESTED','PROCESSING')`), declarado na migration
  /// porque o Prisma nao modela unicidade condicional.
  ///
  /// A LICAO E DA F14, QUE COBROU O ALUNO EM DOBRO: um `if (jaExiste)` perde
  /// a corrida entre duas requisicoes concorrentes, porque entre a leitura e
  /// a escrita cabe a outra. Aqui o erro seria devolver o dinheiro duas
  /// vezes. O banco nao perde a corrida.
  @@index([tenantId, paymentId, status])
  @@index([tenantId, status, requestedAt])
  @@map("refunds")
}

/// Recibo NAO FISCAL (INV-075, `M2-FR-018`).
///
/// NAO E NOTA FISCAL, e o produto inteiro depende dessa distincao: o ArenaHub
/// nao emite documento fiscal (`docs/prd/README.md` 3). O texto impresso diz
/// "RECIBO NAO FISCAL" em caixa alta porque um recibo que PARECE nota e pior
/// que recibo nenhum -- a academia o entregaria no lugar da nota que ela
/// ainda precisa emitir.
///
/// SNAPSHOT, NAO VISTA: o conteudo e congelado na emissao. Renderizar o
/// recibo lendo invoice e aluno ao vivo faria o documento de marco mudar
/// quando o aluno trocasse de nome em agosto -- e um recibo que muda depois
/// de entregue nao prova nada.
model Receipt {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  /// `@unique` no campo, e nao so no par com o tenant: `Receipt` e 1-1 com
  /// `Payment`, e o Prisma exige unicidade do lado que define a relacao. O
  /// par `(tenant, pagamento)` seria redundante -- o id do pagamento ja e
  /// global.
  paymentId String @unique @map("payment_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  /// Numero sequencial por tenant. Mesmo padrao de `InvoiceSequence`, pelas
  /// mesmas razoes: `COUNT(*) + 1` reusa numero, e `SEQUENCE` do Postgres e
  /// global -- o tenant B veria o volume do A.
  number Int

  /// O documento congelado. Contem o que sera impresso e nada mais.
  ///
  /// O QUE NUNCA ENTRA AQUI: PAN, CVV, token do provedor, id de webhook,
  /// CPF completo (INV-098, INV-133). O recibo e entregue em papel para o
  /// aluno e fica no historico -- e o lugar errado para qualquer segredo.
  snapshot Json

  /// SHA-256 do `snapshot` em JSON canonico. E o codigo de verificacao
  /// impresso: confere se o papel bate com o registro (INV-075,
  /// "identificadores verificaveis").
  verificationHash String @map("verification_hash")

  issuedAt DateTime @default(now()) @map("issued_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  /// UM recibo por pagamento -- garantido pelo `@unique` em `paymentId`.
  /// Reemitir devolve o MESMO documento; gerar um segundo com numero novo
  /// faria parecer que o aluno pagou duas vezes.
  @@unique([tenantId, number])
  @@map("receipts")
}

/// Numeracao do recibo por tenant. Gemea de `InvoiceSequence`.
model ReceiptSequence {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  /// Proximo numero a emitir. Nunca decrementa.
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("receipt_sequences")
}

/// Uma execucao de conciliacao sobre um intervalo FECHADO. `M2-FR-019`.
///
/// O intervalo e fechado de proposito: conciliar "ate agora" produziria
/// divergencia falsa toda vez, porque o pagamento de trinta segundos atras
/// ainda nao apareceu no extrato do banco. `MISSING_EXTERNAL` so e verdade
/// depois que a janela fechou.
model ReconciliationRun {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  /// Conta cujo extrato foi lido. UUID interno -- aqui HA relacao, ao
  /// contrario de `Payment.provider_account_id`, que guarda o id externo.
  providerAccountId String @map("provider_account_id") @db.Uuid

  /// Intervalo fechado, em UTC. `periodEnd` e exclusivo.
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  status ReconciliationRunStatus @default(RUNNING)

  /// Contagens do resultado, para a tela nao recontar a cada abertura.
  movementsImported Int @default(0) @map("movements_imported")
  itemsOpen         Int @default(0) @map("items_open")

  /// Codigo estavel quando a execucao falha (provedor fora, por exemplo).
  failureCode String? @map("failure_code")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account   ProviderAccount      @relation(fields: [providerAccountId], references: [id])
  movements ExternalMovement[]
  items     ReconciliationItem[]

  /// Reexecutar a MESMA janela na MESMA conta e idempotente: devolve a
  /// execucao que ja existe em vez de criar divergencia duplicada (INV-086).
  @@unique([tenantId, providerAccountId, periodStart, periodEnd])
  @@index([tenantId, startedAt])
  @@map("reconciliation_runs")
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED

  @@map("reconciliation_run_status")
}

/// Tipo do movimento no extrato. Dinheiro que entra ou que volta.
enum ExternalMovementKind {
  PAYMENT
  REFUND

  @@map("external_movement_kind")
}

/// Uma linha do extrato do provedor, normalizada.
///
/// POR QUE PERSISTIR EM VEZ DE COMPARAR EM MEMORIA: a divergencia precisa
/// continuar explicavel depois. Um item `MISSING_INTERNAL` aberto em marco e
/// resolvido em abril tem que mostrar QUAL linha do extrato o gerou -- e o
/// extrato do provedor nao e consultavel para tras indefinidamente.
///
/// Note que `externalAccountId` e o id EXTERNO (string do provedor), igual ao
/// que `Payment.provider_account_id` guarda -- e por isso que o casamento
/// entre os dois lados funciona por comparacao direta.
model ExternalMovement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  runId    String @map("run_id") @db.Uuid

  /// Id do movimento NO PROVEDOR. E o que da a idempotencia da importacao.
  externalMovementId String  @map("external_movement_id")
  /// Id do pagamento no provedor, quando o movimento se refere a um.
  externalPaymentId  String? @map("external_payment_id")
  /// Conta no provedor, id EXTERNO -- casa com `Payment.provider_account_id`.
  externalAccountId  String  @map("external_account_id")

  kind ExternalMovementKind

  /// Centavos. INV-065. Sempre POSITIVO: a direcao mora em `kind`, nao no
  /// sinal -- valor negativo em coluna monetaria e a forma mais facil de uma
  /// soma silenciosamente dar o numero errado.
  amountMinor Int    @map("amount_minor")
  currency    String @default("BRL")

  /// Instante NO PROVEDOR.
  occurredAt DateTime @map("occurred_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Reimportar a mesma pagina do extrato NA MESMA EXECUCAO nao duplica
  /// movimento (INV-086).
  ///
  /// A UNICIDADE INCLUI A RUN, e nao e frouxidao: o mesmo movimento aparece
  /// legitimamente em duas execucoes -- janelas que se sobrepoem, ou a
  /// reconciliacao de agosto rodada de novo em setembro. Unicidade so por
  /// `(tenant, movimento)` faria a segunda execucao FALHAR, e conciliar duas
  /// vezes e justamente o que a operacao precisa poder fazer.
  @@unique([tenantId, runId, externalMovementId])
  @@index([tenantId, externalPaymentId])
  @@map("external_movements")
}

/// Estado da divergencia. `MVP-02` 10, literal -- estes cinco nomes vem do
/// PRD e nao foram inventados aqui.
enum ReconciliationItemStatus {
  MATCHED
  MISSING_INTERNAL
  MISSING_EXTERNAL
  AMOUNT_MISMATCH
  RESOLVED

  @@map("reconciliation_item_status")
}

/// Como o operador resolveu a divergencia. Lista FECHADA.
///
/// FECHADA E O PONTO INTEIRO (`M2-AC-010`): o aceite da fatia e "operador
/// resolve divergencia SEM EDITAR BANCO". Um comando generico de edicao seria
/// exatamente o `UPDATE` manual que este modelo existe para tornar
/// desnecessario -- so que por dentro da aplicacao, parecendo seguro.
enum ReconciliationResolution {
  /// O evento existe no inbox e nunca foi aplicado. Reprocessa pelo MESMO
  /// caminho idempotente do webhook -- nao por um atalho de escrita.
  REPROCESS_PROVIDER_EVENT
  /// Diferenca real, explicada e aceita (tarifa do provedor, por exemplo).
  /// Nao move dinheiro: registra que alguem olhou e decidiu.
  ACCEPT_DOCUMENTED_DIFFERENCE

  @@map("reconciliation_resolution")
}

/// Uma divergencia entre o nosso registro e o extrato do provedor.
///
/// TODO MOVIMENTO VIRA LINHA AQUI, inclusive o que bateu (`MATCHED`). Guardar
/// so o que deu errado responderia "quais divergencias houve?" mas nunca
/// "conciliei 100%?" -- que e a metrica que o `MVP-02` 3 cobra.
model ReconciliationItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  runId    String @map("run_id") @db.Uuid

  status ReconciliationItemStatus

  /// Lado interno, quando existe. Nulo em `MISSING_INTERNAL`.
  paymentId          String? @map("payment_id") @db.Uuid
  refundId           String? @map("refund_id") @db.Uuid
  /// Lado externo, quando existe. Nulo em `MISSING_EXTERNAL`.
  externalMovementId String? @map("external_movement_id")

  /// Os dois valores, lado a lado. A tela mostra ambos sem recalcular, e a
  /// diferenca fica evidente sem o operador fazer conta de cabeca.
  internalAmountMinor Int? @map("internal_amount_minor")
  externalAmountMinor Int? @map("external_amount_minor")

  /// Texto em pt-BR, pronto para a tela: o que fazer com esta linha.
  recommendedAction String @map("recommended_action")

  /// Resolucao, quando houve. APPEND-ONLY na pratica: o item vai de aberto
  /// para `RESOLVED` uma vez, e o que aconteceu fica gravado. Nao ha caminho
  /// de volta -- desfazer resolucao seria apagar a decisao de alguem.
  resolution       ReconciliationResolution?
  resolutionReason String?                   @map("resolution_reason")
  resolvedByUserId String?                   @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?                 @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, runId])
  @@map("reconciliation_items")
}

// ---------------------------------------------------------------------------
// F17 -- Saude: avaliacao fisica manual, medidas e contexto do aluno.
//
// Tres coisas que o desenho existe para garantir:
//
// - **INV-102** avaliacao PUBLICADA e imutavel. Correcao cria versao nova
//   apontando para a anterior (`supersedesAssessmentId`), nunca UPDATE.
// - **INV-104** ausencia de dado NAO E ZERO. Toda medida e LINHA, nunca
//   coluna: campo que o aparelho nao reporta simplesmente nao gera linha.
//   Coluna anulavel por tipo convidaria alguem a preencher com `0`.
// - **INV-105** a unidade ORIGINAL sobrevive junto do valor canonico.
// ---------------------------------------------------------------------------

/// Estado da avaliacao. So ha dois, e a transicao e de mao unica.
enum AssessmentStatus {
  /// Editavel. Nao entra em grafico, comparativo nem historico oficial.
  DRAFT
  /// IMUTAVEL (INV-102). Correcao cria outra avaliacao vinculada.
  PUBLISHED

  @@map("assessment_status")
}

/// De onde veio o numero. Proveniencia e requisito (`M3-NFR-006`), nao enfeite.
enum MeasurementSource {
  /// Digitado pelo avaliador.
  MANUAL
  /// Balanca de bioimpedancia (ex.: `CF610_G` da Arena Positiva).
  DEVICE
  /// Extraido de arquivo por OCR/parser -- SEMPRE via confirmacao humana
  /// (INV-103). O valor so chega aqui depois de confirmado; a fatia que
  /// produz a extracao e a F19.
  IMPORT

  @@map("measurement_source")
}

/// Fator individual que muda como o laudo deve ser lido (ADR-037).
///
/// LISTA FECHADA, sem campo de texto livre: fator individual e dado de saude
/// (art. 11), e campo aberto preenchido no balcao vira deposito de
/// informacao medica com finalidade impossivel de enumerar.
///
/// Cada fator SUPRIME alerta especifico de forma deterministica -- nenhum
/// gera texto. Fator novo entra por PR **com o teste que prova o que ele
/// suprime**; sem teste, nao entra.
enum HealthContextFactor {
  /// Suprime alerta de agua intracelular alta.
  SUPLEMENTACAO_CREATINA
  /// Suprime alertas de compartimento ABSOLUTO; mantem os de RAZAO.
  COMPOSICAO_ATIPICA
  /// BLOQUEIA a analise: a avaliacao e registrada, nao interpretada.
  GESTANTE_OU_POS_PARTO
  /// Invalida a leitura de agua; demais campos seguem.
  EDEMA_RELATADO
  /// Idem `EDEMA_RELATADO`.
  USO_DE_DIURETICO
  /// Suprime comparacao com faixa populacional; mantem a com o proprio historico.
  ATLETA_COMPETITIVO

  @@map("health_context_factor")
}

/// Tipo de medida corporal. Espelha `TipoDeMedida` do dominio.
///
/// Lista fechada de proposito: tipo livre viraria taxonomia paralela por
/// academia, e comparar historico entre unidades deixaria de funcionar.
enum BodyMeasurementType {
  WEIGHT
  HEIGHT
  BODY_FAT_PERCENT
  BODY_FAT_MASS
  LEAN_BODY_MASS
  SKELETAL_MUSCLE_MASS
  TOTAL_BODY_WATER
  INTRACELLULAR_WATER
  EXTRACELLULAR_WATER
  PROTEIN_MASS
  MINERAL_MASS
  VISCERAL_FAT_LEVEL
  BASAL_METABOLIC_RATE
  WAIST_CIRCUMFERENCE
  HIP_CIRCUMFERENCE
  // Segmentares (F-multiarquivo): alimentam o boneco do aluno.
  SEGMENTAL_FAT_MASS_ARM_LEFT
  SEGMENTAL_FAT_MASS_ARM_RIGHT
  SEGMENTAL_FAT_MASS_TRUNK
  SEGMENTAL_FAT_MASS_LEG_LEFT
  SEGMENTAL_FAT_MASS_LEG_RIGHT
  SEGMENTAL_MUSCLE_MASS_ARM_LEFT
  SEGMENTAL_MUSCLE_MASS_ARM_RIGHT
  SEGMENTAL_MUSCLE_MASS_TRUNK
  SEGMENTAL_MUSCLE_MASS_LEG_LEFT
  SEGMENTAL_MUSCLE_MASS_LEG_RIGHT
  // Composicao que os laudos trazem e o enum nao tinha.
  BONE_MASS
  BODY_CELL_MASS
  SUBCUTANEOUS_FAT_MASS
  SUBCUTANEOUS_FAT_PERCENT
  SKELETAL_MUSCLE_PERCENT
  MUSCLE_MASS
  PROTEIN_PERCENT
  WAIST_HIP_RATIO
  // Cardiaco. NUNCA interpretado (ADR-035).
  HEART_RATE

  @@map("body_measurement_type")
}

/// Unidade em que o valor foi MEDIDO. Espelha `UnidadeDeMedida` do dominio.
enum MeasurementUnit {
  KG
  G
  LB
  CM
  M
  IN
  PERCENT
  KCAL
  L

  @@map("measurement_unit")
}

/// Avaliacao fisica de um aluno, em rascunho ou publicada.
model BodyAssessment {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    AssessmentStatus @default(DRAFT)

  /// Instante em que a MEDICAO aconteceu -- nao o do cadastro. Avaliacao de
  /// ontem digitada hoje ordena por ontem, ou o comparativo mente.
  assessedAt  DateTime  @map("assessed_at")
  /// Preenchido na publicacao. A partir dai a linha nao sofre UPDATE de
  /// conteudo (INV-102).
  publishedAt DateTime? @map("published_at")

  source          MeasurementSource @default(MANUAL)
  /// Referencia da origem: id do arquivo importado (import avulso, F19) OU
  /// id da sessao de revisao (multiarquivo, Task 5), serial do aparelho.
  ///
  /// ⚠️ Quando `source = 'IMPORT'`, este valor e UNICO por indice parcial
  /// escrito a mao (`body_assessments_import_source_reference_uq`, em
  /// `migrations/20260821250000_sessao_idempotente_fix_indice`):
  ///
  ///     CREATE UNIQUE INDEX ... ON body_assessments (source_reference)
  ///       WHERE source = 'IMPORT' AND source_reference IS NOT NULL;
  ///
  /// E a garantia de que confirmar duas vezes a MESMA sessao (ou o MESMO
  /// import avulso) nunca cria duas avaliacoes -- ver
  /// `AvaliacaoJaExisteParaOrigemError` em `domain/avaliacao.ts`. O Prisma
  /// nao modela indice parcial: ele NAO aparece neste schema e um
  /// `prisma migrate dev` futuro vai propor apaga-lo. NAO ACEITE.
  sourceReference String?           @map("source_reference")

  /// Quem registrou. Exigido pelo INV-101 e pela secao 14 do MVP-03
  /// ("aluno ve quem registrou e quando").
  evaluatorUserId String @map("evaluator_user_id") @db.Uuid

  /// Avaliacao que esta corrige (INV-102). A corrigida permanece publicada e
  /// visivel: apagar destruiria a prova de que o numero errado circulou.
  supersedesAssessmentId String? @unique @map("supersedes_assessment_id") @db.Uuid

  /// Observacao do avaliador sobre a MEDICAO (jejum, horario, aparelho).
  /// NAO e campo clinico: contexto de saude e lista fechada, em
  /// `StudentHealthContext` (ADR-037).
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluator User    @relation("AssessmentEvaluator", fields: [evaluatorUserId], references: [id], onDelete: Restrict)

  supersedes   BodyAssessment? @relation("AssessmentCorrection", fields: [supersedesAssessmentId], references: [id], onDelete: Restrict)
  supersededBy BodyAssessment? @relation("AssessmentCorrection")

  measurements BodyMeasurement[]
  /// Os arquivos que originaram esta avaliacao. Vazio em avaliacao
  /// digitada a mao; um ou mais quando veio de laudo.
  imports      AssessmentImport[]

  /// Indices, classificacoes e sugestoes DO APARELHO (idade corporal,
  /// pontuacao, tipo de corpo, peso ideal). Nao sao medidas: nao entram no
  /// grafico de evolucao, porque a formula e proprietaria e muda com
  /// firmware. Ver §4.4 da spec.
  deviceReport Json?   @map("device_report")
  deviceModel  String? @map("device_model")
  deviceSerial String? @map("device_serial")

  @@index([tenantId, studentId, assessedAt])
  @@index([tenantId, studentId, status, publishedAt])
  @@map("body_assessments")
}

/// Uma medida de uma avaliacao. LINHA por medida, nunca coluna por tipo.
///
/// O par ORIGINAL (`originalValue`/`originalUnit`) e o CANONICO convivem de
/// proposito (INV-105): o canonico serve a comparacao e ao grafico; o
/// original prova o que foi medido, e sobrevive a qualquer mudanca futura na
/// tabela de fatores.
///
/// `Decimal` e nao `Float`: `0.1 + 0.2` em binario nao fecha, e comparativo
/// de composicao corporal subtrai numeros proximos -- onde o erro aparece.
model BodyMeasurement {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid

  type BodyMeasurementType

  /// Valor e unidade COMO MEDIDOS. `originalUnit` e `null` apenas para tipo
  /// adimensional (`VISCERAL_FAT_LEVEL`).
  originalValue Decimal          @map("original_value") @db.Decimal(10, 4)
  originalUnit  MeasurementUnit? @map("original_unit")

  /// Valor na unidade canonica do tipo, para comparacao. Calculado por
  /// `converterParaCanonica`, com precisao INTEIRA -- arredondar aqui
  /// contaminaria o comparativo (INV-106).
  canonicalValue Decimal          @map("canonical_value") @db.Decimal(10, 4)
  canonicalUnit  MeasurementUnit? @map("canonical_unit")

  source MeasurementSource @default(MANUAL)

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessment BodyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Um tipo por avaliacao: duas linhas de `WEIGHT` na mesma medicao seriam
  /// duas verdades sobre o mesmo instante, e o grafico teria de escolher uma
  /// sem criterio.
  @@unique([assessmentId, type])
  @@index([tenantId, assessmentId])
  @@map("body_measurements")
}

/// Fator de contexto ATIVO de um aluno (ADR-037).
///
/// Registrado pelo AVALIADOR, nunca pela recepcao. Desativar cria
/// `deactivatedAt` em vez de apagar: o snapshot da F21 precisa saber o que
/// valia na data da analise, nao o que vale hoje.
model StudentHealthContext {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  studentId String              @map("student_id") @db.Uuid
  factor    HealthContextFactor

  /// Quem registrou o fator. Slice 3.1 do MVP-03: "com autor e versao".
  recordedByUserId String @map("recorded_by_user_id") @db.Uuid

  recordedAt    DateTime  @map("recorded_at")
  /// Preenchido ao desativar. Linha desativada continua existindo.
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("HealthContextRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  /// ⚠️ UM FATOR ATIVO POR ALUNO e garantido por INDICE PARCIAL escrito a
  /// mao, em `migrations/20260820140000_f17_um_fator_ativo_por_aluno`:
  ///
  ///     CREATE UNIQUE INDEX ... ON student_health_context
  ///       (tenant_id, student_id, factor) WHERE deactivated_at IS NULL;
  ///
  /// Nao da para declara-lo aqui: `@@unique` cobriria tambem as linhas
  /// DESATIVADAS, e impediria reativar um fator que o aluno ja teve --
  /// gestante que engravida de novo, atleta que volta a competir.
  ///
  /// O Prisma nao modela indice parcial, entao ele NAO aparece neste schema e
  /// um `prisma migrate dev` futuro vai propor apaga-lo. NAO ACEITE: sem ele,
  /// dois cliques criam o mesmo fator duas vezes -- `findFirst` + `if` perde
  /// a corrida por construcao (mesma classe do bug da F14).
  @@index([tenantId, studentId, factor])
  @@map("student_health_context")
}

/// Meta de composicao corporal do aluno (`M3-FR-012`, F18).
///
/// Guarda o BASELINE junto do alvo de proposito: a avaliacao que serviu de
/// ponto de partida pode ser corrigida depois (INV-102), e uma meta que
/// recalculasse o proprio ponto de partida mudaria de significado sozinha.
/// O que o aluno combinou com o avaliador fica congelado aqui.
///
/// A meta NAO edita avaliacao nenhuma (Slice 3.4: "progresso calculado, sem
/// editar avaliacoes") -- ela e um alvo ao lado da serie, nunca um ponto
/// dentro dela.
model HealthGoal {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  studentId String              @map("student_id") @db.Uuid
  /// Tipo medido a que a meta se refere. Mesma lista fechada das medidas:
  /// meta de tipo livre nao teria serie com que ser comparada.
  type      BodyMeasurementType

  /// Valor de partida, na unidade canonica do tipo. `Decimal` e nao `Float`
  /// pela mesma razao de `BodyMeasurement`: o progresso subtrai numeros
  /// proximos.
  baselineValue Decimal          @map("baseline_value") @db.Decimal(10, 4)
  targetValue   Decimal          @map("target_value") @db.Decimal(10, 4)
  /// Unidade canonica do tipo. `null` apenas para tipo adimensional
  /// (`VISCERAL_FAT_LEVEL`), igual a `BodyMeasurement`.
  unit          MeasurementUnit?

  /// Prazo combinado. Meta vencida continua existindo e visivel: apagar
  /// esconderia que o combinado nao foi cumprido.
  deadline DateTime @db.Date

  /// Quem registrou -- o avaliador ou o personal, nunca a recepcao.
  createdByUserId String @map("created_by_user_id") @db.Uuid

  /// Preenchido quando o alvo e atingido (evento `HealthGoalReached`).
  achievedAt DateTime? @map("achieved_at")
  /// Preenchido ao encerrar a meta. Linha encerrada continua existindo.
  closedAt   DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User    @relation("HealthGoalAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// ⚠️ UMA META ATIVA POR TIPO E POR ALUNO e garantido por INDICE PARCIAL
  /// escrito a mao, em `migrations/20260820_f18_uma_meta_ativa_por_tipo`:
  ///
  ///     CREATE UNIQUE INDEX ... ON health_goals
  ///       (tenant_id, student_id, type) WHERE closed_at IS NULL;
  ///
  /// Parcial em `closed_at IS NULL` porque meta ENCERRADA nao disputa nada, e
  /// exigir unicidade sobre ela impediria o aluno de ter uma meta nova de
  /// peso depois de bater a anterior -- que e o caso comum, nao a excecao.
  ///
  /// Como na F17, o Prisma nao modela indice parcial: ele NAO aparece neste
  /// schema e um `prisma migrate dev` futuro vai propor apaga-lo. NAO ACEITE.
  /// Sem ele, dois cliques criam duas metas ativas do mesmo tipo e o
  /// comparativo passa a ter dois alvos sem criterio de desempate.
  @@index([tenantId, studentId, type])
  @@map("health_goals")
}

/// Sessao de frequencia: UM DIA em que o aluno entrou pelo menos uma vez
/// (`M3-FR-013`, `M3-BR-008`, Slice 3.4).
///
/// PROJECAO, nao fato. A verdade sao os `access_events` e `access_passages`
/// do MVP 1, que esta tabela NUNCA altera nem apaga -- `M3-BR-008` exige
/// agrupar "sem apagar eventos brutos". Apagar todas as linhas de uma
/// `policy_version` e reprojetar a partir das passagens tem de produzir
/// exatamente o mesmo resultado; e por isso que `passage_ids` viaja junto.
///
/// NAO HA `ended_at` NEM DURACAO, e a ausencia e deliberada: a Slice 3.4
/// proibe inferir duracao "quando nao houver saida confiavel", e hoje nao ha
/// -- a catraca opera liberada nos dois sentidos (ADR-029), entao ninguem
/// registra saida. `first_passage_at` e `last_passage_at` existem para
/// AUDITAR o agrupamento; subtrair um do outro produziria um numero com cara
/// de medida que na verdade e a distancia entre duas entradas.
model StudentAttendanceSession {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  gymUnitId String @map("gym_unit_id") @db.Uuid

  /// O DIA LOCAL da unidade, `AAAA-MM-DD`. `@db.Date` e nao `DateTime`: a
  /// sessao E o dia, e guardar um instante convidaria a reconverter fuso na
  /// leitura -- aplicando o fuso duas vezes, que e o erro classico aqui.
  sessionDate DateTime @map("session_date") @db.Date

  /// Extremos das passagens do dia. Para auditoria, NAO para subtrair.
  firstPassageAt DateTime @map("first_passage_at")
  lastPassageAt  DateTime @map("last_passage_at")

  /// Quantas passagens confirmadas caIram neste dia. Sempre >= 1.
  passageCount Int @map("passage_count")

  /// Ids das passagens que formaram a sessao, em ordem cronologica. E o que
  /// torna a projecao auditavel e reconstruivel: sem eles, reprojetar teria
  /// de confiar no agregado que ele mesmo quer refazer.
  passageIds String[] @map("passage_ids") @db.Uuid

  /// Regra que formou esta linha (`dia-civil-local@1`). Trocar de politica e
  /// REPROJETAR numa versao nova, nunca migrar numero ja calculado: sessoes
  /// de versoes diferentes contam coisas diferentes, e a versao e o que torna
  /// isso visIvel em vez de silencioso.
  policyVersion String @map("policy_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gymUnit GymUnit @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)

  /// UMA sessao por (aluno, dia, unidade, politica). E a garantia de
  /// idempotencia da reprojecao: rodar o projetor duas vezes sobre as mesmas
  /// passagens nao pode dobrar a frequencia do aluno. No banco e nao num
  /// `if`, pela mesma razao da F14, F17 e F18 -- guarda que le antes de
  /// escrever perde a corrida por construcao.
  ///
  /// A politica entra na chave para que duas versoes possam COEXISTIR
  /// enquanto se compara uma com a outra; o leitor filtra pela vigente.
  @@unique([tenantId, studentId, sessionDate, gymUnitId, policyVersion])
  @@index([tenantId, studentId, sessionDate])
  @@map("student_attendance_sessions")
}

/// Desfecho de uma analise por IA.
enum AiAnalysisStatus {
  /// Saida validada e gravada. E a unica que a tela mostra.
  PUBLISHED
  /// Recusada pela validacao (`M3-BR-010`). A linha FICA: `M3-AC-008` exige
  /// registrar a rejeicao, e apagar esconderia que o modelo tentou.
  REJECTED
  /// O provedor falhou (timeout, indisponibilidade, teto de gasto).
  FAILED

  @@map("ai_analysis_status")
}

/// Versao de prompt usada nas analises (`M3-FR-016`).
///
/// Tabela propria e nao string solta na analise: o mesmo prompt gera centenas
/// de analises, e reproduzir uma analise de tres meses atras exige o TEXTO
/// que a gerou -- nao o nome dele.
model AiPromptVersion {
  id            String    @id @default(uuid()) @db.Uuid
  /// `analise-de-saude@3`. Unico globalmente: prompt e do produto, nao do
  /// tenant.
  name          String    @unique
  content       String
  /// SHA-256 do `content`, em hex minusculo. E o que prova que o texto nao
  /// mudou por baixo de uma analise ja publicada.
  contentSha256 String    @map("content_sha256")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// Preenchido quando uma versao nova entra. Versao aposentada continua
  /// existindo: ha analise publicada apontando para ela.
  retiredAt     DateTime? @map("retired_at")

  analyses AiAnalysis[]

  @@map("ai_prompt_versions")
}

/// Analise assistiva por IA de um aluno (`M3-FR-015`, `M3-FR-016`, F21).
///
/// ---------------------------------------------------------------------------
/// O QUE ESTA TABELA NAO GUARDA: O SNAPSHOT COM DADO PESSOAL.
/// ---------------------------------------------------------------------------
///
/// `snapshot` e o payload PSEUDONIMIZADO -- exatamente o que foi enviado ao
/// provedor, sem nome, sem CPF, sem `student_id`, sem nada de ECG
/// (`M3-NFR-009`, ADR-035). Guardar o enviado e o que torna a analise
/// REPRODUZIVEL: sem ele, "por que a IA disse isso" nao tem resposta.
///
/// O vinculo com o aluno mora na COLUNA `student_id`, nao dentro do JSON. E a
/// separacao que permite auditar de quem e a analise sem que o provedor
/// jamais tenha sabido.
model AiAnalysis {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    AiAnalysisStatus

  /// Identificador OPACO enviado ao provedor. Nao deriva do aluno.
  analysisRef String @unique @map("analysis_ref")

  /// O payload pseudonimizado, como foi enviado.
  snapshot Json
  /// A saida VALIDADA. Nulo quando `REJECTED` ou `FAILED` -- saida recusada
  /// nao vira conteudo, nem "para consulta".
  output   Json?

  /// Por que foi recusada (`M3-AC-008`). Nulo quando publicada.
  rejectionReason String? @map("rejection_reason")
  rejectionDetail String? @map("rejection_detail")

  promptVersionId String @map("prompt_version_id") @db.Uuid
  /// Modelo exato (`claude-sonnet-4-6`). String e nao enum: modelo novo do
  /// provedor nao pode exigir migration.
  model           String

  /// Custo em MILESIMOS de centavo de dolar, inteiro (`M3-FR-016`).
  ///
  /// Inteiro pela mesma regra de arquitetura no 6 que vale para dinheiro:
  /// `float` acumula erro, e o teto de gasto por tenant (`M3-NFR-005`) soma
  /// milhares destes valores.
  costMicros   Int @map("cost_micros")
  latencyMs    Int @map("latency_ms")
  inputTokens  Int @map("input_tokens")
  outputTokens Int @map("output_tokens")

  /// Quem pediu a analise. E o profissional que endossou (F21).
  requestedByUserId String @map("requested_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  promptVersion AiPromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  requestedBy   User            @relation("AiAnalysisRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, createdAt])
  @@map("ai_analyses")
}

/// Estado de uma importacao de arquivo (F19).
enum AssessmentImportStatus {
  /// Arquivo recebido, ainda nao escaneado nem extraido.
  RECEIVED
  /// Antivirus recusou. O arquivo NAO fica no storage.
  INFECTED
  /// Extracao rodou; ha campos esperando revisao humana (INV-103).
  EXTRACTED
  /// Extrator falhou. A avaliacao manual continua funcionando (INV-140).
  FAILED
  /// Revisada e convertida em avaliacao. Terminal.
  CONFIRMED
  /// Descartada pelo avaliador sem virar avaliacao. Terminal.
  DISCARDED

  @@map("assessment_import_status")
}

/// O que o avaliador decidiu sobre um campo extraido (F19).
enum ImportedFieldState {
  /// Ainda nao revisado. NAO vira medida.
  PENDING
  /// O valor do OCR esta certo.
  CONFIRMED
  /// O avaliador digitou outro valor; o do OCR fica guardado.
  CORRECTED
  /// Nao e medida valida -- ruido do OCR, campo que o aparelho nao mediu.
  DISCARDED

  @@map("imported_field_state")
}

/// Arquivo importado para virar avaliacao (`M3-FR-009`, F19, Slice 3.3).
///
/// ---------------------------------------------------------------------------
/// A IMPORTACAO NAO E UMA AVALIACAO. ELA VIRA UMA, DEPOIS DE REVISADA.
/// ---------------------------------------------------------------------------
///
/// Tabela separada de `body_assessments` porque `M3-BR-006` e INV-103 exigem
/// confirmacao humana ANTES de o dado existir como historico. Gravar direto
/// na avaliacao com um flag "revisada" faria o valor do OCR ja estar no
/// grafico esperando alguem desmarcar -- e um esquecimento viraria dado
/// oficial.
///
/// `assessmentId` so e preenchido na confirmacao: ate la, a importacao existe
/// e a avaliacao nao.
model AssessmentImport {
  id        String                 @id @default(uuid()) @db.Uuid
  tenantId  String                 @map("tenant_id") @db.Uuid
  studentId String                 @map("student_id") @db.Uuid
  status    AssessmentImportStatus @default(RECEIVED)

  /// Nome que o arquivo tinha no computador de quem enviou. Guardado para a
  /// tela; NUNCA usado para decidir tipo -- extensao e controlada por quem
  /// envia (ver `aceitarArquivo`).
  originalFilename String  @map("original_filename")
  /// Tipo REAL, decidido pela assinatura nos primeiros bytes.
  fileType         String  @map("file_type")
  fileSizeBytes    Int     @map("file_size_bytes")
  /// Chave no storage privado. Fica NULA quando o arquivo e expurgado apos a
  /// confirmacao (`M3-NFR` -- temporarios tem retencao curta e delecao
  /// verificavel), sem que a linha morra: o historico de que houve
  /// importacao e o que a auditoria consulta.
  objectKey        String? @map("object_key")

  /// Veredito do antivirus. Nulo enquanto nao escaneou.
  scanResult    String? @map("scan_result")
  /// Qual implementacao extraiu (`csv@1`, `fake-ocr@1`). Auditoria.
  extractor     String?
  /// Por que falhou, quando `FAILED` ou `INFECTED`.
  failureReason String? @map("failure_reason")

  /// Quem enviou o arquivo.
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  /// Quem confirmou a revisao. Nulo ate a confirmacao -- e o registro de que
  /// um HUMANO decidiu (INV-103).
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at")

  /// A avaliacao que nasceu desta importacao. Nula ate a confirmacao.
  assessmentId String? @map("assessment_id") @db.Uuid

  /// Agrupa os arquivos da MESMA medicao. Todos os arquivos de uma sessao
  /// confirmam juntos e produzem UMA avaliacao.
  reviewSessionId String? @map("review_session_id") @db.Uuid
  /// Rotulo de origem exibido na revisao (`CF610_G`, `Unique Health`,
  /// `ECG 30s`). Derivado do conteudo, nunca do nome do arquivo.
  sourceLabel     String? @map("source_label")

  /// Dado do APARELHO que o extrator separa em `atributos` (Task 6): achado
  /// de ECG, tags, duracao -- OPACO de proposito (ADR-035), nunca
  /// interpretado. Guardado aqui, POR ARQUIVO, porque a extracao e a
  /// confirmacao nao coincidem numa sessao com varios arquivos; na
  /// confirmacao ele migra para `BodyAssessment.deviceReport`.
  extractedAttributes Json? @map("extracted_attributes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation("ImportUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("ImportReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  assessment BodyAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  fields     ImportedField[]

  /// ⚠️ UMA SESSAO PRODUZ NO MAXIMO UMA AVALIACAO -- mas a garantia NAO mora
  /// nesta tabela (fix Task 5 round 2, achado ao rodar contra Postgres real
  /// pela primeira vez). Uma tentativa de indice parcial AQUI
  /// (`ON assessment_imports (review_session_id) WHERE assessment_id IS NOT
  /// NULL`) parecia certa mas quebrava toda sessao com mais de UM arquivo:
  /// as N linhas de uma sessao PRECISAM compartilhar o mesmo
  /// `review_session_id` com `assessment_id` preenchido depois de
  /// confirmadas, e um indice UNIQUE por linha nao consegue expressar "N
  /// linhas legitimas, mas so uma origem por avaliacao".
  ///
  /// A garantia real mora em `BodyAssessment.sourceReference`, ver o indice
  /// parcial `body_assessments_import_source_reference_uq` em
  /// `migrations/20260821250000_sessao_idempotente_fix_indice` e o comentario
  /// de `AvaliacaoJaExisteParaOrigemError` (`domain/avaliacao.ts`) -- cada
  /// tentativa de confirmacao cria EXATAMENTE UMA `BodyAssessment`, e e ali
  /// que a unicidade por origem (sessao ou import avulso) faz sentido.
  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, reviewSessionId])
  @@map("assessment_imports")
}

/// Um campo extraido de um arquivo, com o estado da revisao (`M3-FR-010`).
///
/// ---------------------------------------------------------------------------
/// O VALOR DO EXTRATOR NUNCA E SOBRESCRITO.
/// ---------------------------------------------------------------------------
///
/// `extracted_value` e o que a maquina leu; `reviewed_value` e o que o humano
/// decidiu. Guardar so um deles destruiria a proveniencia que o aceite da
/// Slice 3.3 exige ("a proveniencia permanece visivel") -- e sem ela ninguem
/// consegue, meses depois, descobrir que o OCR lia virgula errado num
/// modelo especifico de laudo.
model ImportedField {
  id       String              @id @default(uuid()) @db.Uuid
  tenantId String              @map("tenant_id") @db.Uuid
  importId String              @map("import_id") @db.Uuid
  type     BodyMeasurementType
  state    ImportedFieldState  @default(PENDING)

  /// O que a maquina leu. Nulo quando o extrator marcou o campo como ilegivel.
  extractedValue Decimal?         @map("extracted_value") @db.Decimal(10, 4)
  extractedUnit  MeasurementUnit? @map("extracted_unit")
  /// 0..1 quando o extrator informa. NULO quando ele nao mede confianca
  /// (parser de CSV) -- e `null` NAO e zero: zero significaria "o extrator
  /// acha que errou" e ordenaria a fila como o campo mais suspeito do laudo.
  confidence     Decimal?         @db.Decimal(5, 4)
  /// Pagina e linha, quando o extrator informa.
  sourceLocation String?          @map("source_location")

  /// O que o humano decidiu. Preenchido quando `CORRECTED`.
  reviewedValue Decimal?         @map("reviewed_value") @db.Decimal(10, 4)
  reviewedUnit  MeasurementUnit? @map("reviewed_unit")

  /// De qual arquivo veio este campo. E a coluna "Origem" da tela.
  sourceLabel String? @map("source_label")

  /// Quando outro arquivo trouxe o MESMO tipo com valor equivalente, este
  /// campo aponta para o primeiro e nao vira linha propria na revisao.
  /// Divergencia NUNCA e deduplicada: fica como duas linhas para o humano
  /// escolher.
  agreesWithFieldId String? @map("agrees_with_field_id") @db.Uuid

  /// Faixa de referencia VIGENTE no laudo, guardada junto da medida: ela e
  /// do fabricante e muda com firmware. Em tabela global, a leitura de
  /// agosto deixaria de fazer sentido em dezembro.
  referenceMin    Decimal? @map("reference_min") @db.Decimal(10, 4)
  referenceMax    Decimal? @map("reference_max") @db.Decimal(10, 4)
  /// Percentual do padrao que o aparelho reporta (233,3% no braco direito).
  standardPercent Decimal? @map("standard_percent") @db.Decimal(7, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  import AssessmentImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, state])
  @@index([importId, agreesWithFieldId])
  @@map("imported_fields")
}

/// Estado de moderacao do apelido publico.
enum PublicProfileStatus {
  /// Aguardando moderacao. Enquanto isso, o aluno aparece pelo primeiro nome.
  PENDING
  APPROVED
  REJECTED
  /// Ocultado depois de aprovado -- denuncia, revisao, mudanca de politica.
  HIDDEN

  @@map("public_profile_status")
}

/// Como o aluno escolheu aparecer.
enum PublicIdentityChoice {
  PRIMEIRO_NOME
  APELIDO
  ANONIMO

  @@map("public_identity_choice")
}

/// Razao CATEGORIZADA de recusa. Enum, nunca texto livre: texto livre vira
/// PII e vira inconsistencia entre moderadores.
enum AliasRejectionReason {
  OFENSIVO
  CONTEM_PII
  IMPERSONACAO
  SPAM_OU_PROPAGANDA
  ILEGIVEL

  @@map("alias_rejection_reason")
}

/// Identidade publica do aluno no engajamento.
///
/// SEPARADA do cadastro civil de proposito: `Student.name` e nome legal e
/// nunca vira apelido publico por acidente. Uma linha por aluno por tenant;
/// a ausencia dela significa "aparece pelo primeiro nome".
model PublicProfile {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  /// `@unique` sozinho (alem do composto `[tenantId, studentId]` abaixo):
  /// exigencia do Prisma para relacao um-para-um com `Student.publicProfile`.
  /// Nao muda o dado -- aluno pertence a um so tenant, entao unico em
  /// `studentId` e unico em `[tenantId, studentId]` colapsam na mesma regra.
  studentId        String                @unique @map("student_id") @db.Uuid
  identityChoice   PublicIdentityChoice  @default(PRIMEIRO_NOME) @map("identity_choice")
  /// Como o aluno digitou. Exibido so quando `status = APPROVED`.
  alias            String?
  /// Forma canonica (NFKC, minuscula, sem invisivel) -- alimenta o indice
  /// parcial de unicidade. Ver `triagem-de-alias.ts`.
  aliasNormalized  String?               @map("alias_normalized")
  status           PublicProfileStatus   @default(PENDING)
  /// Codigos de sinal da triagem, para o moderador priorizar. Array de
  /// `SinalDeAlias`. NUNCA guarda o motivo em texto livre.
  screeningSignals String[]              @default([]) @map("screening_signals")
  rejectionReason  AliasRejectionReason? @map("rejection_reason")
  moderatedBy      String?               @map("moderated_by") @db.Uuid
  moderatedAt      DateTime?             @map("moderated_at")
  /// Compare-and-swap: o cliente manda a versao que leu, e a escrita falha
  /// se outra edicao passou no meio.
  version          Int                   @default(1)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  moderator User?   @relation(fields: [moderatedBy], references: [id])

  /// Unicidade do alias vive em INDICE PARCIAL sobre `APPROVED`, escrito a
  /// mao na migracao: Prisma nao expressa `WHERE` em @@unique. Indice total
  /// recusaria o segundo PENDING legitimo antes de um moderador olhar.
  @@unique([tenantId, studentId])
  @@index([tenantId, status, createdAt])
  @@map("public_profiles")
}

// ---------------------------------------------------------------------------
// F31 -- XP, conquistas e ranking
// ---------------------------------------------------------------------------

enum XpTrigger {
  /// Uma sessao de treino confirmada no dia local da unidade. A unica do
  /// catalogo v1. Enum e nao string livre: e o que impede regra nova de
  /// chegar como expressao executavel (`M5-RULES-01`, item 4).
  SESSAO_CONFIRMADA

  @@map("xp_trigger")
}

enum XpEntryType {
  GRANT
  ADJUSTMENT
  REVERSAL

  @@map("xp_entry_type")
}

enum XpRuleStatus {
  DRAFT
  APPROVED

  @@map("xp_rule_status")
}

/// Uma versao do catalogo de XP.
///
/// Regra alterada e LINHA NOVA (`M5-BR-009`). A resolucao usa `occurredAt`
/// do FATO, nunca o relogio do processo: evento atrasado e pontuado pela
/// regra que valia quando o aluno treinou.
model XpRuleVersion {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  /// Identificador estavel da regra atraves das versoes (`treino-diario`).
  code          String
  version       Int
  trigger       XpTrigger
  /// INTEIRO. XP nao e dinheiro, mas a mesma razao vale: fracao acumulada
  /// diverge entre a soma e a projecao.
  points        Int
  status        XpRuleStatus @default(APPROVED)
  effectiveFrom DateTime     @map("effective_from")
  /// `null` = vigente. Fechar uma versao e preencher isto, nunca apagar.
  effectiveTo   DateTime?    @map("effective_to")
  createdAt     DateTime     @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries XpLedgerEntry[]

  @@unique([tenantId, code, version])
  @@index([tenantId, trigger, effectiveFrom])
  @@map("xp_rule_versions")
}

/// Origem de um movimento de XP.
enum XpSourceKind {
  /// `StudentAttendanceSession.id` -- a projecao da F24, que ja deduplica
  /// sessao por dia local da unidade.
  ATTENDANCE_SESSION
  /// Ajuste manual do operador. `sourceId` e a chave de idempotencia que o
  /// painel envia.
  MANUAL_ADJUSTMENT

  @@map("xp_source_kind")
}

/// Movimento de XP -- APPEND-ONLY.
///
/// Nunca `UPDATE`, nunca `DELETE`. Correcao e movimento COMPENSATORIO
/// vinculado por `reversesEntryId`, como `AccessEventCorrection` ja faz no
/// MVP 1 (`M1-BR-009`, `M5-FR-007`).
model XpLedgerEntry {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  studentId       String       @map("student_id") @db.Uuid
  type            XpEntryType
  /// Positivo concede, negativo estorna. A soma do ledger E o saldo.
  points          Int
  ruleVersionId   String       @map("rule_version_id") @db.Uuid
  sourceKind      XpSourceKind @map("source_kind")
  /// Id do fato que originou o movimento, no dominio de `sourceKind`.
  ///
  /// STRING, NAO `@db.Uuid`: `MANUAL_ADJUSTMENT` usa a `idempotencyKey` que
  /// o painel envia -- string livre, no mesmo padrao de `DeviceSyncJob`,
  /// `DeviceCommand` e `AccessEvent` nesta base. `@db.Uuid` recusaria essa
  /// chave em runtime.
  sourceId        String       @map("source_id")
  /// Preenchido so em `REVERSAL`: o movimento que este compensa.
  reversesEntryId String?      @map("reverses_entry_id") @db.Uuid
  /// Data do FATO, nao da gravacao. E o que a resolucao de regra le.
  occurredAt      DateTime     @map("occurred_at")
  /// `AAAA-MM` do dia local DA UNIDADE, materializado na escrita.
  ///
  /// Materializado e nao derivado na leitura pelo mesmo motivo que a F24
  /// guarda `sessionDate` como `@db.Date`: reconverter fuso na leitura
  /// aplica o fuso duas vezes, e o placar de agosto ganharia treino de
  /// julho na virada.
  localMonth      String       @map("local_month")
  /// Motivo do ajuste ou da reversao. Obrigatorio para os dois; `null` em
  /// `GRANT`, que tem a regra como justificativa.
  reason          String?
  createdAt       DateTime     @default(now()) @map("created_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student            Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ruleVersion        XpRuleVersion        @relation(fields: [ruleVersionId], references: [id])
  reverses           XpLedgerEntry?       @relation("ReversaoDeXp", fields: [reversesEntryId], references: [id])
  revertidoPor       XpLedgerEntry[]      @relation("ReversaoDeXp")
  achievements       StudentAchievement[]
  disputasCorrigidas EngagementDispute[]

  /// A CHAVE QUE GARANTE `M5-AC-002`.
  ///
  /// Cem replays do mesmo fato colidem nesta linha. A violacao e tratada
  /// como SUCESSO IDEMPOTENTE no service, nao como erro que alimenta
  /// retry infinito. Idempotencia em INDICE e nao em `if`: guarda que le
  /// antes de escrever perde a corrida por construcao -- foi o que a F14,
  /// a F17 e a F18 ja custaram nesta base.
  ///
  /// `type` entra na chave para que a REVERSAL do mesmo fato possa
  /// coexistir com a GRANT que ela compensa.
  @@unique([tenantId, studentId, sourceKind, sourceId, ruleVersionId, type])
  @@index([tenantId, studentId, localMonth])
  @@index([tenantId, localMonth])
  @@map("xp_ledger_entries")
}

/// Saldo do aluno no mes -- PROJECAO, reconstruivel.
///
/// Apagar esta tabela inteira e recalcular do ledger tem de produzir os
/// mesmos numeros (`M5-NFR-002`). Isso e teste, nao promessa.
model StudentXpBalance {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  localMonth  String   @map("local_month")
  points      Int
  entryCount  Int      @map("entry_count")
  /// Instante do ultimo movimento somado. E o criterio 2 do desempate.
  lastEntryAt DateTime @map("last_entry_at")
  rebuiltAt   DateTime @default(now()) @map("rebuilt_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, localMonth])
  @@index([tenantId, localMonth, points])
  @@map("student_xp_balances")
}

enum AchievementCriterionKind {
  /// Numero de sessoes de treino acumuladas, de todos os tempos.
  SESSOES_ACUMULADAS

  @@map("achievement_criterion_kind")
}

enum AchievementStatus {
  UNLOCKED
  /// Revertida. A linha NAO some -- o desbloqueio original continua
  /// visivel com o motivo anexado (`M5-FR-007`).
  REVERSED

  @@map("achievement_status")
}

/// Uma versao da definicao de conquista.
model AchievementDefinitionVersion {
  id            String                   @id @default(uuid()) @db.Uuid
  tenantId      String                   @map("tenant_id") @db.Uuid
  code          String
  version       Int
  /// Texto exibido ao aluno, em pt-BR.
  title         String
  criterionKind AchievementCriterionKind @map("criterion_kind")
  /// Limiar do criterio (10 sessoes, 50 sessoes...).
  threshold     Int
  effectiveFrom DateTime                 @map("effective_from")
  effectiveTo   DateTime?                @map("effective_to")
  createdAt     DateTime                 @default(now()) @map("created_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unlocked StudentAchievement[]

  @@unique([tenantId, code, version])
  @@map("achievement_definition_versions")
}

/// Conquista desbloqueada por um aluno.
model StudentAchievement {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  studentId           String            @map("student_id") @db.Uuid
  definitionVersionId String            @map("definition_version_id") @db.Uuid
  status              AchievementStatus @default(UNLOCKED)
  unlockedAt          DateTime          @map("unlocked_at")
  /// O MOVIMENTO DO LEDGER que provou o criterio.
  ///
  /// `M5-FR-006`: conquista sai de evidencia verificada, nunca de
  /// alegacao do cliente. Sem esta coluna, "desbloqueei" seria uma
  /// afirmacao sem lastro.
  evidenceEntryId     String            @map("evidence_entry_id") @db.Uuid
  reversedAt          DateTime?         @map("reversed_at")
  reversedReason      String?           @map("reversed_reason")

  tenant     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  definition AchievementDefinitionVersion @relation(fields: [definitionVersionId], references: [id])
  evidence   XpLedgerEntry                @relation(fields: [evidenceEntryId], references: [id])

  @@unique([tenantId, studentId, definitionVersionId])
  @@index([tenantId, studentId, status])
  @@map("student_achievements")
}

/// O que um placar mede. F35, ADR-049 Decisao 4.
///
/// Enum e nao expressao, pela mesma razao de `XpTrigger` e `ChallengeMetric`:
/// criterio de classificacao em string livre e regra executavel chegando por
/// dado, e ai `M5-BR-006` (baseline comparavel) vira decoracao.
///
/// EVOLUCAO RELATIVA NAO ESTA AQUI, de proposito. Exige baseline corporal
/// comparavel, que e entrega do MVP 3 e nao existe -- publicar variacao sem
/// baseline e publicar numero que nao significa o que diz. Entra com a
/// fatia que trouxer o baseline, nao antes.
enum RankingCategory {
  /// XP acumulado no mes (F31). O placar que sempre existiu.
  XP_DO_MES
  /// Sessoes confirmadas no mes -- le `StudentAttendanceSession` (F24), a
  /// mesma projecao que o XP le.
  FREQUENCIA
  /// Semanas elegiveis no mes (F32). Premia regularidade, nao volume: quem
  /// treina 3x por semana toda semana ganha de quem treina 15x numa so.
  CONSISTENCIA

  @@map("ranking_category")
}

enum RankingSnapshotStatus {
  DRAFT
  PUBLISHED
  /// Retido: coorte abaixo do minimo (`M5-BR-007`). Nao e erro, e a
  /// politica funcionando.
  WITHHELD

  @@map("ranking_snapshot_status")
}

/// Placar mensal de uma unidade -- IMUTAVEL depois de publicado.
///
/// `M5-AC-007`: regra alterada nao muda snapshot historico. O que este
/// snapshot congela e PONTUACAO E POSICAO; QUEM APARECE e decidido em toda
/// leitura por `resolverExposicao()`.
///
/// Se o nome publico fosse gravado aqui, um aluno que pedisse opt-out
/// depois da publicacao continuaria estampado num artefato imutavel -- e a
/// unica saida seria mutar o que o `M5-AC-007` proibe mutar.
model RankingSnapshot {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  gymUnitId     String                @map("gym_unit_id") @db.Uuid
  localMonth    String                @map("local_month")
  /// O que este placar mede (F35, ADR-049 Decisao 4). Entra na chave unica:
  /// sem ela, so cabia UM placar por unidade e mes, e a categoria nova
  /// colidiria com o XP em vez de conviver.
  ///
  /// Snapshot gerado antes da F35 recebeu `XP_DO_MES` na migration -- e o
  /// que ele sempre mediu, so nao tinha nome.
  category      RankingCategory       @default(XP_DO_MES)
  status        RankingSnapshotStatus @default(DRAFT)
  /// Copiado da configuracao NO MOMENTO da geracao. Mudar a politica
  /// depois nao reescreve o que este snapshot decidiu.
  minimumCohort Int                   @map("minimum_cohort")
  eligibleCount Int                   @map("eligible_count")
  generatedAt   DateTime              @map("generated_at")
  publishedAt   DateTime?             @map("published_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit GymUnit        @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)
  entries RankingEntry[]

  /// UM snapshot por unidade, mes E CATEGORIA. Regerar e substituir o
  /// DRAFT; o PUBLISHED nao se regera.
  @@unique([tenantId, gymUnitId, localMonth, category])
  @@map("ranking_snapshots")
}

/// Uma posicao no placar.
///
/// Guarda `studentId` para AUDITORIA. O DTO publico NUNCA o devolve, e o
/// nome nao mora aqui -- ver o comentario de `RankingSnapshot`.
model RankingEntry {
  id       String @id @default(uuid()) @db.Uuid
  /// F67 (ADR-054 §5): `tenant_id` proprio, e nao JOIN ate ranking_snapshots.
  /// A politica RLS le esta coluna -- politica por JOIN e lenta e fragil.
  tenantId String @map("tenant_id") @db.Uuid

  snapshotId  String   @map("snapshot_id") @db.Uuid
  position    Int
  studentId   String   @map("student_id") @db.Uuid
  points      Int
  /// Instante do ultimo movimento do aluno no mes -- criterio 2 do
  /// desempate, congelado junto com a posicao.
  lastEntryAt DateTime @map("last_entry_at")

  snapshot RankingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, studentId])
  @@unique([snapshotId, position])
  @@index([tenantId])
  @@index([snapshotId, position])
  @@map("ranking_entries")
}

// ---------------------------------------------------------------------------
// F34 -- Desafios e avisos (Slice 5.5, ADR-048)
// ---------------------------------------------------------------------------

/// O que um desafio mede. Enum e nao expressao, pela MESMA razao de
/// `XpTrigger` (`M5-RULES-01`): metrica em string livre e regra executavel
/// chegando por dado, e ai o limite profissional do `M5-BR-011` vira
/// decoracao -- nao ha como validar teto de algo que voce nao sabe o que e.
enum ChallengeMetric {
  /// Numero de sessoes confirmadas na janela. Le
  /// `StudentAttendanceSession` (F24), a mesma projecao que o XP usa.
  SESSOES_NA_JANELA

  @@map("challenge_metric")
}

enum ChallengeStatus {
  /// Criado, ainda nao aberto a inscricao.
  DRAFT
  /// Aceitando inscricao e medindo progresso.
  ACTIVE
  /// Janela terminou. Resultado congelado.
  CLOSED
  /// Encerrado antes da hora pelo operador. Nao produz resultado.
  CANCELLED

  @@map("challenge_status")
}

enum ChallengeParticipantStatus {
  /// Inscrito e em curso.
  JOINED
  /// Saiu por vontade propria. Historico preservado (`M5-FR-014`).
  LEFT
  /// Bateu a meta antes do fim da janela.
  COMPLETED
  /// Janela fechou sem bater a meta.
  FAILED

  @@map("challenge_participant_status")
}

enum ChallengeNoticeKind {
  /// Desafio novo aberto a inscricao na unidade do aluno.
  DISPONIVEL
  /// O aluno bateu a meta.
  CONCLUIDO
  /// A janela fechou sem a meta ser batida.
  ENCERRADO_SEM_META

  @@map("challenge_notice_kind")
}

/// Template de desafio -- VERSIONADO, e a unica origem de desafio
/// (`M5-FR-013`).
///
/// O teto de frequencia mora AQUI, nao no desafio: e o que faz o
/// `M5-BR-011` ser verificavel. Operador escolhe template e janela; nao
/// escreve regra.
///
/// Mesma forma de `XpRuleVersion`: `code` estavel atraves das versoes,
/// `effectiveTo` nulo = vigente, fechar versao e preencher a data -- nunca
/// apagar.
model ChallengeTemplateVersion {
  id       String          @id @default(uuid()) @db.Uuid
  tenantId String          @map("tenant_id") @db.Uuid
  /// Identificador estavel atraves das versoes (`assiduidade-semanal`).
  code     String
  version  Int
  name     String
  metric   ChallengeMetric

  /// Teto de sessoes por SEMANA que um desafio deste template pode exigir
  /// (`M5-BR-011`). Validado na criacao do desafio, contra a janela real.
  ///
  /// INTEIRO e por semana, nao por janela: janela de 30 dias com meta 30
  /// passaria num teto "por janela" generoso e ainda assim exigiria treino
  /// diario sem descanso.
  maxSessionsPerWeek Int @map("max_sessions_per_week")

  /// Duracao maxima da janela, em dias. Impede desafio perpetuo, que na
  /// pratica e meta sem encerramento e nunca produz resultado.
  maxWindowDays Int @map("max_window_days")

  effectiveFrom DateTime  @map("effective_from")
  /// `null` = vigente.
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  challenges Challenge[]

  @@unique([tenantId, code, version])
  @@index([tenantId, effectiveFrom])
  @@map("challenge_template_versions")
}

/// Um desafio concreto: template + janela + meta.
///
/// COPIA a versao do template ao nascer (`templateVersionId` aponta para a
/// versao, nao para o codigo). Editar o template depois NAO altera desafio
/// em curso -- mesmo principio do `policySnapshot` do entitlement e do
/// snapshot de ranking (`M5-BR-009`): regra que muda nao reescreve o
/// passado.
model Challenge {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  templateVersionId String          @map("template_version_id") @db.Uuid
  /// `null` = vale para o tenant inteiro. Preenchido restringe a unidade.
  gymUnitId         String?         @map("gym_unit_id") @db.Uuid
  title             String
  status            ChallengeStatus @default(DRAFT)

  /// Meta a bater na janela, na unidade da metrica do template.
  targetValue Int @map("target_value")

  /// Janela, em dia local DA UNIDADE -- `@db.Date`, nao `DateTime`.
  ///
  /// Mesma razao de `StudentAttendanceSession.sessionDate` (F24): guardar
  /// instante obriga a reconverter fuso na leitura, e fuso aplicado duas
  /// vezes joga o treino da virada para o dia errado. Aqui o efeito seria
  /// contar sessao fora da janela do desafio.
  startsOn DateTime @map("starts_on") @db.Date
  endsOn   DateTime @map("ends_on") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  closedAt  DateTime? @map("closed_at")

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateVersion ChallengeTemplateVersion @relation(fields: [templateVersionId], references: [id])
  gymUnit         GymUnit?                 @relation(fields: [gymUnitId], references: [id])
  participants    ChallengeParticipant[]
  notices         ChallengeNotice[]

  @@index([tenantId, status, startsOn])
  @@index([tenantId, gymUnitId, status])
  @@map("challenges")
}

/// Adesao do aluno a um desafio -- OPT-IN (`M5-BR-001`, ADR-048 Decisao 2).
///
/// ATENCAO: a AUSENCIA desta linha significa NAO INSCRITO. E o oposto de
/// `participaDoRanking()` (F30), onde ausencia significa PARTICIPA.
///
/// NAO unifique os dois predicados. A diferenca e de REGIME: ranking e
/// exposicao de algo que ja acontece (opt-out); desafio e compromisso que o
/// aluno assume (opt-in). Um predicado servindo aos dois passa verde
/// enquanto nenhum teste misturar os casos -- e ai ou o aluno vira
/// participante de um desafio que nunca aceitou, ou some do ranking.
model ChallengeParticipant {
  id          String                     @id @default(uuid()) @db.Uuid
  tenantId    String                     @map("tenant_id") @db.Uuid
  challengeId String                     @map("challenge_id") @db.Uuid
  studentId   String                     @map("student_id") @db.Uuid
  status      ChallengeParticipantStatus @default(JOINED)

  joinedAt    DateTime  @default(now()) @map("joined_at")
  /// Preenchido em `LEFT`. A linha NAO e apagada: `M5-FR-014` manda manter
  /// o historico, e apagar tambem perderia a prova de que houve adesao.
  leftAt      DateTime? @map("left_at")
  completedAt DateTime? @map("completed_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Uma adesao por aluno por desafio.
  ///
  /// Em INDICE e nao em `if`: guarda que le antes de escrever perde a
  /// corrida por construcao -- custo ja pago pela F14, F17, F18 e F31 nesta
  /// base. Reinscricao depois de sair reusa esta linha (volta a `JOINED`),
  /// nao cria a segunda.
  @@unique([challengeId, studentId])
  @@index([tenantId, studentId, status])
  @@map("challenge_participants")
}

/// Aviso de desafio -- exibido na area do aluno no totem.
///
/// NAO E ENVIO. Nao ha canal externo nesta fatia (ADR-048, Decisao 3): sem
/// envio nao ha quiet hours, nao ha orcamento de contato e nao ha fronteira
/// transacional x marketing -- essas perguntas so se colocam quando existir
/// canal, e `ENGAGEMENT_PUSH` segue dormente ate la.
///
/// O aviso e ESCRITO quando o fato acontece e LIDO quando o aluno se
/// identifica. Materializar em vez de derivar na leitura porque o aviso
/// precisa sobreviver ao fato: quem completou o desafio em marco tem de ver
/// o aviso na proxima vez que aparecer, mesmo que a janela ja tenha
/// fechado.
model ChallengeNotice {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  challengeId String              @map("challenge_id") @db.Uuid
  studentId   String              @map("student_id") @db.Uuid
  kind        ChallengeNoticeKind
  createdAt   DateTime            @default(now()) @map("created_at")
  /// `null` = nao lido. Preenchido quando o aluno ve o aviso no totem.
  readAt      DateTime?           @map("read_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Um aviso de cada tipo por aluno por desafio.
  ///
  /// Sem isto, reprocessar o encerramento gera um aviso novo a cada
  /// execucao e o aluno abre o totem com a mesma mensagem repetida N vezes.
  /// Idempotencia em INDICE, como no ledger de XP.
  @@unique([challengeId, studentId, kind])
  @@index([tenantId, studentId, readAt])
  @@map("challenge_notices")
}

// ---------------------------------------------------------------------------
// F35 -- Operacao, moderacao e experimento (Slice 5.6, ADR-049)
//
// A fatia nao cria mecanismo de engajamento novo: da a secretaria o poder de
// CORRIGIR os que ja existem sem abrir o banco. O aceite e literal --
// "equipe corrige pontuacao e remove exposicao sem editar banco diretamente".
//
// Nao ha segundo ator (ADR-049, Decisao 2). Correcao acima do teto RECUSA,
// nunca enfileira -- mesmo precedente de `BillingSettings.refundLimitMinor`.
// ---------------------------------------------------------------------------

/// Sobre o que o aluno esta reclamando.
///
/// Enum, nao texto livre: a resolucao precisa saber qual mecanismo revisar, e
/// "categoria" derivada de string do aluno e triagem por adivinhacao.
enum EngagementDisputeSubject {
  /// Pontos que nao apareceram, ou apareceram errados.
  XP
  /// Conquista que o aluno acha que desbloqueou e nao veio.
  CONQUISTA
  /// Semana que deveria contar para o streak e nao contou.
  CONSISTENCIA
  /// Posicao no placar.
  RANKING
  /// Progresso ou resultado de desafio.
  DESAFIO

  @@map("engagement_dispute_subject")
}

enum EngagementDisputeStatus {
  /// Aberta pelo aluno, ninguem olhou.
  ABERTA
  /// Resolvida com correcao aplicada no ledger.
  CORRIGIDA
  /// Analisada e o sistema estava certo. Nao e derrota do aluno: e resposta.
  IMPROCEDENTE

  @@map("engagement_dispute_status")
}

/// Contestacao de engajamento -- `M5-FR-016`.
///
/// O aluno abre no totem; a secretaria resolve no painel. A linha NUNCA e
/// apagada nem reaberta: resolver grava desfecho, ator e instante, e a
/// contestacao vira historico. Reabrir seria apagar a trilha de quem decidiu.
///
/// A correcao que resolve a contestacao mora no LEDGER, nao aqui -- este
/// modelo aponta para ela (`correctionEntryId`) em vez de duplicar o valor.
/// Duplicar produziria duas verdades sobre quantos pontos foram devolvidos.
model EngagementDispute {
  id        String                   @id @default(uuid()) @db.Uuid
  tenantId  String                   @map("tenant_id") @db.Uuid
  studentId String                   @map("student_id") @db.Uuid
  subject   EngagementDisputeSubject
  /// O que o aluno escreveu. Sem PII de saude: e campo de reclamacao sobre
  /// pontuacao, nao prontuario.
  descricao String
  status    EngagementDisputeStatus  @default(ABERTA)

  /// Quem resolveu, quando e por que. Nulos enquanto `ABERTA`.
  resolvedBy        String?   @map("resolved_by") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at")
  /// Resposta da secretaria -- obrigatoria ao resolver, nos DOIS desfechos.
  /// Improcedente sem explicacao e silencio com carimbo.
  resolucao         String?
  /// O movimento de XP que corrigiu, quando houve correcao. Aponta, nao copia.
  correctionEntryId String?   @map("correction_entry_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Sem cascade: preserva QUEM resolveu mesmo se o usuario sair da academia.
  resolver   User?          @relation(fields: [resolvedBy], references: [id])
  correction XpLedgerEntry? @relation(fields: [correctionEntryId], references: [id])

  /// A fila do painel le por aqui: abertas primeiro, mais antigas no topo.
  @@index([tenantId, status, createdAt])
  @@index([tenantId, studentId, createdAt])
  @@map("engagement_disputes")
}

// ===========================================================================
// RETENCAO -- contrato de dados e baseline analitica (F36, SPEC-036, Slice 6.1)
// ===========================================================================

/// Por que uma feature nao tem valor. AUSENTE NAO E ZERO -- `M6-BR-002` e o
/// PRD §9. Sem este enum, `0` teria de servir para "faltou o mes inteiro" e
/// para "entrou ontem", e a fila de retencao ligaria para o recem-matriculado.
enum RetentionMissingReason {
  /// Nao ha fato suficiente na janela. Caso comum e benigno: aluno novo.
  NO_HISTORY
  /// A fonte nao respondeu na materializacao. Degrada a completude.
  SOURCE_UNAVAILABLE
  /// Nao se aplica a este aluno (ex.: plano sem termino previsto).
  NOT_APPLICABLE
  /// Opt-out ou supressao vigente proibe usar o dado -- `M6-FR-006`.
  SUPPRESSED

  @@map("retention_missing_reason")
}

/// De onde veio o valor de uma feature.
///
/// A marca que a decisao do PI de 31/08/2026 exige. O PI decidiu executar a
/// F36 com "aceite relaxado"; esta coluna e o que impede a decisao de
/// contaminar em silencio o modelo da F40: `CURRENT_STATE` pode violar
/// `M6-FR-003` (informacao futura) sem que nenhum teste perceba -- a feature
/// acerta no backtest justamente porque enxergou o futuro. Marcada, a F40 a
/// exclui do treino com um filtro; nao marcada, seria preciso refazer esta
/// fatia para descobrir em quais features confiar.
enum RetentionFeatureProvenance {
  /// So fatos datados e imutaveis. Recalcular amanha da o mesmo numero.
  AS_OF
  /// Depende de campo mutavel sem trilha. Reproduzivel apenas por acaso.
  CURRENT_STATE

  @@map("retention_feature_provenance")
}

/// Versao do alvo: populacao, janelas e horizonte (`M6-FR-001`).
///
/// Versionar e o que impede comparacao invalida: o PRD §3 diz que "mudanca
/// nessa definicao cria nova versao de target e invalida comparacao direta".
/// Sem esta tabela, trocar a janela de 90 para 60 dias mudaria em silencio o
/// significado de todo snapshot ja gravado.
model RetentionTargetVersion {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Identificador legivel, ex.: `alvo@1`. E o que aparece no snapshot.
  label String

  /// Janela de features, em dias (PRD §3: 90).
  featureWindowDays Int @map("feature_window_days")
  /// Horizonte de previsao, em dias (PRD §3: 30).
  predictionDays    Int @map("prediction_days")
  /// Dias sem reativacao que confirmam o churn (PRD §3: 30).
  confirmationDays  Int @map("confirmation_days")

  /// Congelada: versao em uso nao muda mais, cria-se outra.
  frozenAt  DateTime? @map("frozen_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshots StudentFeatureSnapshot[]

  @@unique([tenantId, label])
  @@map("retention_target_versions")
}

/// Versao do catalogo de features (`M6-FR-001`).
///
/// Separada do alvo de proposito: acrescentar uma feature nao muda a definicao
/// de churn, e forcar as duas a andarem juntas invalidaria historico sem
/// motivo.
model RetentionFeatureSetVersion {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Identificador legivel, ex.: `features@1`.
  label String

  /// Os nomes das features desta versao, na ordem do PRD §9.
  featureNames String[] @map("feature_names")

  frozenAt  DateTime? @map("frozen_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshots StudentFeatureSnapshot[]

  @@unique([tenantId, label])
  @@map("retention_feature_set_versions")
}

/// O snapshot diario de features de um aluno (`M6-FR-002`).
///
/// IMUTAVEL por (tenant, aluno, observacao, alvo, catalogo, revisao). Correcao
/// autorizada cria REVISAO nova; ninguem sobrescreve uma linha -- sobrescrever
/// apagaria a evidencia de que o pipeline nao era reproduzivel, que e
/// exatamente o que se quer descobrir.
model StudentFeatureSnapshot {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  studentId           String @map("student_id") @db.Uuid
  targetVersionId     String @map("target_version_id") @db.Uuid
  featureSetVersionId String @map("feature_set_version_id") @db.Uuid

  /// O dia que o snapshot descreve.
  observedAt        DateTime @map("observed_at")
  /// Ate quando o sistema podia SABER. Separado de `observedAt` para que a
  /// reconstrucao auditada possa refazer "a quarta como ela era na quarta".
  knowledgeCutoffAt DateTime @map("knowledge_cutoff_at")
  /// Correcao autorizada incrementa; a revisao 1 nunca e sobrescrita.
  revision          Int      @default(1)

  /// Fracao de features observadas, em `[0, 1]`. E CONFIANCA, nao risco --
  /// `M6-BR-002`: ausencia reduz completude, nunca aumenta risco.
  completeness Decimal @db.Decimal(5, 4)

  /// Hash do texto canonico. Reconstruir o mesmo recorte tem de bater; a
  /// divergencia vira `SNAPSHOT_NAO_DETERMINISTICO`, nunca sobrescrita.
  checksum String

  createdAt DateTime @default(now()) @map("created_at")

  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetVersion     RetentionTargetVersion     @relation(fields: [targetVersionId], references: [id])
  featureSetVersion RetentionFeatureSetVersion @relation(fields: [featureSetVersionId], references: [id])
  values            StudentFeatureValue[]
  retentionScores   RetentionScore[]
  retentionSkip     RetentionScoreSkip?

  @@unique([tenantId, studentId, observedAt, targetVersionId, featureSetVersionId, revision])
  @@index([tenantId, observedAt])
  @@index([tenantId, studentId, observedAt])
  @@map("student_feature_snapshots")
}

/// O valor de uma feature dentro do snapshot.
///
/// Linha por feature, e nao um JSON: o dashboard de cobertura agrega POR
/// feature ("quantos alunos tem `days_past_due` ausente?"), e isso e um
/// `GROUP BY` numa tabela contra varredura de JSON em toda linha. `value` e
/// nulo sempre que `missingReason` esta preenchida -- a distincao de
/// `M6-BR-002` chega ate o banco.
model StudentFeatureValue {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  snapshotId String @map("snapshot_id") @db.Uuid

  name String

  /// `null` quando ausente. NUNCA zero por omissao.
  value         Decimal?                   @db.Decimal(18, 6)
  missingReason RetentionMissingReason?    @map("missing_reason")
  provenance    RetentionFeatureProvenance @default(AS_OF)

  snapshot StudentFeatureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, name])
  /// O dashboard de qualidade le por aqui.
  @@index([tenantId, name, missingReason])
  @@map("student_feature_values")
}

// ---------------------------------------------------------------------------
// F37 -- Regras explicaveis e score (Slice 6.2)
// ---------------------------------------------------------------------------

/// Para que lado uma regra empurra o risco.
///
/// `DECREASE` existe porque o PRD §7 pede "fatores positivos/negativos": sem
/// ele a tela lista so motivos de alarme, e a recepcao nunca ve que o aluno
/// treinou vinte dias no mes.
enum RetentionRuleDirection {
  INCREASE
  DECREASE

  @@map("retention_rule_direction")
}

/// Os operadores que uma regra pode usar. ALLOWLIST FECHADA.
///
/// Enum de banco, e nao texto livre, porque regra vinda do banco e DADO -- dado
/// que vira expressao executavel e execucao remota, e expressao arbitraria
/// quebra `M6-AC-002` (o mesmo snapshot deixaria de dar o mesmo score).
enum RetentionRuleOperator {
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  /// Para a feature de variacao, que ja chega como razao (`-1` parou).
  PERCENT_DROP_AT_LEAST

  @@map("retention_rule_operator")
}

/// As quatro faixas do PRD §16.
enum RetentionRiskBand {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("retention_risk_band")
}

/// Quem calculou o score.
///
/// A baseline e o unico provider desta fatia. A coluna existe desde ja para que
/// a F40 grave ao lado sem migrar de novo, e para que a comparacao
/// champion/challenger/baseline (`M6-FR-016`) seja um `GROUP BY`.
enum RetentionScoreProvider {
  RULE_BASELINE
  SUPERVISED_MODEL

  @@map("retention_score_provider")
}

/// Por que um aluno nao foi pontuado (`M6-FR-006`).
enum RetentionIneligibilityReason {
  CANCELLED
  SUPPRESSED
  INSUFFICIENT_HISTORY

  @@map("retention_ineligibility_reason")
}

/// Por que um aluno esta fora do scoring, por decisao e nao por estado.
enum RetentionSuppressionReason {
  OPT_OUT
  DELETION_PENDING
  /// `M6-BR-007` nao aceita supressao manual sem motivo -- o texto e obrigatorio.
  MANUAL_WITH_REASON

  @@map("retention_suppression_reason")
}

/// Uma versao CONGELADA do catalogo de regras (`M6-FR-001`, `M6-FR-004`).
///
/// Mesma forma das versoes da F36 (`label` + `frozenAt` + unique por tenant), e
/// pelo mesmo motivo: mudar um peso muda o significado de todo score ja gravado.
/// Editar regra de versao congelada nao e permitido -- cria-se outra versao, e o
/// score antigo continua explicavel pelas regras que o produziram.
model RetentionRuleVersion {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Identificador legivel, ex.: `regras@1`.
  label String

  /// Os pisos das faixas, do maior para o menor. Versionados JUNTO das regras:
  /// mover o corte de ALTO muda quem entra na fila sem mudar nenhum peso.
  criticalFloor Int @default(75) @map("critical_floor")
  highFloor     Int @default(50) @map("high_floor")
  mediumFloor   Int @default(25) @map("medium_floor")

  /// Abaixo disto o snapshot sabe pouco demais para ordenar uma fila.
  /// E limiar de CONFIANCA, nao de risco -- `M6-BR-002`.
  minimumCompleteness Decimal @default(0.3) @map("minimum_completeness") @db.Decimal(5, 4)

  frozenAt  DateTime? @map("frozen_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules  RetentionRule[]
  scores RetentionScore[]

  @@unique([tenantId, label])
  @@map("retention_rule_versions")
}

/// Uma regra do catalogo. Tupla fechada, nunca expressao.
model RetentionRule {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  ruleVersionId String @map("rule_version_id") @db.Uuid

  /// A feature do snapshot que esta regra observa. Uma das 13 do PRD §9.
  featureName String                @map("feature_name")
  operator    RetentionRuleOperator
  threshold   Decimal               @db.Decimal(18, 6)

  /// Quanto soma ao score quando dispara. Positivo; a direcao da o sinal.
  weight    Int
  direction RetentionRuleDirection

  /// O texto que a recepcao le. Versionado junto: mudar a redacao de uma regra
  /// ja usada reescreveria a explicacao de score passado.
  label String

  ruleVersion RetentionRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  /// Uma regra por (versao, feature, operador, limite): duplicata silenciosa
  /// contaria o mesmo motivo duas vezes no score.
  @@unique([ruleVersionId, featureName, operator, threshold])
  @@index([tenantId, ruleVersionId])
  @@map("retention_rules")
}

/// O score de um aluno num snapshot (`M6-FR-005`).
///
/// APPEND-ONLY, como o snapshot da F36. Recalcular com regra nova nao reescreve
/// o score antigo: a evolucao do risco (PRD §16) e a serie desses registros, e
/// sobrescrever apagaria justamente a linha do tempo que a tela mostra.
model RetentionScore {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  studentId     String @map("student_id") @db.Uuid
  snapshotId    String @map("snapshot_id") @db.Uuid
  ruleVersionId String @map("rule_version_id") @db.Uuid

  provider RetentionScoreProvider @default(RULE_BASELINE)

  /// Inteiro em `[0, 100]`. ORDENACAO, nao probabilidade.
  value Int
  band  RetentionRiskBand

  /// Fracao de features observadas no snapshot pontuado. CONFIANCA, nao risco.
  completeness Decimal @db.Decimal(5, 4)

  /// `null` na baseline, sempre. PRD §16: "nao mostrar probabilidades com falsa
  /// precisao quando nao calibradas". A coluna existe nula para a F40 preencher
  /// sem migrar, e para a tela ja saber esconder o numero quando falta.
  calibratedProbability Decimal? @map("calibrated_probability") @db.Decimal(5, 4)

  /// O dia que o snapshot descreve. Copiado do snapshot para que a fila ordene
  /// e pagine sem juntar tabela -- `M6-NFR-004` pede p95 < 1s.
  observedAt   DateTime @map("observed_at")
  calculatedAt DateTime @default(now()) @map("calculated_at")

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  snapshot    StudentFeatureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  ruleVersion RetentionRuleVersion   @relation(fields: [ruleVersionId], references: [id])
  factors     RetentionScoreFactor[]
  task        RetentionTask?

  /// A chave de idempotencia de `M6-NFR-002`. Reexecutar a mesma versao sobre o
  /// mesmo snapshot nao duplica -- e quem garante e o indice, nao um `if` no
  /// codigo: dois workers passam juntos por qualquer leitura antes do commit.
  @@unique([snapshotId, provider, ruleVersionId])
  /// A fila le por aqui: risco alto primeiro, dentro do dia.
  @@index([tenantId, observedAt, value])
  @@index([tenantId, studentId, calculatedAt])
  @@map("retention_scores")
}

/// Um fator da explicacao: a regra que disparou e o valor que a fez disparar.
///
/// O valor observado e gravado JUNTO. Sem ele a explicacao diz "cobranca
/// vencida" e a recepcao nao pode contestar; com ele diz "vencida ha 41 dias", e
/// contestar vira conferir um numero.
model RetentionScoreFactor {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  scoreId  String @map("score_id") @db.Uuid

  /// O que a regra observou. Guardado porque a regra pode ser de outra versao
  /// que o leitor nao tem em maos.
  ruleId        String                 @map("rule_id") @db.Uuid
  featureName   String                 @map("feature_name")
  observedValue Decimal                @map("observed_value") @db.Decimal(18, 6)
  contribution  Int
  direction     RetentionRuleDirection
  label         String

  /// Ordem de exibicao, 1 a 5. Persistida para a tela nao reordenar sozinha.
  position Int

  score RetentionScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@unique([scoreId, position])
  @@index([tenantId, featureName])
  @@map("retention_score_factors")
}

/// A decisao de nao pontuar, registrada (`M6-FR-006`).
///
/// Existe como LINHA, e nao como ausencia de score, porque "nao pontuado" e
/// indistinguivel de "o job nao rodou" quando nao ha registro -- e as duas
/// exigem acoes opostas da operacao.
model RetentionScoreSkip {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  studentId  String @map("student_id") @db.Uuid
  snapshotId String @map("snapshot_id") @db.Uuid

  reason RetentionIneligibilityReason

  observedAt DateTime @map("observed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  snapshot StudentFeatureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId])
  @@index([tenantId, observedAt, reason])
  @@map("retention_score_skips")
}

/// Supressao vigente: o aluno esta fora do scoring por decisao.
model RetentionSuppression {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  reason RetentionSuppressionReason

  /// Obrigatorio quando `MANUAL_WITH_REASON` -- `M6-BR-007`. O CHECK esta na
  /// migration: o Prisma nao expressa condicional entre colunas.
  note String?

  startsAt DateTime  @default(now()) @map("starts_at")
  /// `null` = sem prazo. Supressao expirada deixa de valer sem apagar a linha.
  endsAt   DateTime? @map("ends_at")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, endsAt])
  @@map("retention_suppressions")
}

// ---------------------------------------------------------------------------
// F38 -- CRM de retencao (Slice 6.3)
// ---------------------------------------------------------------------------

/// Em que ponto a tarefa esta.
///
/// As tres terminais sao distintas de proposito: `COMPLETED` teve contato,
/// `DISMISSED` foi descartada por uma pessoa com motivo, `EXPIRED` estourou o
/// SLA sem ninguem tocar. Colapsa-las esconderia a metrica que diz se a fila
/// esta grande demais para a equipe.
enum RetentionTaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  DISMISSED
  EXPIRED

  @@map("retention_task_status")
}

/// O que aconteceu quando alguem tratou a tarefa (`M6-FR-010`).
///
/// `CHANNEL_UNAVAILABLE` nao e detalhe: com WhatsApp como canal unico (decisao
/// do PI em 31/08/2026), aluno sem numero cadastrado e caso real e frequente, e
/// precisa ser distinguivel de `NO_ANSWER` -- um diz "tente outro caminho", o
/// outro "tente de novo mais tarde".
///
/// `RESOLVED_OTHER` cobre o aluno que voltou a treinar sozinho antes da
/// ligacao: resultado bom que NAO veio da intervencao, e conta-lo como
/// `CONTACTED` inflaria o efeito medido do CRM na Slice 6.4.
enum RetentionTaskResult {
  CONTACTED
  NO_ANSWER
  CHANNEL_UNAVAILABLE
  DECLINED
  FOLLOW_UP
  RESOLVED_OTHER

  @@map("retention_task_result")
}

/// Por onde o contato foi feito.
///
/// O ArenaHub **nao envia nada** -- `M6-BR-007` e `M6-AC-010`. Este enum
/// registra o que a pessoa fez por fora, e por isso e um campo de REGISTRO, nao
/// de integracao. O PI fixou WhatsApp como canal unico em 31/08/2026; os outros
/// entram quando a operacao pedir.
enum RetentionContactChannel {
  WHATSAPP

  @@map("retention_contact_channel")
}

/// Quanto a equipe de uma unidade consegue tratar por dia (`M6-BR-005`).
///
/// Por UNIDADE, e nao por tenant: a academia da matriz e a do bairro nao tem a
/// mesma recepcao, e um numero unico condenaria uma das duas -- ou fila que
/// ninguem alcanca, ou fila menor do que a equipe daria conta.
model RetentionCapacityPolicy {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  /// `@unique` na coluna, e nao composto com o tenant: a unidade ja pertence a
  /// um tenant so, entao unicidade por unidade E unicidade por (tenant,
  /// unidade) -- e a forma simples e a que o Prisma aceita no lado 1-1.
  gymUnitId String @unique @map("gym_unit_id") @db.Uuid

  /// Tarefas por dia. Decisao do PI em 31/08/2026: 20.
  dailyCapacity   Int @default(20) @map("daily_capacity")
  /// Dias ate o mesmo aluno poder gerar nova tarefa. Decisao do PI: 14.
  cooldownDays    Int @default(14) @map("cooldown_days")
  /// Dias UTEIS ate a tarefa vencer. Decisao do PI: 3.
  slaBusinessDays Int @default(3) @map("sla_business_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit GymUnit @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("retention_capacity_policies")
}

/// A tarefa humana que nasce de um score (`M6-FR-007`).
///
/// LIGA OS QUATRO que o aceite da Slice 6.3 exige: o score que a originou, a
/// estrategia (a acao sugerida), o responsavel e o resultado. Sem o vinculo com
/// `scoreId` a tarefa vira um lembrete solto -- e a pergunta "a retencao
/// funcionou?" deixa de ter resposta, porque nao ha como ligar a intervencao ao
/// risco que a motivou.
model RetentionTask {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  gymUnitId String @map("gym_unit_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  /// O score que originou a tarefa. `Restrict`: apagar o score deixaria a
  /// tarefa sem a explicacao que a justifica.
  scoreId String @map("score_id") @db.Uuid

  /// Qual roteiro de retencao. Uma estrategia por motivo dominante; o cooldown
  /// e por (aluno, estrategia), entao o aluno pode receber contato por queda de
  /// frequencia e, semanas depois, por cobranca vencida.
  strategy String

  status RetentionTaskStatus @default(OPEN)

  /// Quem esta com a tarefa. `null` enquanto `OPEN`.
  assigneeId String? @map("assignee_id") @db.Uuid

  /// Preenchido ao concluir -- obrigatorio pela maquina de estados.
  result        RetentionTaskResult?
  /// Preenchido ao dispensar. O CHECK na migration exige o texto.
  dismissReason String?              @map("dismiss_reason")

  /// Prazo em dias UTEIS a partir da criacao. Vencido, o expirador libera a
  /// vaga de capacidade em vez de segurar o slot indefinidamente.
  dueAt       DateTime  @map("due_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit      GymUnit                @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)
  student      Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        RetentionScore         @relation(fields: [scoreId], references: [id])
  interactions RetentionInteraction[]

  /// Um score gera no maximo uma tarefa. E a idempotencia de `M6-AC-004`:
  /// reprocessar o dia reencontra a chave em vez de duplicar.
  @@unique([scoreId])
  /// A fila le por aqui.
  @@index([tenantId, gymUnitId, status, dueAt])
  @@index([tenantId, studentId, createdAt])
  @@map("retention_tasks")
}

/// Cada tentativa de contato (`M6-FR-010`, `M6-AC-006`).
///
/// APPEND-ONLY, e uma tarefa tem VARIAS: ligar tres vezes ate a pessoa atender
/// sao tres interacoes e uma tarefa. Colapsar em um campo da tarefa perderia o
/// historico de tentativa, que e o que distingue "ninguem tentou" de "tentou
/// tres vezes e nao atenderam" -- diagnosticos opostos para a mesma fila parada.
model RetentionInteraction {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  taskId   String @map("task_id") @db.Uuid

  /// Quem falou. `Restrict` no usuario: apagar quem registrou apagaria a
  /// responsabilidade que `M6-AC-006` exige.
  actorId String @map("actor_id") @db.Uuid

  channel RetentionContactChannel
  result  RetentionTaskResult

  /// O que foi conversado e o que fica combinado. Texto livre porque roteiro
  /// nao cabe em enum -- e o proximo passo e do proximo humano, nao do sistema.
  notes    String?
  nextStep String? @map("next_step")

  occurredAt DateTime @default(now()) @map("occurred_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   RetentionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId, taskId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("retention_interactions")
}

// ---------------------------------------------------------------------------
// F39 -- Experimento operacional (Slice 6.4)
// ---------------------------------------------------------------------------

/// Em que ponto o experimento esta.
///
/// `DRAFT` e o unico estado em que o desenho pode mudar. Depois de `RUNNING`,
/// mexer em semente, fracao ou metrica moveria alunos de grupo -- que e o que
/// `M6-FR-012` proibe.
enum RetentionExperimentStatus {
  DRAFT
  RUNNING
  CLOSED

  @@map("retention_experiment_status")
}

/// Os dois bracos.
///
/// `CONTROL` NUNCA gera tarefa: a fila da F38 pergunta o grupo antes de
/// selecionar. E o custo do experimento -- alunos em risco que ninguem liga, de
/// proposito, para saber se ligar muda alguma coisa.
enum RetentionExperimentGroup {
  CONTROL
  TREATMENT

  @@map("retention_experiment_group")
}

/// O que pode ter dado errado (`M6-AC-011`).
enum RetentionAdverseEffect {
  OPT_OUT
  CANCELLED
  DECLINED
  SUPPRESSION_REQUESTED

  @@map("retention_adverse_effect")
}

/// O experimento, com o desenho CONGELADO ao iniciar (`M6-EXPERIMENT-01`).
///
/// Semente, fracao e janela vivem aqui e nao mudam depois de `RUNNING`. O CHECK
/// da migration recusa a alteracao no proprio banco -- guarda no servico e uma
/// porta, e outro caminho de escrita passaria por fora dela.
model RetentionExperiment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Identificador legivel, ex.: `piloto-retencao@1`.
  label String

  status RetentionExperimentStatus @default(DRAFT)

  /// A semente da randomizacao. POR EXPERIMENTO, e nao global: semente fixa
  /// deixaria o mesmo aluno no controle para sempre, acumulando nas mesmas
  /// pessoas o custo de nunca receber intervencao.
  seed String

  /// Fracao alocada ao controle, em `[0, 1]`. Decisao do PI: 0.2.
  controlFraction Decimal @default(0.2) @map("control_fraction") @db.Decimal(5, 4)

  /// Dias ate medir a metrica primaria. Decisao do PI: 30 (permanencia).
  /// Casa com `predictionDays` do alvo -- medir antes do horizonte de churn
  /// leria ruido como efeito.
  windowDays Int @default(30) @map("window_days")

  startedAt DateTime? @map("started_at")
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant      Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments RetentionExperimentAssignment[]

  @@unique([tenantId, label])
  @@index([tenantId, status])
  @@map("retention_experiments")
}

/// A alocacao de um aluno. APPEND-ONLY e IMUTAVEL (`M6-FR-012`).
///
/// O grupo e VERIFICAVEL: recalcular `sortearGrupo(seed, studentId, fraction)`
/// tem de bater com o que esta gravado. Trocar um aluno de grupo para melhorar
/// o resultado final deixa de ser invisivel -- e isso que o aceite da Slice 6.4
/// ("sem cherry-picking") exige.
///
/// A linha existe para provar QUANDO o aluno entrou, nao para ser a unica fonte
/// da verdade sobre QUAL grupo ele pegou.
model RetentionExperimentAssignment {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  experimentId String @map("experiment_id") @db.Uuid
  studentId    String @map("student_id") @db.Uuid

  assignedGroup RetentionExperimentGroup @map("assigned_group")

  /// Quando entrou. A janela de medicao conta a partir daqui, por aluno --
  /// contar do inicio do experimento mediria janelas diferentes para quem
  /// entrou no primeiro dia e para quem entrou no vigesimo.
  assignedAt DateTime @default(now()) @map("assigned_at")

  experiment RetentionExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Um aluno entra UMA VEZ por experimento. Reprocessar o dia reencontra a
  /// chave em vez de re-sortear -- e re-sortear seria mudanca de grupo.
  @@unique([experimentId, studentId])
  @@index([tenantId, experimentId, assignedGroup])
  @@map("retention_experiment_assignments")
}

/// Um efeito adverso observado na janela (`M6-AC-011`).
///
/// Medido nos DOIS grupos: cancelamento so no tratamento nao diz nada -- aluno
/// em risco cancela de qualquer jeito. O que interessa e a diferenca.
model RetentionExperimentAdverseEvent {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  experimentId String @map("experiment_id") @db.Uuid
  studentId    String @map("student_id") @db.Uuid

  effect RetentionAdverseEffect

  observedAt DateTime @default(now()) @map("observed_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Um efeito por aluno por experimento: o mesmo opt-out registrado duas vezes
  /// e uma pessoa, nao duas, e contar repetido inflaria o dano medido.
  @@unique([experimentId, studentId, effect])
  @@index([tenantId, experimentId, effect])
  @@map("retention_experiment_adverse_events")
}

// ===========================================================================
// MVP 7 -- Plataforma. Plano SaaS e contrato do tenant (F63, ADR-052 §5-§8).
//
// ESTAS TABELAS NAO TEM `tenant_id` COMO ESCOPO DE LEITURA. Sao do ArenaHub
// cobrando a academia -- outro pagador, outro ciclo, outra consequencia que o
// modulo `billing` (aquele e a academia cobrando o aluno). `SaasPlan` e
// `IndexValue` sao globais; `TenantContract` referencia o tenant como ALVO da
// cobranca, e nao como dono da linha. Quem le e o ator de plataforma.
// ===========================================================================

/// Como o plano SaaS cobra a academia -- ADR-052 §5.
enum SaasPricingModel {
  /// Preco por aluno, com valor distinto para ativo e para inativo.
  /// Ativo = `Student.status = ACTIVE`; inativo = todo o resto (ADR-052 §6).
  PER_STUDENT

  /// Valor fixo mensal, corrigido anualmente pelo indice do contrato.
  FIXED_MONTHLY

  @@map("saas_pricing_model")
}

/// Situacao do plano no catalogo. `ARCHIVED` some da lista de escolha e nao
/// pode fechar contrato novo -- contrato JA fechado nele continua valendo,
/// porque contrato guarda copia dos valores (ADR-052 §8).
enum SaasPlanStatus {
  ACTIVE
  ARCHIVED

  @@map("saas_plan_status")
}

/// Situacao do contrato. `DRAFT` e o unico estado editavel; a partir de
/// `ACTIVE` o registro e imutavel (ADR-052 §8) e mudanca de valor exige
/// contrato novo apontando para este pelo `supersedesId`.
enum TenantContractStatus {
  DRAFT
  ACTIVE
  TERMINATED

  @@map("tenant_contract_status")
}

/// Plano SaaS do catalogo -- o que o Super Admin oferece a academia.
///
/// GLOBAL, sem `tenant_id`: e catalogo do dono do SaaS, nao dado de academia.
/// Mesma razao de `Tenant` e `Permission` ficarem fora do escopo de tenant.
///
/// ALTERAR PRECO AQUI NAO TOCA EM CONTRATO ATIVO -- e o aceite da fatia. O
/// contrato copia os valores no fechamento; ler o preco pelo `planId` na hora
/// de faturar reajustaria contrato assinado por efeito colateral de uma
/// edicao de catalogo.
model SaasPlan {
  id    String           @id @default(uuid()) @db.Uuid
  name  String
  model SaasPricingModel

  /// Preco mensal por aluno ATIVO, em centavos. Padrao R$ 5,00 (ADR-052 §5).
  /// Usado so quando `model = PER_STUDENT`; nulo no plano fixo.
  activeStudentPriceMinor   Int? @map("active_student_price_minor")
  /// Preco mensal por aluno INATIVO, em centavos. Padrao R$ 2,50.
  ///
  /// PODE SER ZERO, e isso e deliberado (ADR-052 §6): cobrar lead desestimula
  /// cadastrar lead, e o preco do inativo e negociado por contrato.
  inactiveStudentPriceMinor Int? @map("inactive_student_price_minor")
  /// Valor fixo mensal, em centavos. Usado so quando `model = FIXED_MONTHLY`.
  fixedPriceMinor           Int? @map("fixed_price_minor")

  currency String         @default("BRL")
  status   SaasPlanStatus @default(ACTIVE)

  /// Superficies que fazem parte do plano -- padrao do catalogo, negociavel no
  /// contrato. `true` por padrao porque plano existente JA vende as duas: uma
  /// coluna que nascesse `false` desligaria o totem de quem contratou antes.
  ///
  /// O contrato COPIA estes valores e pode divergir deles (decisao do PI,
  /// 11/09/2026) -- a negociacao acontece no contrato, nao no catalogo.
  mobileEnabled Boolean @default(true) @map("mobile_enabled")
  kioskEnabled  Boolean @default(true) @map("kiosk_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contracts TenantContract[]

  @@index([status])
  @@map("saas_plans")
}

/// Contrato entre o ArenaHub e a academia -- ADR-052 §8.
///
/// REGISTRO IMUTAVEL depois de `ACTIVE`. Os valores sao COPIA do plano no
/// instante do fechamento, e nao referencia viva: `planId` fica para saber de
/// onde veio, mas quem fatura le as colunas daqui.
model TenantContract {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid

  /// Modelo e valores COPIADOS do plano no fechamento. Ver o comentario da
  /// classe: sao estes que a fatura le, nunca os do `SaasPlan`.
  model                     SaasPricingModel
  activeStudentPriceMinor   Int?             @map("active_student_price_minor")
  inactiveStudentPriceMinor Int?             @map("inactive_student_price_minor")
  fixedPriceMinor           Int?             @map("fixed_price_minor")
  currency                  String           @default("BRL")

  /// Superficies contratadas. COPIADAS do plano no rascunho, e editaveis
  /// enquanto `DRAFT` -- e o que o comercial negocia com o cliente.
  ///
  /// Quem RECUSA o acesso le estas colunas, nunca as do `SaasPlan`: mesma regra
  /// dos precos (ver o comentario da classe). `kioskEnabled = false` derruba o
  /// login do totem no `KioskAuthService`; `mobileEnabled` fica gravado sem
  /// executor ate o app do aluno existir (MVP 4) -- vende-se antes de entregar,
  /// e o campo vazio no contrato ja assinado seria pior que o executor
  /// faltando.
  mobileEnabled Boolean @default(true) @map("mobile_enabled")
  kioskEnabled  Boolean @default(true) @map("kiosk_enabled")

  /// Indice de correcao anual. Padrao `IPCA` (ADR-052 §7). Texto e nao enum
  /// porque um indice novo e cadastro, nao migracao.
  indexCode        String   @default("IPCA") @map("index_code")
  /// Data-base dos valores: a competencia a partir da qual o indice acumula.
  baseDate         DateTime @map("base_date") @db.Date
  /// Dia e mes do aniversario do contrato, em que a correcao roda.
  /// Guardado como data completa; so dia e mes sao lidos.
  anniversaryDay   Int      @map("anniversary_day")
  /// Mes do aniversario (1-12).
  anniversaryMonth Int      @map("anniversary_month")

  /// Dias de carencia depois do vencimento antes de suspender o tenant.
  /// Padrao 15 (ADR-052, fatura da plataforma; o gate e a F65).
  graceDays Int @default(15) @map("grace_days")
  /// Dia do mes em que a fatura da plataforma e emitida (1-28).
  /// Limitado a 28 para existir em fevereiro sem regra de excecao -- mesma
  /// razao do `BillingSettings.dueDay`.
  issueDay  Int @map("issue_day")

  startsAt DateTime  @map("starts_at") @db.Date
  endsAt   DateTime? @map("ends_at") @db.Date

  status TenantContractStatus @default(DRAFT)

  /// Contrato que este substitui -- aditivo ou renegociacao (ADR-052 §8).
  /// Nulo no primeiro contrato da academia.
  supersedesId String? @unique @map("supersedes_id") @db.Uuid

  /// CHAVE DE OBJETO do PDF gerado, no bucket privado. Nao e URL: gravar link
  /// assinado numa coluna produz um valor que expira sozinho -- mesma regra
  /// de `Tenant.logoObjectKey`.
  ///
  /// Nulo enquanto o contrato e `DRAFT`: o PDF nasce no fechamento, porque
  /// documento de rascunho circulando como contrato e pior que documento
  /// nenhum.
  documentObjectKey String? @map("document_object_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         SaasPlan        @relation(fields: [planId], references: [id])
  supersedes   TenantContract? @relation("SucessaoDeContrato", fields: [supersedesId], references: [id])
  supersededBy TenantContract? @relation("SucessaoDeContrato")

  invoices PlatformInvoice[]

  @@index([tenantId, status])
  @@map("tenant_contracts")
}

/// Valor de um indice economico numa competencia -- ADR-052 §7.
///
/// ENTRADA MANUAL, com historico. A API publica do Banco Central no caminho
/// de faturamento e risco sem contrapartida no primeiro ano: indisponibilidade
/// dela viraria fatura errada ou fatura nenhuma. Automatizar e ADR futuro.
///
/// SEM valor cadastrado a correcao NAO roda -- e o aceite da fatia. Aplicar
/// zero seria inventar que o indice foi zero naquele mes.
model IndexValue {
  id   String @id @default(uuid()) @db.Uuid
  /// Codigo do indice, casando com `TenantContract.indexCode`. Ex.: `IPCA`.
  code String

  /// Competencia do valor: primeiro dia do mes a que ele se refere.
  /// Guardar o mes como data evita um par (ano, mes) que ordena errado em
  /// texto e que exige regra propria para comparar.
  referenceMonth DateTime @map("reference_month") @db.Date

  /// Variacao do mes em MILESIMOS DE PONTO PERCENTUAL -- 0,44% grava 440.
  ///
  /// INTEIRO, e nao `float`: a mesma razao de dinheiro ser inteiro (regra 6).
  /// O indice multiplica valor em centavos; ponto flutuante aqui produziria
  /// contrato corrigido para um centavo diferente a cada arredondamento.
  variationBasisPoints Int @map("variation_basis_points")

  createdAt DateTime @default(now()) @map("created_at")

  /// Uma linha por indice e competencia. Reimportar o mesmo mes reencontra a
  /// chave em vez de somar duas variacoes sobre o mesmo periodo.
  @@unique([code, referenceMonth])
  @@index([code, referenceMonth])
  @@map("index_values")
}

/// Status da fatura da plataforma -- ADR-052 (Fatura da plataforma).
///
/// Tres estados e nao mais: `OVERDUE` e o gatilho da carencia da F65
/// (ADR-053), e nao um rotulo cosmetico. Nao existe `CANCELLED` porque
/// cancelar fatura emitida e decisao que ninguem pediu -- quando pedirem,
/// entra com o campo que registra QUEM cancelou e POR QUE.
enum PlatformInvoiceStatus {
  OPEN
  PAID
  OVERDUE

  @@map("platform_invoice_status")
}

/// A fatura do ArenaHub sobre a academia -- F64, ADR-052.
///
/// ---------------------------------------------------------------------------
/// NAO E `Invoice`. Outro pagador, outro ciclo, outra consequencia.
/// ---------------------------------------------------------------------------
///
/// `Invoice` e do tenant cobrando o ALUNO; esta e do ArenaHub cobrando o
/// TENANT. Reaproveitar a tabela juntaria duas cadeias que so se parecem de
/// longe: uma vencida corta o entitlement de um aluno, esta vencida fecha a
/// catraca da academia inteira (F65). Regra 1 continua de pe -- o gate e do
/// contratante, nao do aluno.
///
/// A CONTAGEM E CONGELADA. `activeCount`/`inactiveCount` sao o retrato do dia
/// da emissao, nao uma consulta viva: o aluno que vira `CANCELLED` no dia 10
/// nao pode reescrever a fatura do dia 1. E o aceite da fatia.
model PlatformInvoice {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  /// Contrato que produziu esta fatura. Os valores unitarios abaixo sao COPIA
  /// dele, pela mesma razao que os dele sao copia do plano (ADR-052 §8):
  /// contrato encerrado nao pode mudar fatura ja emitida.
  contractId String @map("contract_id") @db.Uuid

  /// Competencia: PRIMEIRO DIA do mes faturado. Mesma forma de
  /// `IndexValue.referenceMonth` -- ver o CHECK na migration.
  competence DateTime @map("competence") @db.Date

  /// Modelo aplicado, copiado do contrato. Sem ele, ler uma fatura antiga
  /// exigiria voltar ao contrato para saber por que os campos de contagem
  /// estao zerados.
  model SaasPricingModel

  /// O RETRATO. Alunos com `status = ACTIVE` e todos os demais (`LEAD`,
  /// `TRIAL`, `SUSPENDED`, `BLOCKED`, `CANCELLED`, `ARCHIVED`) no dia da
  /// emissao -- ADR-052 §6, pendencia 1 fechada em 08/09/2026.
  ///
  /// Zero nos dois no modelo fixo: nao ha contagem a fazer.
  activeCount   Int @default(0) @map("active_count")
  inactiveCount Int @default(0) @map("inactive_count")

  /// Precos unitarios aplicados, em centavos. Copia do contrato no instante
  /// da emissao. Nulos no modelo fixo.
  activeStudentPriceMinor   Int? @map("active_student_price_minor")
  inactiveStudentPriceMinor Int? @map("inactive_student_price_minor")

  /// Valor total da fatura, em centavos (regra 6).
  ///
  /// PERSISTIDO, e nao derivado na leitura: recalcular `count * preco` a cada
  /// consulta faria uma correcao de arredondamento futura reescrever fatura
  /// paga. O total e o que foi cobrado, nao o que a formula de hoje daria.
  totalMinor Int    @map("total_minor")
  currency   String @default("BRL")

  dueAt  DateTime              @map("due_at") @db.Date
  status PlatformInvoiceStatus @default(OPEN)
  /// Instante do pagamento registrado pelo Super Admin. Nulo enquanto aberta.
  paidAt DateTime?             @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract TenantContract @relation(fields: [contractId], references: [id])

  /// UMA FATURA POR ACADEMIA E COMPETENCIA -- regra 4 (idempotencia).
  ///
  /// A chave e do BANCO e nao um `if` no job: o job rodando duas vezes, ou
  /// duas instancias da API subindo o mesmo `@Cron`, passam as duas pela
  /// leitura antes de qualquer escrita. Rodar de novo reencontra a chave.
  @@unique([tenantId, competence])
  @@index([tenantId, status])
  @@index([status, dueAt])
  @@map("platform_invoices")
}
