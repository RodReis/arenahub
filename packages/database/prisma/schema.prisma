// Schema do ArenaHub.
//
// REGRA DE ARQUITETURA No 2, sem excecao (CLAUDE.md):
//
//   - `tenant_id` em TODA entidade de negocio;
//   - `gym_unit_id` quando o dado e fisico;
//   - o tenant vem da identidade autenticada, nunca do corpo da requisicao
//     nem do payload de webhook.
//
// Convencao de nomes: model em PascalCase singular, coluna em snake_case via
// @map, tabela em snake_case plural via @@map. Contrato de dominio completo
// em docs/CONVENTION.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

enum GymUnitStatus {
  ACTIVE
  INACTIVE

  @@map("gym_unit_status")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  ARCHIVED

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  REVOKED

  @@map("membership_status")
}

/// Estado do segundo fator por usuario. `PENDING` existe porque um perfil
/// privilegiado pode ter iniciado a inscricao sem te-la confirmado -- e
/// nesse intervalo ele nao pode receber acesso completo.
enum MfaStatus {
  DISABLED
  PENDING
  ENABLED

  @@map("mfa_status")
}

enum SessionStatus {
  ACTIVE
  ROTATED
  REVOKED

  @@map("session_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum ActorType {
  USER
  SYSTEM
  SUPPORT

  @@map("actor_type")
}

/// Ciclo de vida comercial do aluno (`M1` secao 10).
///
/// As TRANSICOES entre estes estados eram `[indefinido]` no CONVENTION.md
/// secao 3.1, que mandava defini-las na spec de F7 -- e a spec saiu vazia. A
/// tabela adotada vive em `student.ts` (STUDENT_TRANSITIONS), decidida nesta
/// fatia a partir do plano de apoio. O CONVENTION.md secao 3.1 precisa da
/// emenda correspondente.
enum StudentStatus {
  LEAD
  TRIAL
  ACTIVE
  SUSPENDED
  BLOCKED
  CANCELLED
  ARCHIVED

  @@map("student_status")
}

enum StudentContactType {
  EMAIL
  PHONE
  WHATSAPP
  /// Contato de terceiro, para quando o aluno passa mal na academia. Usa
  /// `label` (nome de quem atende) e `relationship` (parentesco) -- os dois
  /// unicos campos que so este tipo preenche. Tabela propria guardaria tres
  /// strings e duplicaria a normalizacao de telefone que ja existe aqui.
  EMERGENCY

  @@map("student_contact_type")
}

/// Sexo CADASTRAL: espelha o documento civil, e nada mais.
///
/// Identidade de genero e nome social sao OUTRA coisa, nao foram pedidos, e
/// se um dia entrarem sao campos proprios -- reaproveitar este seria erro de
/// modelagem antes de ser erro de tratamento.
enum StudentRegisteredSex {
  FEMALE
  MALE
  NOT_INFORMED

  @@map("student_registered_sex")
}

/// De onde veio o aluno. Valores decididos pelo PI em 18/08/2026.
///
/// Enum, nao texto livre: "indicacao", "Indicacao" e "indic." sao a mesma
/// origem para a recepcao e tres linhas distintas em qualquer relatorio.
/// `OUTRO` e a valvula de escape; acrescentar valor e migration de enum.
enum LeadSource {
  INDICACAO
  REDES_SOCIAIS
  PASSAGEM_NA_PORTA
  CAMPANHA
  SITE
  OUTRO

  @@map("lead_source")
}

/// `PAST_DUE` existe no enum e NAO e alcancavel no MVP 1.
///
/// O CONVENTION.md secao 3.2 e explicito: sem cobranca automatica, nada leva
/// a assinatura para PAST_DUE. O valor entra agora porque o modelo e o mesmo
/// que o MVP 2 vai usar -- criar a coluna depois custaria migration de enum
/// em tabela ja populada. Nenhuma transicao desta fatia o alcanca.
enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

enum EntitlementStatus {
  SCHEDULED
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED

  @@map("entitlement_status")
}

/// Origem do direito de acesso (INV-064).
///
/// Enum EXTENSIVEL por decisao do ADR-009: convenio corporativo esta fora do
/// roadmap hoje, mas o campo nao fecha a porta. Acrescentar valor aqui e
/// migration de enum, nao redesenho de tabela.
enum EntitlementSource {
  SUBSCRIPTION
  COURTESY
  EMPLOYEE
  PERSONAL_TRAINER
  VISITOR
  TRIAL_CLASS
  DEPENDENT
  PARTNER
  CORPORATE

  @@map("entitlement_source")
}

/// Tipo de evento da timeline administrativa do aluno.
enum StudentTimelineEventType {
  STUDENT_CREATED
  STUDENT_UPDATED
  STUDENT_STATUS_CHANGED
  STUDENT_ARCHIVED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_RESUMED
  SUBSCRIPTION_CANCELLED
  ENTITLEMENT_ACTIVATED
  ENTITLEMENT_SUSPENDED
  ENTITLEMENT_REVOKED
  ENTITLEMENT_EXPIRED
  COURTESY_GRANTED
  BIOMETRIC_CONSENT_ACCEPTED
  BIOMETRIC_CONSENT_REFUSED
  BIOMETRIC_CONSENT_REVOKED
  BIOMETRIC_IDENTITY_CREATED
  BIOMETRIC_IDENTITY_REVOKED
  BIOMETRIC_IDENTITY_DELETED

  @@map("student_timeline_event_type")
}

/// Tipo de documento de consentimento.
///
/// Lista fechada: cada tipo tem base legal propria. Biometria e o unico
/// dado sensivel do art. 11 nesta fatia -- os demais entram nas fatias que
/// os pedirem (avaliacao fisica em F17, imagem em F19).
enum ConsentDocumentType {
  BIOMETRIC

  @@map("consent_document_type")
}

/// Decisao do titular sobre um documento de consentimento.
///
/// RECUSAR E DECISAO VALIDA, nao ausencia de resposta: `REFUSED` registrado
/// e o que prova que houve escolha livre (INV-022b). Sem ele, "nao consta"
/// e indistinguivel de "nunca perguntamos".
enum ConsentDecision {
  ACCEPTED
  REFUSED

  @@map("consent_decision")
}

/// Quem prestou o consentimento.
///
/// INV-143 (ADR-008): menor de 18 so tem cadastro biometrico com
/// consentimento de responsavel legal. O tipo fica na propria decisao para
/// que a revalidacao na virada dos 18 seja consulta, nao arqueologia.
enum ConsentSubjectKind {
  /// O proprio aluno, maior de 18 na data da decisao.
  STUDENT
  /// Responsavel legal por aluno menor de 18.
  LEGAL_GUARDIAN

  @@map("consent_subject_kind")
}

/// Estado da identidade biometrica.
///
/// A ordem importa e e a do INV-019: revogar desativa logicamente ANTES de
/// a exclusao fisica acontecer. `REVOKED` ja bloqueia; `DELETION_PENDING`
/// diz que os leitores ainda nao confirmaram; `DELETED` so quando todos
/// confirmaram (INV-018, INV-027).
enum BiometricIdentityState {
  ACTIVE
  REVOKED
  DELETION_PENDING
  DELETED

  @@map("biometric_identity_state")
}

/// Estado operacional do Edge (PC da academia).
enum EdgeNodeStatus {
  ACTIVE
  SUSPENDED

  @@map("edge_node_status")
}

/// Estado do dispositivo fisico (leitor facial, catraca).
enum DeviceStatus {
  ACTIVE
  MAINTENANCE
  RETIRED

  @@map("device_status")
}

/// Categoria do dispositivo. Amplia quando outro tipo for homologado.
enum DeviceKind {
  FACIAL_READER
  TURNSTILE

  @@map("device_kind")
}

/// Estado do cadastro do aluno DENTRO de um dispositivo.
enum DeviceUserState {
  PENDING
  SYNCED
  REMOVAL_PENDING
  REMOVED
  FAILED

  @@map("device_user_state")
}

/// Operacao de sincronizacao. Nao ha lote: INV-023 -- o protocolo facial
/// exige fila individual por usuario e por dispositivo (INV-024).
enum DeviceSyncOperation {
  UPSERT
  DELETE

  @@map("device_sync_operation")
}

/// Estado do job de sincronizacao, visivel no painel de pendencia.
enum DeviceSyncJobState {
  PENDING
  PROCESSING
  SYNCED
  RETRYING
  FAILED
  REMOVED

  @@map("device_sync_job_state")
}

/// Estado do comando duravel entregue ao Edge.
enum DeviceCommandState {
  AVAILABLE
  LEASED
  ACKNOWLEDGED
  FAILED

  @@map("device_command_state")
}

/// O que foi acessado no registro de acesso a dado biometrico.
///
/// ADR-008: log de acesso a template e imagem foi UMA DAS TRES CAUSAS da
/// suspensao da ANPD no caso da rede estadual do PR (04/08/2026). Nao e
/// item de observabilidade -- e prova de controle de acesso.
enum BiometricAccessKind {
  ENROLLMENT_IMAGE
  IDENTITY_METADATA

  @@map("biometric_access_kind")
}

/// Por que o dado biometrico foi acessado.
enum BiometricAccessPurpose {
  ENROLLMENT
  DEVICE_SYNC
  REVOCATION
  PURGE
  AUDIT

  @@map("biometric_access_purpose")
}

// ---------------------------------------------------------------------------
// Decisao de acesso (F9)
// ---------------------------------------------------------------------------

/// Resultado da decisao -- ADR-005 fixou `ALLOW`/`DENY`, nao `GRANTED`/`DENIED`.
enum AccessOutcome {
  ALLOW
  DENY

  @@map("access_outcome")
}

/// Razao estavel da decisao -- ADR-024.
///
/// ESTE ENUM E PERSISTIDO E IMUTAVEL. Renomear um valor aqui nao e refactor:
/// e reescrever auditoria ja entregue. O MVP 2 ACRESCENTA `PAYMENT_OVERDUE`
/// pelo fim; nao mexe no que existe.
///
/// Espelha `packages/access-policy/src/types.ts`, que e a fonte -- o motor
/// puro nao pode importar Prisma porque precisa rodar tambem no Edge, onde
/// nao ha PostgreSQL. `access-reason.spec.ts` guarda a igualdade das duas
/// listas.
enum AccessReason {
  ACTIVE_ENTITLEMENT
  /// Liberacao manual da recepcao. So valido com `mode = OVERRIDE`.
  MANUAL_OVERRIDE
  ADMIN_BLOCK
  STUDENT_BLOCKED
  STUDENT_INACTIVE
  NO_ENTITLEMENT
  WRONG_UNIT
  OUTSIDE_SCHEDULE

  @@map("access_reason")
}

/// Como a decisao foi tomada.
///
/// `OFFLINE` ja existe aqui, embora a Slice 1.5 e quem vai produzi-lo: o
/// campo e imutavel e acrescentar valor a enum depois exige migracao com
/// tabela em uso. Reservar agora custa uma linha.
enum AccessMode {
  ONLINE
  OFFLINE
  OVERRIDE

  @@map("access_mode")
}

/// Como a pessoa se identificou na catraca.
enum AccessMethod {
  FACIAL
  QR
  CARD
  PIN
  MANUAL

  @@map("access_method")
}

/// Desfecho fisico da passagem -- `M1` §10.
///
/// `NOT_APPLICABLE` cobre o `DENY`: nao houve comando, entao nao ha giro a
/// confirmar. Sem esse valor, todo `DENY` ficaria com passagem nula e
/// "nulo" teria dois significados (nao se aplica / ainda esperando).
enum PassageState {
  NOT_APPLICABLE
  PENDING
  CONFIRMED
  TIMED_OUT

  @@map("passage_state")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// Academia. Nivel de cima da hierarquia decidida no ADR-002.
model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  /// Global: e o identificador publico do tenant, usado em URL e convite.
  slug        String       @unique
  legalName   String       @map("legal_name")
  displayName String       @map("display_name")
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  gymUnits     GymUnit[]
  memberships  TenantMembership[]
  roles        Role[]
  userRoles    UserRole[]
  sessions     Session[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  outboxEvents OutboxEvent[]

  students        Student[]
  studentSequence StudentSequence?
  plans           Plan[]
  subscriptions   Subscription[]
  entitlements    Entitlement[]

  consentDocuments    ConsentDocument[]
  consentRecords      ConsentRecord[]
  biometricIdentities BiometricIdentity[]
  biometricAccessLogs BiometricAccessLog[]
  privacySettings     TenantPrivacySettings?
  edgeNodes           EdgeNode[]
  edgeCredentials     EdgeCredential[]
  devices             Device[]
  deviceUsers         DeviceUser[]
  deviceSyncJobs      DeviceSyncJob[]
  deviceCommands      DeviceCommand[]

  accessPolicies         AccessPolicy[]
  operationalAlerts      OperationalAlert[]
  dataExportJobs         DataExportJob[]
  administrativeBlocks   AdministrativeBlock[]
  accessEvents           AccessEvent[]
  accessEventCorrections AccessEventCorrection[]
  manualAccessOverrides  ManualAccessOverride[]

  @@map("tenants")
  planPrices      PlanPrice[]
  planBenefits    PlanBenefit[]
  familyGroups    FamilyGroup[]
  familyMembers   FamilyMember[]
  billingSettings BillingSettings?
  invoices        Invoice[]
  invoiceItems    InvoiceItem[]
  payments        Payment[]
  paymentAttempts PaymentAttempt[]
  paymentMethods  PaymentMethod[]
  accountCredits  AccountCredit[]
  invoiceSequence InvoiceSequence?
  providerAccounts ProviderAccount[]
  providerEvents   ProviderEvent[]
}

/// Unidade fisica. Onde a catraca mora.
model GymUnit {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  /// Unico dentro do tenant, reutilizavel entre tenants: duas academias sem
  /// relacao podem ter uma unidade "CENTRO" cada.
  code         String
  name         String
  /// IANA (`America/Sao_Paulo`). O ADR-019 exige timezone da unidade, sem
  /// fallback -- horario de funcionamento e bloqueio dependem dele.
  timezone     String
  /// Horario semanal de funcionamento. JSON porque a forma ainda varia por
  /// academia; vira tabela quando alguem precisar consultar por faixa.
  openingHours Json          @map("opening_hours")
  status       GymUnitStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]
  students  Student[]

  accessPolicies        AccessPolicy[]
  accessEvents          AccessEvent[]
  manualAccessOverrides ManualAccessOverride[]
  operationalAlerts     OperationalAlert[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("gym_units")
}

// ---------------------------------------------------------------------------
// Identidade e permissao
// ---------------------------------------------------------------------------

/// Usuario interno (proprietario, gerente, recepcao, tecnico, suporte).
///
/// NAO tem `tenantId`: a mesma pessoa pode atender duas academias, e o
/// vinculo mora em `TenantMembership`. A regra no 2 continua valendo -- o
/// que ela exige e que toda entidade de NEGOCIO carregue tenant; identidade
/// e o ponto onde o vinculo se estabelece, nao onde se pressupoe.
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  /// Normalizado em minusculas antes de gravar; unico globalmente.
  email               String     @unique
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(ACTIVE)
  mfaStatus           MfaStatus  @default(DISABLED) @map("mfa_status")
  /// Segredo TOTP cifrado com AES-256-GCM. Os tres campos andam juntos: sem
  /// IV e tag nao ha como decifrar, e guardar o segredo em claro
  /// transformaria leitura de tabela em clonagem de segundo fator.
  mfaSecretCiphertext Bytes?     @map("mfa_secret_ciphertext")
  mfaSecretIv         Bytes?     @map("mfa_secret_iv")
  mfaSecretTag        Bytes?     @map("mfa_secret_tag")
  /// Ultimo contador TOTP aceito. Impede replay do mesmo codigo dentro da
  /// janela de validade.
  mfaLastCounter      BigInt?    @map("mfa_last_counter")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  memberships TenantMembership[]
  userRoles   UserRole[]
  sessions    Session[]
  auditLogs   AuditLog[]
  /// Alunos de quem este usuario e consultor responsavel.
  advisedStudents Student[] @relation("StudentAdvisor")

  @@map("users")
}

/// Vinculo entre usuario e academia.
model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

/// Papel dentro de um tenant. `isSystem` marca os quatro que o produto cria
/// e nao deixa apagar (OWNER, MANAGER, RECEPTIONIST, TECH_OPERATOR).
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// Permissao do catalogo (`unit.create`, `access.override`, ...). Global e
/// estavel: o codigo entra em decorator de rota, entao renomear quebra
/// autorizacao em producao.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Atribuicao de papel. `gymUnitId` nulo = vale no tenant inteiro;
/// preenchido = escopo restrito aquela unidade.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  gymUnitId String?  @map("gym_unit_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  gymUnit GymUnit? @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId, gymUnitId])
  @@index([userId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Sessao e convite
// ---------------------------------------------------------------------------

/// Sessao de refresh token.
///
/// GUARDA HASH, NUNCA O TOKEN. `familyId` agrupa a cadeia de rotacoes: se um
/// token ja rotacionado reaparece, alguem o copiou, e a familia inteira e
/// revogada.
model Session {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tokenHash     String        @unique @map("token_hash")
  familyId      String        @map("family_id") @db.Uuid
  status        SessionStatus @default(ACTIVE)
  expiresAt     DateTime      @map("expires_at")
  rotatedAt     DateTime?     @map("rotated_at")
  revokedAt     DateTime?     @map("revoked_at")
  /// Motivo da revogacao (`logout`, `refresh_reused`, `admin`). Sem isso,
  /// investigar incidente vira adivinhacao.
  revokedReason String?       @map("revoked_reason")
  createdAt     DateTime      @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// Convite de uso unico. Tambem guarda so o hash: o link e mostrado uma vez
/// a quem convidou e nunca mais recuperavel.
model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  email      String
  roleId     String           @map("role_id") @db.Uuid
  gymUnitId  String?          @map("gym_unit_id") @db.Uuid
  tokenHash  String           @unique @map("token_hash")
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  revokedAt  DateTime?        @map("revoked_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Auditoria e mensageria
// ---------------------------------------------------------------------------

/// Trilha de auditoria. SEM `updatedAt` DE PROPOSITO: registro de auditoria
/// que muda nao e trilha, e rascunho. Correcao entra como novo registro.
model AuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  gymUnitId     String?   @map("gym_unit_id") @db.Uuid
  actorType     ActorType @map("actor_type")
  actorId       String?   @map("actor_id") @db.Uuid
  action        String
  target        String
  targetId      String?   @map("target_id")
  correlationId String    @map("correlation_id")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  /// Metadados ja mascarados na aplicacao. E-mail, CPF e afins nao entram
  /// em claro -- log nao e lugar de PII (CLAUDE.md, Convencoes).
  metadata      Json?
  occurredAt    DateTime  @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}

/// Transactional outbox (regra de arquitetura no 5): o evento e gravado na
/// MESMA transacao da mudanca de estado. Publicar antes de commitar produz
/// evento de algo que nunca aconteceu.
///
/// SEM `updatedAt`: o envelope e imutavel; o que muda e o estado de entrega.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  occurredAt    DateTime  @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

/// Recibo de consumo (regra de arquitetura no 4). A chave unica
/// (consumidor, evento) e o que torna reprocessar seguro -- nao a esperanca
/// de que o broker entregue uma vez so.
model InboxReceipt {
  id          String   @id @default(uuid()) @db.Uuid
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([consumer, eventId])
  @@map("inbox_receipts")
}

// ---------------------------------------------------------------------------
// Aluno
// ---------------------------------------------------------------------------

/// Aluno da academia.
///
/// A MATRICULA NUNCA DERIVA DO CPF (INV-009, INV-011, INV-012, `M1-BR-001`).
/// CPF ajuda a detectar duplicidade e nada mais -- nao e identificador
/// tecnico, nao vai para dispositivo, nao entra em URL.
///
/// O CPF e guardado em DOIS campos com finalidades distintas:
///
///   - `cpfHash` -- SHA-256 do valor normalizado. E o que a busca por
///     duplicata compara. Hash e nao cifra porque a operacao necessaria e
///     igualdade exata, e hash nao tem chave para vazar.
///   - `cpfLast3` -- os tres ultimos digitos, para a recepcao confirmar
///     "e este mesmo?" sem que a resposta da API carregue o documento
///     inteiro.
///
/// O CPF completo NAO e persistido. Recuperar o numero a partir do hash
/// exigiria forca bruta sobre 11 digitos com digito verificador -- viavel
/// para um alvo, caro para a base inteira. Se uma fatia futura precisar
/// exibir o CPF completo, isso vira decisao do PI com cifra reversivel, nao
/// um `ALTER TABLE` silencioso.
model Student {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  /// `AP-{ano}-{8 digitos}`. IMUTAVEL apos a criacao (INV-010): nenhum caso
  /// de uso desta fatia a altera, e a unicidade sobrevive ao arquivamento
  /// (INV-015) porque soft delete nao remove a linha.
  membershipNumber String        @map("membership_number")
  fullName         String        @map("full_name")
  /// `@db.Date`: data de nascimento nao tem hora nem fuso. Gravar como
  /// timestamp faria 01/01 virar 31/12 na conversao de timezone.
  birthDate        DateTime      @map("birth_date") @db.Date
  cpfHash          String?       @map("cpf_hash")
  cpfLast3         String?       @map("cpf_last3")
  /// Texto livre e opcional. RG nao tem formato nacional unico -- cada
  /// estado emite o seu, e validar digito verificador aqui seria inventar
  /// regra que orgao nenhum garante.
  rg               String?
  registeredSex    StudentRegisteredSex? @map("registered_sex")
  leadSource       LeadSource?           @map("lead_source")
  /// UNIDADE DE ORIGEM -- onde o aluno se cadastrou e para onde a recepcao o
  /// conta. NAO E CONTROLE DE ACESSO: quem decide em qual unidade ele entra
  /// continua sendo o plano, por `PlanUnit` e `EntitlementUnitWindow`. Ler
  /// esta coluna numa decisao de acesso criaria a segunda fonte de verdade
  /// que a regra de arquitetura no 1 proibe -- ha teste que prova que nao
  /// acontece (`gym-unit-nao-decide-acesso.spec.ts`).
  gymUnitId        String        @map("gym_unit_id") @db.Uuid
  /// Consultor responsavel (Espec 11). FK, nao texto livre: texto livre nao
  /// sobrevive a saida do funcionario.
  advisorUserId    String?       @map("advisor_user_id") @db.Uuid
  status           StudentStatus @default(LEAD)
  /// Preenchido no arquivamento. Soft delete (INV-013): preserva historico
  /// legal e operacional em vez de apagar.
  archivedAt       DateTime?     @map("archived_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  /// Trava otimista. Comando concorrente que leu a versao antiga falha em
  /// vez de sobrescrever decisao que nao viu.
  version          Int           @default(0)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// `RESTRICT`: apagar unidade que ainda tem aluno falha, em vez de deixar
  /// aluno orfao ou apagado junto.
  gymUnit        GymUnit                @relation(fields: [gymUnitId], references: [id], onDelete: Restrict)
  /// `SET NULL`: o aluno continua existindo depois que o consultor sai.
  advisor        User?                  @relation("StudentAdvisor", fields: [advisorUserId], references: [id], onDelete: SetNull)
  contacts       StudentContact[]
  addresses      StudentAddress[]
  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]
  entitlements   Entitlement[]
  timelineEvents StudentTimelineEvent[]

  consentRecords      ConsentRecord[]
  biometricIdentities BiometricIdentity[]
  deviceUsers         DeviceUser[]

  administrativeBlocks  AdministrativeBlock[]
  accessEvents          AccessEvent[]
  manualAccessOverrides ManualAccessOverride[]

  @@unique([tenantId, membershipNumber])
  @@index([tenantId, gymUnitId])
  @@index([tenantId, status])
  @@index([tenantId, cpfHash])
  @@index([tenantId, fullName])
  @@map("students")
  familyMemberships FamilyMember[]
  invoices          Invoice[]
  accountCredits    AccountCredit[]
}

/// Contato do aluno. `value` guarda a forma NORMALIZADA (e-mail em
/// minusculas, telefone so com digitos) -- e o que a deteccao de duplicata
/// compara. Sem normalizar, "(41) 99999-0000" e "41999990000" seriam pessoas
/// diferentes.
model StudentContact {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  studentId String             @map("student_id") @db.Uuid
  type      StudentContactType
  value     String
  /// Nome de quem atende. So `EMERGENCY` preenche -- nos demais tipos o
  /// contato E o aluno, e repetir o nome dele em cada linha nao informa.
  label     String?
  /// Parentesco ou vinculo ("conjuge", "mae", "vizinha"). Texto livre: a
  /// lista de vinculos possiveis nao fecha, e enum que nao fecha vira
  /// `OUTRO` em metade das linhas.
  relationship String?
  isPrimary Boolean            @default(false) @map("is_primary")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, value])
  @@index([studentId])
  @@map("student_contacts")
}

model StudentAddress {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  postalCode String   @map("postal_code")
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_addresses")
}

/// Contador de matricula, uma linha por tenant.
///
/// EXISTE PARA SER TRAVADO. A geracao roda dentro da transacao de criacao
/// com `SELECT ... FOR UPDATE` nesta linha: duas recepcionistas cadastrando
/// ao mesmo tempo serializam aqui, e nao na tabela `students`.
///
/// Alternativas descartadas: `COUNT(*)` (reusa numero apos arquivamento),
/// fragmento de UUID (colide e nao e sequencial), sequence do Postgres
/// (global, vazaria volume de um tenant para outro).
model StudentSequence {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  /// Proximo numero a emitir. Nunca decrementa, nem quando um aluno e
  /// arquivado -- reaproveitar matricula quebraria INV-010.
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("student_sequences")
}

/// Timeline administrativa do aluno.
///
/// SEM `updatedAt`, pelo mesmo motivo do `AuditLog`: registro de historico
/// que muda nao e historico. `payload` chega ja mascarado da aplicacao --
/// nunca CPF completo, nunca template biometrico (INV-022).
model StudentTimelineEvent {
  id            String                   @id @default(uuid()) @db.Uuid
  tenantId      String                   @map("tenant_id") @db.Uuid
  studentId     String                   @map("student_id") @db.Uuid
  type          StudentTimelineEventType
  actorType     ActorType                @map("actor_type")
  actorId       String?                  @map("actor_id") @db.Uuid
  correlationId String                   @map("correlation_id")
  payload       Json?
  occurredAt    DateTime                 @default(now()) @map("occurred_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Ordenacao do cursor: `(occurredAt, id)`. O `id` desempata eventos no
  /// mesmo instante -- sem ele, paginacao por cursor pula ou repete linha.
  @@index([tenantId, studentId, occurredAt, id])
  @@map("student_timeline_events")
}

// ---------------------------------------------------------------------------
// Plano, assinatura e entitlement
// ---------------------------------------------------------------------------

/// Plano comercial.
///
/// SO carrega o que `M1-FR-009` cobre: unidades, dias, horarios e validade.
/// As demais regras da Especificacao secao 34 (limite semanal, aulas
/// inclusas, convidados, fidelidade, multa) sao `[indefinido]` por INV-059 --
/// NAO inventar campo para elas aqui.
model Plan {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  /// Validade de VENDA do plano (ate quando pode ser contratado), diferente
  /// da vigencia da assinatura de um aluno.
  salesStartAt DateTime? @map("sales_start_at")
  salesEndAt   DateTime? @map("sales_end_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units         PlanUnit[]
  accessWindows PlanAccessWindow[]
  subscriptions Subscription[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("plans")
  prices   PlanPrice[]
  benefits PlanBenefit[]
}

model PlanUnit {
  planId    String @map("plan_id") @db.Uuid
  gymUnitId String @map("gym_unit_id") @db.Uuid

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, gymUnitId])
  @@map("plan_units")
}

/// Janela semanal de acesso, por unidade.
///
/// TABELA, NAO JSON. Regra de acesso enterrada em JSON nao validado e o que
/// o plano de apoio proibe explicitamente -- e o que o motor de decisao de
/// F9 vai precisar consultar por faixa.
///
/// Horario em MINUTOS DESDE A MEIA-NOITE LOCAL, nao string nem timestamp:
/// inteiro compara e ordena sem parsing, e a conversao para instante so
/// acontece na avaliacao de uma data concreta, com o timezone da unidade.
/// Virada de dia (22h-02h) entra como DUAS janelas, nunca como intervalo com
/// fim menor que o inicio.
model PlanAccessWindow {
  id          String @id @default(uuid()) @db.Uuid
  planId      String @map("plan_id") @db.Uuid
  gymUnitId   String @map("gym_unit_id") @db.Uuid
  /// ISO-8601: 1 = segunda ... 7 = domingo.
  dayOfWeek   Int    @map("day_of_week")
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, gymUnitId, dayOfWeek])
  @@map("plan_access_windows")
}

/// Assinatura: o fato comercial.
///
/// A CATRACA NUNCA CONSULTA ESTA TABELA (INV-030, `M1-BR-003`, ADR-003). O
/// caminho de acesso le `Entitlement`, e so. Esta linha existe para a
/// recepcao e para derivar o direito -- nao para decidir passagem.
model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  studentId   String             @map("student_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  status      SubscriptionStatus @default(PENDING)
  startsAt    DateTime           @map("starts_at")
  /// Nulo = sem termino previsto. A expiracao vem de job, nao de ausencia
  /// de data.
  endsAt      DateTime?          @map("ends_at")
  /// Quem criou/alterou manualmente e por que. No MVP 1 toda mudanca de
  /// assinatura e manual (INV-061), entao razao e ator sao obrigatorios em
  /// cada comando -- e ficam aqui na ultima alteracao, alem da timeline.
  lastActorId String?            @map("last_actor_id") @db.Uuid
  lastReason  String?            @map("last_reason")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  version     Int                @default(0)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  entitlements Entitlement[]

  @@index([tenantId, studentId, status])
  @@map("subscriptions")
  familyGroup FamilyGroup?
  invoices    Invoice[]
}

/// Direito de acesso. O QUE A CATRACA CONSULTA.
///
/// Regra de arquitetura no 1: `Pagamento -> Invoice -> Subscription ->
/// Entitlement -> Access Decision Engine`. Esta e a ultima parada antes do
/// motor, e a primeira que o motor le.
///
/// `policySnapshot` e IMUTAVEL: copia das regras do plano no instante da
/// derivacao. Existe porque o plano pode mudar amanha, e o direito ja
/// concedido nao pode mudar junto sem alguem decidir isso. Sem o snapshot,
/// editar um plano reescreveria retroativamente quem podia entrar ontem.
model Entitlement {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  studentId      String            @map("student_id") @db.Uuid
  source         EntitlementSource
  /// Nulo quando a origem nao e assinatura (cortesia, visitante, ...).
  subscriptionId String?           @map("subscription_id") @db.Uuid
  status         EntitlementStatus @default(SCHEDULED)
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  /// Obrigatorios para cortesia (INV-063): razao e responsavel.
  grantedById    String?           @map("granted_by_id") @db.Uuid
  reason         String?
  /// Copia congelada das regras do plano. Nunca reescrito apos a criacao.
  policySnapshot Json              @map("policy_snapshot")
  suspendedAt    DateTime?         @map("suspended_at")
  revokedAt      DateTime?         @map("revoked_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  version        Int               @default(0)

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription Subscription?           @relation(fields: [subscriptionId], references: [id])
  unitWindows  EntitlementUnitWindow[]
  accessEvents AccessEvent[]

  /// Indice do caminho quente: o motor de F9 pergunta "que direito valido
  /// este aluno tem agora?".
  @@index([tenantId, studentId, status, startsAt, endsAt])
  @@map("entitlements")
}

/// Janela de acesso ja resolvida para o entitlement.
///
/// Duplica a forma de `PlanAccessWindow` de proposito: aquela pertence ao
/// plano e MUDA quando o plano muda; esta pertence ao direito concedido e
/// NAO muda. Ler a do plano no momento da decisao reintroduziria exatamente
/// a retroatividade que o snapshot existe para impedir.
model EntitlementUnitWindow {
  id            String @id @default(uuid()) @db.Uuid
  entitlementId String @map("entitlement_id") @db.Uuid
  gymUnitId     String @map("gym_unit_id") @db.Uuid
  dayOfWeek     Int    @map("day_of_week")
  startMinute   Int    @map("start_minute")
  endMinute     Int    @map("end_minute")

  entitlement Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([entitlementId, gymUnitId, dayOfWeek])
  @@map("entitlement_unit_windows")
}

// ---------------------------------------------------------------------------
// Consentimento e biometria (F8)
//
// Base legal: CONSENTIMENTO ESPECIFICO E DESTACADO (LGPD art. 11, I), fixado
// no ADR-008. Legitimo interesse NAO e hipotese disponivel para dado
// sensivel -- o art. 11 e lista fechada.
//
// Em 04/08/2026 a ANPD suspendeu reconhecimento facial na rede estadual do
// PR por tres causas: falta de base legal, ausencia de comprovacao de
// seguranca e falha no controle de acesso as imagens. As tres tem contraparte
// aqui: ConsentRecord, ausencia de coluna de template e BiometricAccessLog.
// ---------------------------------------------------------------------------

/// Versao publicada de um termo de consentimento.
///
/// IMUTAVEL depois de publicado. Corrigir texto exige VERSAO NOVA, nunca
/// UPDATE: o registro de consentimento aponta para esta linha, e reescrever
/// o texto mudaria retroativamente aquilo que a pessoa aceitou.
///
/// `contentSha256` e o que torna a prova verificavel -- guardar so a versao
/// deixaria "v2" significar uma coisa hoje e outra depois de um deploy.
model ConsentDocument {
  id            String              @id @default(uuid()) @db.Uuid
  /// `null` = documento global do ArenaHub, valido para todo tenant que nao
  /// publicou o proprio. A academia e controladora (ADR-008) e pode
  /// publicar o seu.
  tenantId      String?             @map("tenant_id") @db.Uuid
  type          ConsentDocumentType
  /// Inteiro crescente por (escopo, tipo). Sem semver: termo juridico nao
  /// tem "correcao compativel".
  version       Int
  /// Finalidade especifica (art. 11, I exige "para finalidades especificas").
  /// Texto em pt-BR, exibido ao titular.
  purpose       String
  content       String
  /// SHA-256 do `content`, em hex minusculo.
  contentSha256 String              @map("content_sha256")
  effectiveFrom DateTime            @map("effective_from")
  /// Preenchido quando uma versao nova entra. Documento aposentado continua
  /// existindo: ha consentimento vivo apontando para ele.
  retiredAt     DateTime?           @map("retired_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant  Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records ConsentRecord[]

  @@unique([tenantId, type, version])
  @@index([tenantId, type, effectiveFrom])
  @@map("consent_documents")
}

/// Decisao do titular sobre um documento. IMUTAVEL (INV-021).
///
/// Nunca sofre UPDATE de decisao: revogar CRIA linha nova apontando para a
/// anterior em `revokesRecordId`. Reescrever a decisao apagaria a prova de
/// que houve consentimento no periodo em que a biometria funcionou -- que e
/// exatamente o que a ANPD pede para ver.
///
/// Guarda ator, IP e user-agent porque o INV-021 exige, e porque "quem
/// coletou" e a primeira pergunta numa fiscalizacao.
model ConsentRecord {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  studentId        String             @map("student_id") @db.Uuid
  documentId       String             @map("document_id") @db.Uuid
  decision         ConsentDecision
  /// Quem prestou: o proprio aluno ou responsavel legal (INV-143).
  subjectKind      ConsentSubjectKind @map("subject_kind")
  /// Nome do responsavel legal, quando `subjectKind = LEGAL_GUARDIAN`.
  /// INV-143 exige vinculo COMPROVAVEL -- nome e grau de parentesco sao o
  /// minimo; o documento comprobatorio entra em `evidence`.
  guardianName     String?            @map("guardian_name")
  guardianRelation String?            @map("guardian_relation")
  /// Idade do aluno na data da decisao, em anos completos.
  ///
  /// Congelada de proposito: saber que a pessoa tinha 16 quando o
  /// responsavel consentiu e o que dispara a revalidacao na virada dos 18
  /// (INV-143). Recalcular pela data de nascimento diria a idade de HOJE,
  /// nao a da decisao.
  subjectAgeYears  Int                @map("subject_age_years")
  /// Ator interno que registrou (recepcao). Nao e o titular.
  actorId          String?            @map("actor_id") @db.Uuid
  actorIp          String?            @map("actor_ip")
  actorUserAgent   String?            @map("actor_user_agent")
  /// Evidencia adicional em JSON: canal, documento do responsavel, hash de
  /// assinatura. NUNCA imagem nem template.
  evidence         Json?
  occurredAt       DateTime           @map("occurred_at")
  /// Preenchido quando uma decisao posterior substitui esta.
  supersededAt     DateTime?          @map("superseded_at")
  /// Aponta para a decisao que esta linha revoga.
  revokesRecordId  String?            @map("revokes_record_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  document   ConsentDocument     @relation(fields: [documentId], references: [id])
  identities BiometricIdentity[]

  @@index([tenantId, studentId, occurredAt])
  @@index([tenantId, documentId])
  @@map("consent_records")
}

/// Identidade biometrica do aluno. Entidade SEPARADA do cadastro (INV-016).
///
/// NAO EXISTE COLUNA DE TEMPLATE NEM DE IMAGEM AQUI, e isso e requisito, nao
/// omissao (INV-020): o template vive no leitor, a imagem de cadastro vive
/// no object storage privado, e esta tabela guarda so a REFERENCIA
/// (`enrollmentObjectKey`). A nuvem nao acumula biometria bruta.
///
/// `enrollmentObjectKey` fica nulo apos o expurgo (INV-142) sem que a linha
/// morra: o historico de que houve identidade e o que a auditoria consulta.
model BiometricIdentity {
  id                  String                 @id @default(uuid()) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  studentId           String                 @map("student_id") @db.Uuid
  state               BiometricIdentityState @default(ACTIVE)
  /// Consentimento que autorizou esta identidade. Sem ele a identidade nao
  /// nasce (INV-017).
  consentRecordId     String                 @map("consent_record_id") @db.Uuid
  /// Chave no object storage privado. `null` depois do expurgo.
  enrollmentObjectKey String?                @map("enrollment_object_key")
  /// Instante em que o objeto de cadastro foi apagado do storage.
  /// Evidencia auditavel do expurgo (INV-142).
  enrollmentPurgedAt  DateTime?              @map("enrollment_purged_at")
  revokedAt           DateTime?              @map("revoked_at")
  revokedReason       String?                @map("revoked_reason")
  /// So quando TODOS os dispositivos-alvo confirmaram remocao (INV-027).
  deletedAt           DateTime?              @map("deleted_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  version             Int                    @default(0)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  consentRecord ConsentRecord   @relation(fields: [consentRecordId], references: [id])
  deviceUsers   DeviceUser[]
  syncJobs      DeviceSyncJob[]
  accessEvents  AccessEvent[]

  @@index([tenantId, studentId, state])
  @@index([tenantId, state])
  @@map("biometric_identities")
}

/// Registro de acesso a dado biometrico (ADR-008).
///
/// Existe porque a falha no controle de acesso as imagens foi uma das tres
/// causas da suspensao da ANPD no caso PR. Toda leitura de imagem de
/// cadastro ou de metadado de identidade passa por aqui.
///
/// NAO guarda o dado acessado -- guarda QUEM, QUANDO, O QUE e PARA QUE
/// (INV-022: template e imagem nunca aparecem em log).
model BiometricAccessLog {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  identityId    String                 @map("identity_id") @db.Uuid
  kind          BiometricAccessKind
  purpose       BiometricAccessPurpose
  /// Ator humano; nulo quando o acesso e de processo (sync, expurgo).
  actorId       String?                @map("actor_id") @db.Uuid
  /// `USER` ou `SYSTEM` -- o worker de sync tambem presta contas.
  actorType     ActorType              @map("actor_type")
  actorIp       String?                @map("actor_ip")
  correlationId String                 @map("correlation_id")
  occurredAt    DateTime               @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, identityId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("biometric_access_logs")
}

/// Politica de privacidade biometrica POR TENANT.
///
/// ADR-008 exige retencao e log expostos como PARAMETRO DO CLIENTE -- e o
/// que sustenta a posicao de operador (art. 39) contra reclassificacao pela
/// ANPD: quem decide o prazo e a academia controladora, nao nos.
///
/// INV-142: 30 dias e o PADRAO, nao a constante.
model TenantPrivacySettings {
  tenantId               String   @id @map("tenant_id") @db.Uuid
  /// Dias apos o encerramento do vinculo ate o expurgo do template e da
  /// imagem, no banco E nos leitores.
  purgeAfterDays         Int      @default(30) @map("purge_after_days")
  /// Retencao do log de acesso biometrico, em dias. Padrao 5 anos: prazo
  /// prescricional civil, com folga sobre a fiscalizacao.
  accessLogRetentionDays Int      @default(1825) @map("access_log_retention_days")
  /// Instrucoes documentadas do controlador (art. 39). Texto do contrato de
  /// tratamento vigente entre a academia e o ArenaHub.
  processingInstructions String?  @map("processing_instructions")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_privacy_settings")
}

// ---------------------------------------------------------------------------
// Edge, dispositivos e sincronizacao (F8)
//
// A nuvem e a fonte da verdade; o Edge e executor fisico (regra de
// arquitetura no 3). Comando e DURAVEL: o WebSocket so avisa que ha
// trabalho, e perder o socket nao perde comando.
// ---------------------------------------------------------------------------

/// PC da academia que fala com os leitores. Um por unidade, tipicamente.
model EdgeNode {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  /// Dado fisico: exige `gym_unit_id` (regra de arquitetura no 2).
  gymUnitId     String         @map("gym_unit_id") @db.Uuid
  /// Identificador estavel, escolhido na instalacao. Aparece no painel.
  code          String
  status        EdgeNodeStatus @default(ACTIVE)
  agentVersion  String?        @map("agent_version")
  lastHeartbeat DateTime?      @map("last_heartbeat")
  /// Diferenca observada entre o relogio do Edge e o da nuvem, em
  /// milissegundos. Assinatura HMAC tem janela de +-300 s: relogio torto e
  /// causa comum de 401 em campo, e sem esta coluna vira caca ao fantasma.
  clockOffsetMs Int?           @map("clock_offset_ms")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  devices      Device[]
  credentials  EdgeCredential[]
  commands     DeviceCommand[]
  nonces       ReplayNonce[]
  accessEvents AccessEvent[]

  @@unique([tenantId, code])
  @@index([tenantId, gymUnitId])
  @@map("edge_nodes")
}

/// Credencial HMAC do Edge.
///
/// O segredo e guardado CIFRADO (AES-256-GCM), como o segredo TOTP da F6.
/// Duas credenciais ativas convivem por ate 24 h para permitir rotacao sem
/// janela de indisponibilidade -- cada uma com `keyId` distinto.
model EdgeCredential {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  edgeNodeId      String    @map("edge_node_id") @db.Uuid
  /// Vai no header `X-Edge-Key-Id`. Publico: identifica, nao autentica.
  keyId           String    @unique @map("key_id")
  /// Segredo cifrado. NUNCA em log, nem mascarado (INV-022 por analogia).
  encryptedSecret String    @map("encrypted_secret")
  activeFrom      DateTime  @map("active_from")
  /// Fim da validade -- ADR-011: "a credencial de uso e de vida curta e o
  /// agente a renova sozinho".
  ///
  /// NULAVEL de proposito, e a nulabilidade tem significado: credencial
  /// criada antes desta coluna existir (F8) nao tem prazo, e invalida-la
  /// retroativamente derrubaria a catraca de quem ja esta instalado. Nulo
  /// significa "sem prazo", nao "prazo desconhecido".
  ///
  /// Acrescentada em F11 porque o alerta que o ADR-011 exige -- renovacao que
  /// falha em silencio -- nao tem sobre o que alertar sem um prazo. A
  /// rotacao automatica em si continua sendo trabalho do Edge, fora desta
  /// fatia: o que entra aqui e a capacidade de OBSERVAR que ela falhou.
  expiresAt       DateTime? @map("expires_at")
  /// Revogacao e IMEDIATA: preenchido, a credencial para de valer no ato.
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  @@index([tenantId, edgeNodeId, revokedAt])
  @@map("edge_credentials")
}

/// Nonce ja usado, para barrar repeticao de requisicao assinada.
///
/// A unicidade `(edgeNodeId, keyId, nonceHash)` e o mecanismo: o INSERT
/// acontece DENTRO da transacao da requisicao, e a violacao de unique e o
/// que responde `EDGE_REPLAY_DETECTED`. Verificar antes e inserir depois
/// deixaria a janela de corrida aberta entre as duas operacoes.
///
/// `expiresAt` permite limpeza: a janela de assinatura e de +-300 s, entao
/// nonce mais velho que isso nao serve para repetir nada.
model ReplayNonce {
  id         String   @id @default(uuid()) @db.Uuid
  edgeNodeId String   @map("edge_node_id") @db.Uuid
  keyId      String   @map("key_id")
  /// SHA-256 do nonce recebido. O valor bruto nao precisa ser guardado.
  nonceHash  String   @map("nonce_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  @@unique([edgeNodeId, keyId, nonceHash])
  @@index([expiresAt])
  @@map("replay_nonces")
}

/// Dispositivo fisico homologado (leitor facial, catraca).
///
/// `model` e `firmware` sao conferidos contra `supported-hardware.md`:
/// hardware desconhecido responde `DEVICE_UNSUPPORTED_HARDWARE`, nao 500.
model Device {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  gymUnitId     String       @map("gym_unit_id") @db.Uuid
  edgeNodeId    String?      @map("edge_node_id") @db.Uuid
  kind          DeviceKind
  model         String
  firmware      String?
  /// Serie do fabricante. Unico por tenant -- o mesmo leitor nao pode estar
  /// cadastrado duas vezes.
  serial        String
  status        DeviceStatus @default(ACTIVE)
  /// Capacidades declaradas (suporta exclusao individual, tamanho de foto).
  /// JSON porque varia por modelo e ainda esta sendo levantado na bancada.
  capabilities  Json?
  lastHeartbeat DateTime?    @map("last_heartbeat")
  lastSyncAt    DateTime?    @map("last_sync_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  edgeNode    EdgeNode?       @relation(fields: [edgeNodeId], references: [id], onDelete: SetNull)
  deviceUsers DeviceUser[]
  syncJobs    DeviceSyncJob[]

  accessEvents          AccessEvent[]
  manualAccessOverrides ManualAccessOverride[]

  @@unique([tenantId, serial])
  @@index([tenantId, gymUnitId, status])
  @@map("devices")
}

/// Mapeamento `Student.id -> DeviceUser -> enrollid` (INV-026).
///
/// `externalUserId` e gerado POR DISPOSITIVO e NAO DERIVA DO CPF (INV-012,
/// INV-025). Usar CPF como id de leitor exporia documento a quem tiver
/// acesso fisico ao equipamento.
model DeviceUser {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  deviceId       String          @map("device_id") @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  identityId     String          @map("identity_id") @db.Uuid
  /// O `enrollid` dentro do leitor.
  externalUserId String          @map("external_user_id")
  state          DeviceUserState @default(PENDING)
  syncedAt       DateTime?       @map("synced_at")
  removedAt      DateTime?       @map("removed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device   Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  student  Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  identity BiometricIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalUserId])
  @@unique([deviceId, identityId])
  @@index([tenantId, state])
  @@index([tenantId, studentId])
  @@map("device_users")
}

/// Uma operacao de sync por identidade E por dispositivo (INV-024).
///
/// `idempotencyKey` unica impede o mesmo trabalho logico de virar dois jobs
/// quando o outbox reprocessa (regra de arquitetura no 4).
model DeviceSyncJob {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  deviceId       String              @map("device_id") @db.Uuid
  identityId     String              @map("identity_id") @db.Uuid
  operation      DeviceSyncOperation
  state          DeviceSyncJobState  @default(PENDING)
  attempts       Int                 @default(0)
  /// Backoff de 1/2/3/5/8 minutos; DLQ na quinta tentativa.
  nextAttemptAt  DateTime?           @map("next_attempt_at")
  lastAttemptAt  DateTime?           @map("last_attempt_at")
  /// Codigo estavel do erro. Nunca a mensagem crua do SDK -- ela carrega
  /// caminho de arquivo e, as vezes, dado do usuario.
  errorCode      String?             @map("error_code")
  /// Chave logica do trabalho: `{identityId}:{deviceId}:{operation}`.
  idempotencyKey String              @unique @map("idempotency_key")
  correlationId  String              @map("correlation_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device   Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  identity BiometricIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([tenantId, state, nextAttemptAt])
  @@index([tenantId, identityId])
  @@index([tenantId, deviceId, state])
  @@map("device_sync_jobs")
}

/// Comando DURAVEL para o Edge executar.
///
/// Persistido antes de qualquer notificacao. O WebSocket avisa que ha
/// trabalho; se o socket cair, o comando continua aqui e o Edge o busca por
/// REST assinado. Notificacao perdida nao e comando perdido.
///
/// `sequence` da ordem estavel para o `GET /edge/commands?after=`.
model DeviceCommand {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  edgeNodeId     String             @map("edge_node_id") @db.Uuid
  /// Cresce por Edge. `BigInt` porque e contador perpetuo.
  sequence       BigInt
  type           String
  /// Instrucao para o adapter. NUNCA template bruto: leva a referencia do
  /// objeto e o `externalUserId`, e o Edge busca a imagem por URL assinada.
  payload        Json
  state          DeviceCommandState @default(AVAILABLE)
  availableAt    DateTime           @default(now()) @map("available_at")
  /// Lease de 60 s, renovavel. Comando arrendado que expira volta a
  /// AVAILABLE -- Edge que morreu no meio nao trava a fila.
  leasedAt       DateTime?          @map("leased_at")
  leaseExpiresAt DateTime?          @map("lease_expires_at")
  acknowledgedAt DateTime?          @map("acknowledged_at")
  /// Mesmo comando logico nunca vira dois (regra de arquitetura no 4).
  idempotencyKey String             @unique @map("idempotency_key")
  correlationId  String             @map("correlation_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  @@unique([edgeNodeId, sequence])
  @@index([edgeNodeId, state, sequence])
  @@map("device_commands")
}

// ---------------------------------------------------------------------------
// Decisao de acesso e passagem (F9)
//
// Regra de arquitetura no 1: a catraca NUNCA consulta assinatura nem invoice.
// A cadeia e `Pagamento -> Invoice -> Subscription -> Entitlement -> aqui`.
// Nada nesta secao referencia `Subscription`, e isso e deliberado.
//
// `M1-BR-009`: evento de passagem e IMUTAVEL. Correcao e registro NOVO
// vinculado ao original, nunca `UPDATE`. Por isso `AccessEvent` nao tem
// `updatedAt` -- a ausencia da coluna e a garantia, nao a disciplina de quem
// escreve o repositorio.
// ---------------------------------------------------------------------------

/// Politica de acesso vigente por unidade.
///
/// Guarda a VERSAO que o motor usou e a configuracao que valia. Sem isto,
/// reler uma decisao de seis meses atras aplicaria as regras de hoje, e a
/// pergunta "por que este aluno entrou naquele dia?" nao teria resposta
/// verificavel.
model AccessPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  gymUnitId String   @map("gym_unit_id") @db.Uuid
  /// Semver do motor puro (`POLICY_VERSION`). Mudanca de comportamento
  /// observavel exige numero novo.
  version   String
  /// Parametros da unidade. JSON porque a Slice 1.5 acrescenta validade e
  /// carencia de snapshot, ainda em ADR-007 (`aberto`).
  config    Json
  /// Vigencia. Politica nao se edita: publica-se outra e encerra-se esta.
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit GymUnit @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)

  @@index([tenantId, gymUnitId, startsAt])
  @@map("access_policies")
}

/// Bloqueio administrativo sobre um aluno.
///
/// E a alavanca que a operacao puxa para barrar ALGUEM AGORA, sem esperar
/// processo de cadastro nem mexer em entitlement. Por isso precede tudo na
/// ordem do motor (`M1-BR-006`) e por isso e uma tabela propria: mudar
/// `Student.status` seria efeito colateral em cascata, e o bloqueio precisa
/// ser reversivel sem reconstruir estado.
model AdministrativeBlock {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  reason    String
  /// Quem bloqueou. Bloqueio sem responsavel nao e auditavel.
  actorId   String    @map("actor_id") @db.Uuid
  startsAt  DateTime  @default(now()) @map("starts_at")
  /// Nulo = vigente por prazo indeterminado.
  endsAt    DateTime? @map("ends_at")
  /// Quem levantou o bloqueio, e quando.
  liftedAt  DateTime? @map("lifted_at")
  liftedById String?  @map("lifted_by_id") @db.Uuid
  liftReason String?  @map("lift_reason")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Caminho quente: "existe bloqueio vigente para este aluno agora?".
  @@index([tenantId, studentId, liftedAt, startsAt, endsAt])
  @@map("administrative_blocks")
}

/// Decisao de acesso -- FATO IMUTAVEL (`M1-BR-009`).
///
/// Nao ha `updatedAt` e nao ha caminho de `UPDATE` no repositorio. Corrigir
/// e criar `AccessEventCorrection` apontando para cá.
///
/// `studentId` e nulavel de proposito: o leitor reconhece alguem que a base
/// nao conhece, e esse `DENY` PRECISA ser registrado -- e justamente o caso
/// que interessa investigar. Evento sem aluno e evento valido.
model AccessEvent {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  gymUnitId String @map("gym_unit_id") @db.Uuid

  /// De onde veio. Nulavel porque override manual nasce na nuvem, sem Edge.
  edgeNodeId String? @map("edge_node_id") @db.Uuid
  deviceId   String? @map("device_id") @db.Uuid

  /// Nulo quando a identidade nao resolveu para nenhum aluno do tenant.
  studentId  String? @map("student_id") @db.Uuid
  /// Biometria usada. Nulo em override e em identidade desconhecida.
  identityId String? @map("identity_id") @db.Uuid
  /// O `enrollid` que o leitor informou. Guardado mesmo sem aluno resolvido:
  /// e a unica pista de quem o equipamento viu.
  externalUserId String? @map("external_user_id")
  /// Id do reconhecimento no dispositivo, para casar log fisico com o nosso.
  recognitionId  String? @map("recognition_id")

  outcome       AccessOutcome
  reason        AccessReason
  /// Qual direito autorizou. Nulo em todo `DENY`.
  entitlementId String?       @map("entitlement_id") @db.Uuid
  /// Ate quando a decisao vale. Alimenta o cache do Edge na Slice 1.5.
  validUntil    DateTime?     @map("valid_until")
  policyVersion String        @map("policy_version")
  mode          AccessMode
  method        AccessMethod

  /// Quando o reconhecimento aconteceu no equipamento (relogio do device).
  recognizedAt DateTime? @map("recognized_at")
  /// Quando a decisao foi avaliada (relogio do servidor). Os DOIS existem
  /// porque relogio de catraca derrapa: guardar so um deles apagaria a
  /// evidencia de deriva justamente quando ela importa.
  occurredAt   DateTime  @map("occurred_at")
  receivedAt   DateTime  @default(now()) @map("received_at")

  correlationId String @map("correlation_id")
  /// Dedupe do evento (ADR-006). Reprocessar e sempre seguro.
  idempotencyKey String @map("idempotency_key")

  /// Contexto congelado da decisao: entrada do motor, deriva de relogio,
  /// confianca do reconhecimento. NUNCA CPF, divida, foto ou template.
  detail Json

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit     GymUnit            @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)
  edgeNode    EdgeNode?          @relation(fields: [edgeNodeId], references: [id], onDelete: SetNull)
  device      Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  student     Student?           @relation(fields: [studentId], references: [id], onDelete: SetNull)
  identity    BiometricIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  entitlement Entitlement?       @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  passage      AccessPassage?
  override     ManualAccessOverride?
  corrections  AccessEventCorrection[] @relation("EventoCorrigido")
  correcoesQueEsteEvento AccessEventCorrection[] @relation("EventoCorretor")

  /// Idempotencia por ORIGEM, nao global: dois Edges podem gerar a mesma
  /// chave local sem colidir.
  ///
  /// ⚠️ ESTE INDICE NAO COBRE O OVERRIDE MANUAL. Override nasce na nuvem com
  /// `edgeNodeId` NULO, e em Postgres NULL nunca e igual a NULL -- duas
  /// linhas `(NULL, 'mesma-chave')` convivem aqui sem conflito.
  ///
  /// O buraco e fechado por um INDICE PARCIAL escrito a mao, em
  /// `migrations/20260816140000_access_event_cloud_idempotency`:
  ///
  ///     CREATE UNIQUE INDEX ... ON access_events (tenant_id, idempotency_key)
  ///       WHERE edge_node_id IS NULL;
  ///
  /// O Prisma nao modela indice parcial, entao ele NAO aparece neste schema e
  /// um `prisma migrate dev` futuro vai propor apaga-lo. NAO ACEITE: sem ele,
  /// clique duplo da recepcao gira a catraca duas vezes.
  @@unique([edgeNodeId, idempotencyKey])
  @@index([tenantId, gymUnitId, occurredAt])
  @@index([tenantId, studentId, occurredAt])
  @@index([tenantId, outcome, occurredAt])
  @@map("access_events")
}

/// Desfecho fisico da passagem -- registro TERMINAL, um por evento.
///
/// Separado do `AccessEvent` porque a decisao e o giro acontecem em momentos
/// diferentes e o evento e imutavel. Escrever o desfecho no proprio evento
/// exigiria `UPDATE` nele, que e exatamente o que `M1-BR-009` proibe.
model AccessPassage {
  id            String       @id @default(uuid()) @db.Uuid
  accessEventId String       @unique @map("access_event_id") @db.Uuid
  state         PassageState
  /// Id do comando enviado ao equipamento. E a chave de idempotencia fisica:
  /// o mesmo `accessEventId` sempre produz o mesmo comando.
  commandId     String?      @map("command_id")
  /// Relogio do equipamento.
  reportedAt    DateTime?    @map("reported_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  accessEvent AccessEvent @relation(fields: [accessEventId], references: [id], onDelete: Cascade)

  @@map("access_passages")
}

/// Correcao de um evento -- `M1-BR-009`: "correcoes sao novos registros
/// vinculados".
///
/// O original NUNCA muda. Esta tabela liga o fato errado ao fato certo e diz
/// quem corrigiu e por que.
model AccessEventCorrection {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  /// O evento que estava errado.
  originalEventId   String   @map("original_event_id") @db.Uuid
  /// O evento novo que passa a valer. Nulo quando a correcao apenas anota
  /// que o original nao deve ser considerado.
  correctingEventId String?  @map("correcting_event_id") @db.Uuid
  reason            String
  actorId           String   @map("actor_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originalEvent   AccessEvent @relation("EventoCorrigido", fields: [originalEventId], references: [id], onDelete: Cascade)
  correctingEvent AccessEvent? @relation("EventoCorretor", fields: [correctingEventId], references: [id], onDelete: SetNull)

  @@index([tenantId, originalEventId])
  @@map("access_event_corrections")
}

/// Liberacao manual pela recepcao -- `M1-FR-023`, `M1-BR-007`.
///
/// `M1-BR-007`: override NUNCA altera assinatura ou entitlement em silencio.
/// Por isso esta tabela nao tem nenhuma coluna que aponte para eles: nao ha
/// como escrever o codigo errado sem antes alterar o schema.
///
/// `visitorDescription` cobre quem nao e aluno. Minimizado por LGPD: nome e
/// motivo bastam para a auditoria; documento nao entra.
model ManualAccessOverride {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  gymUnitId     String  @map("gym_unit_id") @db.Uuid
  /// Um dos dois esta presente -- aluno conhecido OU visitante descrito.
  studentId     String? @map("student_id") @db.Uuid
  visitorDescription String? @map("visitor_description")
  /// Catraca alvo.
  deviceId      String  @map("device_id") @db.Uuid
  /// Minimo de 10 caracteres, validado no boundary. "ok" nao e motivo.
  reason        String
  actorId       String  @map("actor_id") @db.Uuid
  /// O evento que esta liberacao gerou. Um override, um evento.
  accessEventId String  @unique @map("access_event_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit     GymUnit     @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)
  student     Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  device      Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  accessEvent AccessEvent @relation(fields: [accessEventId], references: [id], onDelete: Cascade)

  @@index([tenantId, gymUnitId, createdAt])
  @@map("manual_access_overrides")
}

// ---------------------------------------------------------------------------
// Operacao (F11)
//
// INV-146 (ADR-011): a ausencia do Edge e ALERTA OPERACIONAL OBRIGATORIO, nao
// linha de log. Sem operacao offline (ADR-012), Edge fora significa catraca
// parada -- a operacao precisa saber no minuto em que acontece.
// ---------------------------------------------------------------------------

/// Estado do alerta no tempo.
///
/// `ACKNOWLEDGED` existe separado de `RESOLVED` porque significam coisas
/// diferentes: reconhecer e "estou vendo, estou indo"; resolver e "a condicao
/// acabou". Confundir os dois deixaria o painel limpo com a catraca ainda
/// parada.
enum OperationalAlertState {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@map("operational_alert_state")
}

enum OperationalAlertSeverity {
  CRITICAL
  WARNING
  INFO

  @@map("operational_alert_severity")
}

/// Alerta operacional -- `M1-FR-030`, `M1-AC-011`.
///
/// A CHAVE DESTE MODELO E `fingerprint`. Uma condicao que persiste ATUALIZA a
/// linha existente; nao cria outra. Sem isso, um Edge fora do ar por uma noite
/// geraria ~960 linhas (avaliacao a cada 30 s x 8 h) e o painel ficaria
/// ilegivel exatamente quando mais precisa ser lido.
///
/// `impact` e `recommendedAction` sao COLUNAS, nao derivacao de UI: o alerta
/// e lido por quem esta na recepcao com uma pessoa esperando, e "EDGE_OFFLINE"
/// sozinho nao diz se e para ligar para o TI ou liberar manualmente.
model OperationalAlert {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  /// Nulo em alerta que nao pertence a uma unidade especifica.
  gymUnitId String? @map("gym_unit_id") @db.Uuid

  /// `(tenant, unidade, recurso, recursoId, codigo)` -- ver `alert-rules.ts`.
  fingerprint String @unique

  code     String
  severity OperationalAlertSeverity
  state    OperationalAlertState    @default(OPEN)

  /// Tipo e id do recurso afetado (EDGE, DEVICE, SYNC, QUEUE).
  resource   String
  resourceId String @map("resource_id")

  /// Texto em pt-BR, pronto para a tela.
  impact            String
  recommendedAction String @map("recommended_action")

  /// Numeros que sustentam o alerta. NUNCA PII -- o painel e lido por quem
  /// nao deveria ver dado de aluno para consertar um cabo de rede.
  evidence Json

  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  /// Quem reconheceu, e quando. Reconhecer NAO resolve.
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gymUnit GymUnit? @relation(fields: [gymUnitId], references: [id], onDelete: Cascade)

  /// Caminho quente do painel: "o que esta aberto nesta unidade agora?".
  @@index([tenantId, state, severity, lastSeenAt])
  @@index([tenantId, gymUnitId, state])
  @@map("operational_alerts")
}

/// Estado de uma exportacao.
enum DataExportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED

  @@map("data_export_status")
}

/// Exportacao assincrona de eventos -- `M1-NFR-009`.
///
/// ASSINCRONA POR EXIGENCIA: "exportacoes grandes sao assincronas e nao
/// bloqueiam a API". Uma exportacao de 100 mil eventos numa requisicao HTTP
/// deixaria a operacao esperando -- e a operacao esta com uma pessoa parada
/// na catraca.
///
/// O arquivo vai para storage PRIVADO. `objectKey` e a referencia; a URL de
/// download e assinada e curta, gerada na hora do pedido, e a autorizacao e
/// reconferida ali -- quem perdeu a permissao entre pedir e baixar nao baixa.
model DataExportJob {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  type        String
  status      DataExportStatus @default(PENDING)

  /// Filtros normalizados. Ficam guardados para a auditoria responder "o que
  /// exatamente essa pessoa levou embora?".
  filters Json

  /// Linhas escritas ate agora. Alimenta o progresso na tela.
  rowCount Int @default(0) @map("row_count")

  objectKey String? @map("object_key")
  /// Codigo estavel do erro. Nunca a mensagem crua.
  errorCode String? @map("error_code")

  /// Depois disto o objeto e apagado pelo expurgo.
  expiresAt   DateTime? @map("expires_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// Dedupe: clique duplo no botao de exportar nao gera dois arquivos.
  idempotencyKey String @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, requesterId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@map("data_export_jobs")
}

// ---------------------------------------------------------------------------
// FINANCEIRO -- MVP 2, Slice 2.1 (F12)
//
// Regra de arquitetura no 1: `Pagamento -> Invoice -> Subscription ->
// Entitlement -> Access Decision Engine`. NADA aqui e consultado pela
// catraca. O financeiro move entitlement por evento, nunca por leitura
// direta.
//
// INV-065 / `M2-BR-001`: dinheiro e INTEIRO na menor unidade monetaria.
// `Int` em centavos, nunca `Float`, nunca `Decimal` -- centavo nao tem
// fracao, e float em dinheiro e o bug que so aparece na conciliacao.
//
// Sem `gym_unit_id` em nenhuma tabela financeira: pagamento nao e dado
// fisico (`CLAUDE.md`, regra de arquitetura 2, e ADR-027).
// ---------------------------------------------------------------------------

/// Status do beneficio no plano.
///
/// NAO e booleano porque o encarte da Arena Positiva ja imprimiu o
/// meio-termo: "Teste de ECG -- em avaliacao".
enum PlanBenefitStatus {
  INCLUDED
  UNDER_REVIEW
}

/// Preco do plano, COM VIGENCIA (decisao do PI em 18/08/2026).
///
/// Reajuste NAO reescreve o catalogo: entra linha nova com `validFrom`
/// proprio. Preserva historico, permite reajuste agendado, e a invoice ja
/// aberta nunca muda de valor (INV-068) porque copia o valor na abertura.
model PlanPrice {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  /// Centavos. INV-065.
  amountMinor Int     @map("amount_minor")
  currency   String   @default("BRL")
  /// Inclusivo: preco que vale a partir de 01/06 ja vale as 00:00 de 01/06.
  validFrom  DateTime @map("valid_from")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, validFrom])
  @@index([tenantId, planId, validFrom])
  @@map("plan_prices")
}

/// Beneficio incluso no plano -- TABELA, NAO TEXTO.
///
/// Decisao do PI em 18/08/2026, a partir dos encartes: o mesmo item
/// ("Bioimpedancia") aparece nos dois programas com periodicidade
/// DIFERENTE -- 30 dias no de adultos e idosos, 60 no de protocolos
/// especificos. Isso e regra que o MVP 3 vai ler para saber quando a
/// proxima avaliacao vence; em `description` viraria prosa inconsultavel.
model PlanBenefit {
  id       String            @id @default(uuid()) @db.Uuid
  tenantId String            @map("tenant_id") @db.Uuid
  planId   String            @map("plan_id") @db.Uuid
  item     String
  status   PlanBenefitStatus @default(INCLUDED)
  /// Periodicidade em dias. Nulo = beneficio sem recorrencia.
  everyDays Int?             @map("every_days")
  detail    String?
  /// Ordem de exibicao, para a tela espelhar o encarte impresso.
  position  Int              @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId, planId, position])
  @@map("plan_benefits")
}

/// Papel no grupo familiar.
///
/// O titular responde pela cobranca; o dependente tem direito de acesso e
/// nao tem invoice. Sem este campo, "quem paga" so se descobriria por
/// convencao.
enum FamilyMemberRole {
  HOLDER
  DEPENDENT
}

/// Grupo familiar: UMA assinatura, UMA invoice, N direitos de acesso.
///
/// POR QUE ISSO NAO MEXE NO MOTOR DE ACESSO. `Entitlement` ja tem
/// `student_id` PROPRIO e `subscription_id` NULAVEL: F9 sempre leu o direito
/// PELO ALUNO, nunca pela assinatura. O plano familiar muda so a
/// cardinalidade da derivacao, de 1:1 para 1:N -- `Subscription.student_id`
/// continua sendo o titular, e nada do MVP 1 precisou ser reescrito.
model FamilyGroup {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  subscriptionId String   @unique @map("subscription_id") @db.Uuid
  /// Limite de membros do plano. 3 no plano familiar da Arena Positiva.
  memberLimit    Int      @map("member_limit")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  members      FamilyMember[]

  @@index([tenantId])
  @@map("family_groups")
}

model FamilyMember {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  groupId   String           @map("group_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  role      FamilyMemberRole @default(DEPENDENT)
  joinedAt  DateTime         @default(now()) @map("joined_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Mesmo aluno nao entra duas vezes no mesmo grupo.
  @@unique([groupId, studentId])
  @@index([tenantId, studentId])
  @@map("family_members")
}

/// Configuracao financeira por tenant (`M2-FR-001`).
///
/// A ancora de bloqueio e CONFIGURAVEL (ADR-019, INV-144), com padrao no
/// primeiro instante de `due_date + grace_period`, no timezone da unidade,
/// sem fallback para o tenant e sem adiamento por feriado.
model BillingSettings {
  tenantId String @id @map("tenant_id") @db.Uuid
  currency String @default("BRL")
  /// Dia do mes do vencimento (1-28). Limitado a 28 para existir em
  /// fevereiro sem regra de excecao.
  dueDay    Int   @map("due_day")
  /// Dias de carencia depois do vencimento antes do bloqueio.
  graceDays Int   @default(0) @map("grace_days")
  /// Dias apos o vencimento em que cada tentativa de cobranca acontece.
  ///
  /// O TAMANHO DA LISTA E O MAXIMO DE TENTATIVAS -- nao existe um segundo
  /// campo `maxTentativas` que possa discordar dela. Lista vazia desliga a
  /// cobranca automatica.
  ///
  /// Padrao `[0, 3, 7]` decidido pelo PI em 19/08/2026. Por tenant para que
  /// uma academia ajuste sem deploy.
  retryOffsetDays Int[] @default([0, 3, 7]) @map("retry_offset_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("billing_settings")
}

/// `CONVENTION.md` 3.4. `PAID` nunca volta a `OPEN` (INV-069).
enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

/// Como o dinheiro foi reconhecido.
///
/// `MANUAL` e o que faz a Slice 2.1 fechar SEM adapter nenhum (ADR-027):
/// dinheiro ou transferencia reconhecidos na recepcao. Os demais chegam com
/// o provedor homologado, na Slice 2.2.
/// Estado de um metodo de pagamento tokenizado.
///
/// `EXPIRED` NAO e derivado da data de validade em consulta: o cartao pode
/// ser recusado por expiracao antes do mes gravado (reemissao, bloqueio do
/// emissor) e continuar valendo depois dele (renovacao automatica pela
/// bandeira, que mantem o token). Quem manda e a resposta do provedor.
enum PaymentMethodStatus {
  ACTIVE
  EXPIRED
  REMOVED

  @@map("payment_method_status")
}

/// Metodo de pagamento tokenizado do aluno. `MVP-02` 7, Slice 2.3.
///
/// O QUE ESTA TABELA NAO TEM, E NUNCA PODE TER (INV-098): numero do cartao,
/// PAN, CVV, trilha. A tokenizacao e HOSPEDADA -- o dado vai do navegador do
/// aluno direto para o provedor, e o backend recebe so o token. Coluna de PAN
/// aqui nao seria "campo faltando": seria o ArenaHub entrando no escopo do
/// PCI DSS.
///
/// A Getnet expoe DOIS caminhos de tokenizacao e so um satisfaz o INV-098 --
/// `POST /v1/tokens/card` chamado pelo backend recebe `card_number` cru.
/// Vale exclusivamente o caminho do cliente (Get Checkout / iframe). Ver
/// ADR-032.
///
/// `brand`, `last4`, `expMonth` e `expYear` sao o que a bandeira permite
/// exibir, e existem por uma razao operacional: sem eles a recepcao nao tem
/// como dizer QUAL cartao falhou quando o aluno tem dois.
model PaymentMethod {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  /// Slug do provedor que guarda o token. Hoje `getnet` (ADR-032).
  provider String
  /// Identificador do token NO PROVEDOR. Nao e o cartao -- e a referencia a
  /// ele no cofre do provedor, inutil fora dali.
  externalTokenId String @map("external_token_id")

  /// Bandeira, como o provedor devolveu. String e nao enum: bandeira nova
  /// nao deve exigir migration.
  brand String?
  /// Ultimos quatro digitos. E o maximo que a bandeira permite exibir.
  last4    String? @db.VarChar(4)
  expMonth Int?    @map("exp_month")
  expYear  Int?    @map("exp_year")

  status PaymentMethodStatus @default(ACTIVE)

  /// O metodo usado na cobranca recorrente quando o aluno nao escolhe outro.
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// O token e unico no provedor: reenviar o mesmo cartao devolve o mesmo
  /// token, e sem esta chave o aluno acumularia metodos duplicados a cada
  /// tentativa de cadastro interrompida.
  @@unique([provider, externalTokenId])
  /// UM metodo padrao ATIVO por aluno -- indice PARCIAL, declarado na
  /// migration porque o Prisma nao modela unicidade condicional. Sem ele
  /// "qual cartao cobrar?" teria duas respostas e a escolha cairia na ordem
  /// de insercao, o mesmo defeito que `provider_accounts.capability` veio
  /// consertar. A garantia mora em
  /// `payment_methods_tenant_id_student_id_default_key`.
  @@index([tenantId, studentId, status])
  @@map("payment_methods")
}

enum PaymentMethodKind {
  MANUAL
  PIX
  CARD
}

/// `CONVENTION.md` 3.5, lado do `Payment` (ADR-027).
/// `CONFIRMED` nao volta atras -- e o par de INV-069 do lado do pagamento.
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

/// `CONVENTION.md` 3.5, lado da tentativa (ADR-027).
enum PaymentAttemptStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
}

/// Credito do aluno por sobrepagamento (ADR-027, resposta 4 do PI).
/// NAO e dinheiro devolvivel no MVP 2 -- so abate invoice.
enum AccountCreditStatus {
  AVAILABLE
  APPLIED
  EXPIRED
}

/// Invoice: o que o aluno deve.
///
/// `totalMinor` e COPIA, nao calculo em tempo de leitura: INV-068 diz que
/// moeda e valor nao mudam depois da abertura, e o preco do plano pode
/// mudar amanha. Copiar congela; recalcular reescreveria o passado.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  /// Aluno cobrado. No plano familiar e o TITULAR -- dependente tem acesso,
  /// nao tem invoice.
  studentId      String        @map("student_id") @db.Uuid
  /// Periodo de competencia, primeiro dia. Une com a assinatura para dar a
  /// unicidade de INV-066.
  billingPeriod  DateTime      @map("billing_period") @db.Date
  status         InvoiceStatus @default(DRAFT)
  /// Numero sequencial legivel por tenant. Nao e o id.
  number         Int
  currency       String        @default("BRL")
  /// Centavos, todos. INV-065.
  subtotalMinor  Int           @map("subtotal_minor")
  discountMinor  Int           @default(0) @map("discount_minor")
  totalMinor     Int           @map("total_minor")
  dueAt          DateTime      @map("due_at")
  /// Instante a partir do qual a inadimplencia bloqueia (ADR-019/INV-144).
  blockAt        DateTime?     @map("block_at")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  version        Int           @default(0)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription  @relation(fields: [subscriptionId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  attempts     PaymentAttempt[]

  /// INV-066: invoice unica por assinatura e periodo.
  @@unique([tenantId, subscriptionId, billingPeriod])
  /// Numeracao legivel, sem buraco nem repeticao dentro do tenant.
  @@unique([tenantId, number])
  @@index([tenantId, status, dueAt])
  @@map("invoices")
}

/// Item da invoice. Imutavel depois do pagamento (INV-067).
model InvoiceItem {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  invoiceId       String @map("invoice_id") @db.Uuid
  description     String
  quantity        Int    @default(1)
  /// Centavos. INV-065.
  unitAmountMinor Int    @map("unit_amount_minor")
  totalMinor      Int    @map("total_minor")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("invoice_items")
}

/// Pagamento: QUE DINHEIRO FOI RECONHECIDO (ADR-027).
///
/// Separado de `PaymentAttempt` porque respondem perguntas diferentes:
/// tentativa e "o que eu tentei", pagamento e "o que entrou". Invoice paga
/// em duas tentativas (PIX falho + cartao) tem DUAS tentativas e UM
/// pagamento -- e a falha continua no historico, que e o ponto.
model Payment {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  invoiceId String            @map("invoice_id") @db.Uuid
  /// Centavos. INV-065.
  amountMinor Int             @map("amount_minor")
  currency  String            @default("BRL")
  method    PaymentMethodKind
  status    PaymentStatus     @default(PENDING)
  paidAt    DateTime?         @map("paid_at")

  /// Quem reconheceu, preenchido SO quando `method = MANUAL`.
  ///
  /// Com a dupla permissao fora do MVP 2 (emenda de 18/08/2026), este campo
  /// e a mitigacao que sobrou: o controle deixou de ser preventivo e passou
  /// a ser DETECTIVO. Ele nao impede o registro inflado -- permite achar
  /// depois. A diferenca e deliberada e e do PI (ADR-027, consequencia 3).
  recognizedByUserId String? @map("recognized_by_user_id") @db.Uuid

  /// Nulo em pagamento manual: dinheiro na recepcao nao tem tentativa.
  attemptId         String? @unique @map("attempt_id") @db.Uuid
  providerAccountId String? @map("provider_account_id")
  externalPaymentId String? @map("external_payment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice         @relation(fields: [invoiceId], references: [id])
  attempt PaymentAttempt? @relation(fields: [attemptId], references: [id])
  credits AccountCredit[]

  /// ADR-006 / INV-076: idempotencia do evento externo.
  @@unique([providerAccountId, externalPaymentId])
  @@index([tenantId, invoiceId, status])
  @@map("payments")
}

/// Tentativa de pagamento: O QUE FOI TENTADO (ADR-027).
///
/// Sucesso posterior nao apaga a falha anterior -- por isso a tentativa e
/// tabela propria e nao um campo de status no pagamento.
model PaymentAttempt {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  invoiceId       String               @map("invoice_id") @db.Uuid
  method          PaymentMethodKind
  status          PaymentAttemptStatus @default(CREATED)
  /// Chave enviada ao provedor. Constraint do `MVP-02` 11.
  idempotencyKey  String               @map("idempotency_key")
  providerAccountId String?            @map("provider_account_id")
  externalPaymentId String?            @map("external_payment_id")
  /// Codigo estavel do erro. Nunca a mensagem crua (`CLAUDE.md`).
  failureCode       String?            @map("failure_code")
  /// Falha permanente nao se repete sozinha; transitoria pode.
  failureIsPermanent Boolean?          @map("failure_is_permanent")
  requestedAt     DateTime             @default(now()) @map("requested_at")
  settledAt       DateTime?            @map("settled_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  payment Payment?

  @@unique([tenantId, idempotencyKey])
  /// NO MAXIMO UMA cobranca de cartao em voo por invoice -- indice PARCIAL
  /// (`method = 'CARD' AND status = 'PROCESSING'`), declarado na migration
  /// porque o Prisma nao modela unicidade condicional.
  ///
  /// Sem ele, duas requisicoes concorrentes para a mesma invoice cobram o
  /// aluno DUAS VEZES: a chave de idempotencia deriva da contagem de
  /// tentativas, e contagem muda entre a leitura e a escrita -- justamente a
  /// janela que a idempotencia existe para fechar.
  @@index([tenantId, invoiceId, status])
  @@map("payment_attempts")
}

/// Credito do aluno por sobrepagamento (ADR-027, resposta 4 do PI).
///
/// R$ 121 numa mensalidade de R$ 120 vira R$ 1 de credito, abatido na
/// proxima invoice. NAO e dinheiro devolvivel no MVP 2.
///
/// `originPaymentId` e obrigatorio: credito sem origem rastreavel e
/// exatamente o buraco de controle que a emenda de 18/08 deixou aberto do
/// lado preventivo -- aqui ele fecha do lado detectivo.
model AccountCredit {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  studentId       String              @map("student_id") @db.Uuid
  originPaymentId String              @map("origin_payment_id") @db.Uuid
  /// Centavos. INV-065.
  amountMinor     Int                 @map("amount_minor")
  currency        String              @default("BRL")
  status          AccountCreditStatus @default(AVAILABLE)
  appliedToInvoiceId String?          @map("applied_to_invoice_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  origin  Payment @relation(fields: [originPaymentId], references: [id])

  @@index([tenantId, studentId, status])
  @@map("account_credits")
}

/// Numeracao da invoice por tenant.
///
/// Mesmo padrao de `StudentSequence`, e pelas mesmas razoes: `COUNT(*) + 1`
/// reusa numero depois de cancelamento, fragmento de UUID nao e sequencial,
/// e `SEQUENCE` do Postgres e global -- o tenant B veria o volume do A.
model InvoiceSequence {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  /// Proximo numero a emitir. Nunca decrementa.
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invoice_sequences")
}

// ---------------------------------------------------------------------------
// Provedor de pagamento (F13)
// ---------------------------------------------------------------------------

/// Conta do tenant no provedor de pagamento.
///
/// EXISTE POR CAUSA DA INV-078: o webhook NAO confia no tenant do payload.
/// Quem diz de qual tenant e o evento e a conta que o provedor identifica na
/// requisicao -- payload e dado de terceiro, e terceiro nao decide multi-tenancy.
///
/// `signingSecret` e o segredo do HMAC da assinatura (INV-077). Cifrado em
/// repouso pela mesma razao que token de provedor (`MVP-02` 11): o banco nao
/// e lugar de segredo em claro.
///
/// `provider` e string, nao enum: em 19/08/2026 sao `sicoob` e `getnet`
/// (ADR-032), mas trocar de PSP e decisao do PI e nao deve custar migration.
/// A COLUNA QUE O CODIGO CONSULTA E `capability`, nunca esta -- ver abaixo.

/// Capacidade que uma conta de provedor atende (ADR-032).
///
/// EXISTE PORQUE SAO DOIS PROVEDORES: Sicoob para PIX, Getnet para cartao.
/// Sem ela, `findFirst({ active: true })` devolve qualquer conta ativa do
/// tenant -- e a cobranca PIX sairia pela conta de cartao dependendo da ordem
/// de insercao no banco, silenciosamente.
enum ProviderCapability {
  PIX
  CARD

  @@map("provider_capability")
}

model ProviderAccount {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Slug do provedor homologado. Minusculo, sem espaco.
  provider String
  /// O QUE esta conta sabe fazer, nao QUEM ela e.
  ///
  /// O roteamento pergunta pela CAPACIDADE e nunca pela marca: trocar o
  /// Sicoob por outro PSP e mudar a linha de `provider` e escrever um
  /// adapter, sem tocar em caso de uso nenhum.
  capability ProviderCapability
  /// Identificador da conta NO PROVEDOR. E o que chega na requisicao de
  /// webhook e resolve o tenant.
  externalAccountId String @map("external_account_id")
  /// Segredo do HMAC, cifrado. Nunca sai em resposta de API, nunca em log.
  signingSecretEncrypted String @map("signing_secret_encrypted")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events ProviderEvent[]

  /// O par (provedor, conta) e o que a requisicao carrega -- por isso a
  /// unicidade e global, nao por tenant: duas contas iguais em tenants
  /// diferentes tornariam a resolucao ambigua, que e o buraco da INV-078.
  @@unique([provider, externalAccountId])
  /// UMA conta ATIVA por capacidade por tenant -- indice PARCIAL
  /// (`WHERE active`), declarado na migration porque o Prisma nao modela
  /// unicidade condicional. `@@index` aqui existe so para o planner; a
  /// garantia mora em `provider_accounts_tenant_id_capability_active_key`.
  ///
  /// Parcial de proposito: conta desativada nao disputa roteamento, e exigir
  /// unicidade sobre ela impediria trocar de PSP -- a conta antiga precisa
  /// seguir existindo, inativa, para os eventos historicos continuarem
  /// resolviveis.
  @@index([tenantId, capability, active])
  @@index([tenantId, provider])
  @@map("provider_accounts")
}

/// Inbox de webhook do provedor (regra de arquitetura no 4, INV-076).
///
/// A unicidade `(provider_account_id, external_event_id)` E a idempotencia.
/// Nao e o `if (jaProcessei)` do codigo -- esse perde a corrida entre duas
/// entregas simultaneas do mesmo evento. O banco nao perde.
///
/// `occurredAt` e o instante DO PROVEDOR, nao o nosso: e com ele que a
/// INV-079 decide se o evento chegou fora de ordem. Relogio local nao serve
/// -- a ordem que importa e a da origem.
model ProviderEvent {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  providerAccountId String @map("provider_account_id") @db.Uuid
  /// Chave estavel do evento no provedor (INV-076). Criterio de homologacao
  /// do ADR-013: provedor sem isso nao passa no gate.
  externalEventId String @map("external_event_id")
  eventType       String @map("event_type")
  /// Pagamento a que o evento se refere, quando ha. Nulo em evento que nao
  /// e de pagamento.
  externalPaymentId String? @map("external_payment_id")
  /// Payload ja verificado. Retencao definida em `MVP-02` 11; NUNCA contem
  /// PAN/CVV -- a tokenizacao e hospedada (INV-098).
  payload Json
  /// Instante no PROVEDOR. Base da ordenacao logica (INV-079).
  occurredAt DateTime @map("occurred_at")
  /// Nulo enquanto nao aplicado. Evento recebido != evento aplicado: um
  /// evento fora de ordem e persistido e NAO aplicado.
  processedAt DateTime? @map("processed_at")
  /// Por que o evento nao mudou estado, quando nao mudou. Codigo estavel.
  skippedReason String? @map("skipped_reason")
  receivedAt    DateTime @default(now()) @map("received_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account ProviderAccount @relation(fields: [providerAccountId], references: [id])

  @@unique([providerAccountId, externalEventId])
  @@index([tenantId, externalPaymentId])
  @@map("provider_events")
}
