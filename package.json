{
  "name": "arenahub",
  "version": "0.0.0",
  "private": true,
  "description": "SaaS multi-tenant de gestao para academias",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "//setup": "`setup` e comando NATIVO do pnpm (instala o proprio pnpm) e nao chega ao script. Dai o nome `dev:setup`.",
    "dev:setup": "node scripts/setup.mjs",
    "dev": "node scripts/run-task.mjs dev",
    "lint": "node scripts/run-task.mjs lint",
    "typecheck": "node scripts/run-task.mjs typecheck",
    "test": "node scripts/run-task.mjs test",
    "test:integration": "node scripts/run-task.mjs test:integration",
    "test:e2e": "node scripts/run-task.mjs test:e2e",
    "test:report": "node scripts/test-report.mjs",
    "test:report:selfcheck": "node scripts/test-report.selfcheck.mjs",
    "build": "node scripts/run-task.mjs build",
    "test:guardas": "node scripts/guardas.test.mjs",
    "//smoke:smart-access": "Smoke de abertura da unidade (F11). Exige a API de pe; passe --cookie com sessao valida para as verificacoes operacionais.",
    "smoke:smart-access": "node scripts/smoke/smart-access.mjs",
    "docker:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d --wait",
    "docker:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "docker:reset": "docker compose --env-file .env -f infra/docker/docker-compose.yml down -v",
    "docker:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "turbo": "2.10.10"
  }
}
